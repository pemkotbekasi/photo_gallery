ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTkyMC5zZHIuQzMifQ%3D%3D&_nc_ohc=ZPqkItv1cpUQ7kNvwEodeJi&_nc_oc=AdlHilBWQ-sMC0H5RRLGcVa8KYoCTUiIkANjbfULXSWu1dCqnAc30hZuNBTNJtiqJi0&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=P5k9h3rIY6yaAr8br1o0cg&_nc_ss=8&oh=00_AfwBSraHvDzXzYBZUhkoQBAsFQ40dL-M_DH_2bVHMBVh7g&oe=69AC7384\",\"caption\":\"✨ Grebek K3 Menyambut HUT ke-80 RI ✨\\n\\nCamat Bekasi Selatan melaksanakan kegiatan Grebek K3 (Kebersihan, Keindahan, dan Ketertiban) pada Sabtu, 2 Agustus 2025, bertempat di Jl. Citra, perbatasan Kelurahan Jakamulya dan Jakasetia.\\n\\nKegiatan ini menjadi bagian dari upaya menjaga lingkungan tetap bersih dan tertib, sekaligus dalam rangka menyambut HUT ke-80 Kemerdekaan Republik Indonesia.\\nTerima kasih kepada seluruh aparatur dan warga yang telah turut serta!\\n\\nBersih lingkungannya, semangat kemerdekaannya!\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@karyasukmajaya \\n@isnainihd \\n@pemkot_bekasi \\n@humaskotabekasi \\n@diskominfobekasi \\n\\n#HUTRI80 #GrebekK3 #BekasiSelatan #KecamatanBekasiSelatan #BersihIndahTertib #KotaBekasi #BekasiMakinNyaman #BekasiSejahtera\",\"post_time\":1754136043,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3690282415969303387_7180179585.jpg\"},{\"id\":\"DMyfkS9zBl9\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/527407413_18318914194235586_5263575268355327665_n.webp?stp=dst-webp_p720x720&_nc_cat=102&ig_cache_key=MzY4OTE0OTg3ODQ3NzAwMzEzMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=5jVV0IQJ4osQ7kNvwFf-OyR&_nc_oc=AdlaXBsiBaCZlRZseNxKiumstbue6c2yjGm2zcDjvs03yHnZE4BbXyN0t28JgQDa4qo&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=P5k9h3rIY6yaAr8br1o0cg&_nc_ss=8&oh=00_AfwTVhoMgncBES-eLvE2cvAAvXw7Zfw52c92e5yMp9uvuA&oe=69AC8523\",\"caption\":\"✨ AYO DATANG & RAMAIKAN: OPERASI PASAR AGUSTUS 2025! ✨\\n\\nWarga Kota Bekasi, khususnya Kecamatan Bekasi Selatan! Dalam rangka menyambut HUT RI ke-80, Pemerintah Kota Bekasi melalui Dinas Perdagangan dan Perindustrian kembali menggelar Operasi Pasar.\\nCatat tanggalnya dan jangan sampai ketinggalan untuk mendapatkan kebutuhan pokok dengan harga terjangkau!\\n\\n🗓️ Hari/Tanggal: Sabtu, 02 Agustus 2025\\n⏰ Waktu: 08.00 WIB - Selesai\\n📍 Lokasi: Halaman Kantor Kelurahan Kayuringin Jaya\\n\\nAcara ini didukung oleh berbagai ritel ternama di Kota Bekasi. Manfaatkan kesempatan ini untuk berbelanja hemat!\\nAjak keluarga, tetangga, dan teman-temanmu ya. Sampai jumpa di sana!\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@karyasukmajaya \\n@isnainihd \\n@pemkot_bekasi \\n@humaskotabekasi \\n@diskominfobekasi\\n@disdagperin_kotabekasi\\n\\n#OperasiPasarBekasi #PasarMurahBekasi #Bekasi #KotaBekasi #InfoBekasi #BekasiSelatan #KayuringinJaya #DisdagperinBekasi #PemkotBekasi #HUTRI80 #Agustus2025 #SembakoMurah\",\"post_time\":1754000957,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3689149878477003133_7180179585.jpg\"},{\"id\":\"DMxgcxYSCPk\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/526118837_18318867922235586_2618052487399713446_n.jpg?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=110&ig_cache_key=MzY4ODg3MjI4NDQ0NzU4MTE1Ng%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=_HZM_1Ke5hIQ7kNvwF3qaPL&_nc_oc=AdknzMEB79QPH1Ju6-rhOF-_8AYShJxBIkXitjhvUOmxwhIij5JQaBH2qv3iA8E321k&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=P5k9h3rIY6yaAr8br1o0cg&_nc_ss=8&oh=00_AfwqflIr8dAwnsomJ_G6mhegn-zebEoYqpXDE4UcsdmODw&oe=69AC624C\",\"caption\":\"📢 Imbauan Pengibaran Bendera Merah Putih\\nDalam rangka memperingati HUT ke-80 Republik Indonesia, dihimbau kepada seluruh warga Kota Bekasi, khususnya warga Kecamatan Bekasi Selatan, untuk mengibarkan Bendera Merah Putih mulai tanggal 1 hingga 31 Agustus 2025.\\n\\nTunjukkan semangat nasionalisme dan cinta tanah air dari setiap sudut Kota Patriot Bekasi.\\nBersama kita wujudkan Indonesia yang bersatu, berdaulat, dan maju!\\n\\n@mastriadhianto\\n@harris.bobihoe\\n@karyasukmajaya\\n@isnainihd\\n@pemkot_bekasi\\n@humaskotabekasi\\n@diskominfobekasi\\n\\n#HUTRI80 #BekasiSelatan #KotaPatriot #DirgahayuRI #MerahPutihBerkibar\",\"post_time\":1753967866,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3688872284447581156_7180179585.jpg\"},{\"id\":\"DMwcHvoSWFv\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.71878-15/526635084_716150657988307_5699503246101265699_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=MzY4ODU3MTc3MjI5Njg0NzcyNw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM2LnNkci5DMyJ9&_nc_ohc=UI12ybvw54EQ7kNvwG0J71p&_nc_oc=AdnXcHj7eL1k4nSCR3WWqxLI5nTkSEOBmwgKqbE44Tn1OXwLuHz82ezydADeU8PxUF8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=P5k9h3rIY6yaAr8br1o0cg&_nc_ss=8&oh=00_AfwPNqtVbu_7jd9a5RSXFXn8fNDdLJzFGYW7sxe93Ydi0g&oe=69AC96A3\",\"caption\":\"🛠️ Kegiatan Kebersihan Lingkungan Kantor Kecamatan Bekasi Selatan\\n\\nPada hari Kamis, 31 Juli 2025, Camat Bekasi Selatan bersama jajaran aparatur Kecamatan melaksanakan kegiatan kebersihan dan penataan lingkungan di area Kantor Kecamatan Bekasi Selatan.\\n\\nAdapun kegiatan yang dilakukan meliputi penyapuan halaman, perapihan ranting pohon, serta pembersihan pagar kantor. Kegiatan ini bertujuan untuk menciptakan lingkungan kerja yang bersih, tertib, dan nyaman, guna mendukung peningkatan kualitas pelayanan kepada masyarakat.\\n\\nMelalui kegiatan ini, diharapkan tercipta budaya kerja yang sehat dan peduli terhadap kebersihan lingkungan.\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@karyasukmajaya \\n@isnainihd \\n@pemkot_bekasi \\n@humaskotabekasi \\n@diskominfobekasi\",\"post_time\":1753932230,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3688571772296847727_7180179585.jpg\"},{\"id\":\"DMuA-3ayT-3\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.71878-15/526461299_1323197329473235_8575828997956640988_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=102&ig_cache_key=MzY4Nzg4OTQ2NDk3NTc2OTUyNw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM2LnNkci5DMyJ9&_nc_ohc=FfxRTFzdTkMQ7kNvwFCc6JD&_nc_oc=Adm82YaPw2OCEsvkuo_gjLfG04YVAPs44lJr6pIOYgyjXL0GdMfv89K8NfkJPHfqqhw&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=P5k9h3rIY6yaAr8br1o0cg&_nc_ss=8&oh=00_AfyKM4_XBX-BY8yQQpA8vX6q8PWqHy-Vm7kZikYXCLxqXw&oe=69AC7298\",\"caption\":\"📍 Apel Pagi Tingkat Kecamatan Bekasi Selatan\\n🗓 Rabu, 30 Juli 2025\\n📌 Gedung PGRI Kecamatan Bekasi Selatan\\n\\nCamat Bekasi Selatan memimpin Apel Pagi Tingkat Kecamatan Bekasi Selatan yang dihadiri oleh:\\n▫️ Sekretaris Kecamatan Bekasi Selatan\\n▫️ Para Lurah dan Sekretaris Kelurahan\\n▫️ Para Kepala Seksi dan Kasubag Kecamatan dan Kelurahan\\n▫️ Kepala UPTD/UPTB\\n▫️ Kepala Sekolah jenjang SD, SMP, dan SMA & SMK\\n▫️ Aparatur ASN dan Non-ASN se-Kecamatan Bekasi Selatan\\n\\nKegiatan ini merupakan bagian dari upaya peningkatan kedisiplinan, sinergi, serta penguatan koordinasi antarperangkat daerah dalam rangka optimalisasi pelayanan publik di wilayah Kecamatan Bekasi Selatan.\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@karyasukmajaya \\n@isnainihd \\n@pemkot_bekasi \\n@humaskotabekasi \\n@diskominfobekasi\",\"post_time\":1753850861,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3687889464975769527_7180179585.jpg\"},{\"id\":\"DMsFLSMSLMw\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/525248497_18318640417235586_2435175447809102921_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=107&ig_cache_key=MzY4NzM0NDk2MDU4OTgzNzEwNDE4MzE4NjQwNDExMjM1NTg2.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjQ4MHg4NTQuc2RyLkMzIn0%3D&_nc_ohc=h8mswH1ypjcQ7kNvwFXuXG3&_nc_oc=AdnIaCsHKt8qBzJpKqdJDF9i58opEXaH1xC3ZgF0ZIZZqpS-kPx9vbJOG9XPSHSGo_E&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=P5k9h3rIY6yaAr8br1o0cg&_nc_ss=8&oh=00_AfwA8KwrC9PU4eSfrFMluzl6YmBiIgZbfNeBQAWi5qy1kw&oe=69AC9367\",\"caption\":\"Testimoni Warga : Pelayanan Kecamatan Bekasi Selatan.\\n\\n@mastriadhianto\\n@harris.bobihoe\\n@karyasukmajaya\\n@isnainihd\\n@pemkot_bekasi\\n@humaskotabekasi\\n@diskominfobekasi\",\"post_time\":1753785829,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3687344960589837104_7180179585.jpg\"},{\"id\":\"DMrXBlySREl\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/524350169_18318612460235586_4410354618635091617_n.jpg?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=109&ig_cache_key=MzY4NzE0MTk4NDI5NDIxMTg3Nw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=fP56lOT7u50Q7kNvwGyW6iq&_nc_oc=Adn7JImdx-nTSAxehX_7VuL0Qlo7HtnchgWUPxD_ftCerOvf578uMKCfyN-ZUB663a8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=P5k9h3rIY6yaAr8br1o0cg&_nc_ss=8&oh=00_AfwarAAgOlc7eUEE4H4Dabe5eZb9eraAEPkAL2T7mh64xQ&oe=69AC6CDF\",\"caption\":\"🏃‍♂️✨ Camat Bekasi Selatan Hadiri Senam SPARCO Bersama\\n📅 Selasa, 29 Juli 2025\\n📍 GOR Patriot Chandrabaga\\n\\nCamat Bekasi Selatan bersama para pemangku jabatan di tingkat kecamatan dan kelurahan se-Kecamatan Bekasi Selatan mengikuti kegiatan Senam SPARCO (Semangat Pagi Korps Pegawai Republik Indonesia).\\n\\nKegiatan ini menjadi wadah untuk memperkuat kebugaran jasmani, mempererat silaturahmi, dan menumbuhkan semangat kerja aparatur dalam memberikan pelayanan terbaik bagi masyarakat.\\n\\n💪 Sehat jasmani, kuat melayani!\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@karyasukmajaya \\n@isnainihd \\n@pemkot_bekasi \\n@humaskotabekasi \\n@diskominfobekasi\",\"post_time\":1753761598,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3687141984294211877_7180179585.jpg\"},{\"id\":\"DMp2IYgyE1X\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/524153483_18318544924235586_3954561011891027114_n.webp?stp=dst-webp_p720x720&_nc_cat=111&ig_cache_key=MzY4NjcxNTg0MDU2NjY3NjgyMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjExNTJ4MTQ0MC5zZHIuQzMifQ%3D%3D&_nc_ohc=NsWecrpUEocQ7kNvwHOp3B6&_nc_oc=AdnU7d6QmOY4kgASBD40xdC6Mo-F8qf3e8gcuoB51a1ItqwY6JOB0HoZI33kKjTGaaY&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=P5k9h3rIY6yaAr8br1o0cg&_nc_ss=8&oh=00_AfzIbnn9y5e-inch4mfaiuR17YewKFGgywnP51teVkim_A&oe=69AC78D6\",\"caption\":\"📢 Sosialisasi E-Kinerja untuk Aparatur PPPK Kecamatan Bekasi Selatan\\n\\n📍 Aula Kecamatan Bekasi Selatan\\n🗓️ Senin, 28 Juli 2025\\n\\nBKPSDM Kota Bekasi melaksanakan kegiatan sosialisasi E-Kinerja kepada aparatur PPPK di lingkungan Kecamatan Bekasi Selatan.\\n⠀\\nKegiatan ini bertujuan untuk meningkatkan pemahaman terkait sistem pelaporan kinerja berbasis elektronik yang transparan, akuntabel, dan terintegrasi.\\n⠀\\nMelalui sosialisasi ini, diharapkan seluruh aparatur PPPK dapat mengimplementasikan E-Kinerja secara tepat dan optimal dalam mendukung pelayanan publik yang lebih baik.\\n\\n@mastriadhianto\\n@harris.bobihoe \\n@karyasukmajaya \\n@isnainihd \\n@pemkot_bekasi \\n@humaskotabekasi \\n@diskominfobekasi\\n@bkpsdmbekasikota\",\"post_time\":1753710797,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3686715840566676823_7180179585.jpg\"},{\"id\":\"DMp0kVnyxpX\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/524903414_18318543808235586_1310364889914077944_n.webp?stp=dst-webp_p720x720&_nc_cat=110&ig_cache_key=MzY4NjcwODk2NTUxNTQwMTgxNQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=av-jv2iMiWkQ7kNvwHk5w7P&_nc_oc=AdmnVCWsN3N6pigOxV0Z9doBNqtvCIaUicO0oB5G_FxwACzyTBCSB9l9xkNydaMiTN0&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=P5k9h3rIY6yaAr8br1o0cg&_nc_ss=8&oh=00_Afx6O2t3gFTF72yBq86fbm1Ret_Szfnj5bLG7544FtYtxQ&oe=69AC620C\",\"caption\":\"📣 Apel Pagi Aparatur Kecamatan Bekasi Selatan\\n📅 Senin, 28 Juli 2025\\n\\nMengawali Senin Pagi dengan semangat pelayanan! Seluruh aparatur Kecamatan Bekasi Selatan mengikuti apel pagi sebagai bentuk disiplin dan komitmen terhadap pelayanan publik yang prima.\\n\\n✨ Apel pagi bukan sekadar rutinitas, tapi wujud kebersamaan dan kesiapan aparatur dalam menjalankan tugas untuk Bekasi Selatan yang semakin maju dan tertata.\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@karyasukmajaya \\n@isnainihd \\n@pemkot_bekasi \\n@humaskotabekasi \\n@diskominfobekasi\",\"post_time\":1753709978,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3686708965515401815_7180179585.jpg\"},{\"id\":\"DMpy3MmuY0g\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/524003939_18318542773235586_2450988071067017277_n.jpg?stp=dst-jpg_e35_p720x720_sh0.08_tt6&_nc_cat=104&ig_cache_key=MzY4NjcwMTQ2NTQxMDgzMzY5Ng%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTkyMC5zZHIuQzMifQ%3D%3D&_nc_ohc=1GCXMpLWSbYQ7kNvwGpqHd-&_nc_oc=AdlTEU7zJRLlalWkKYzCBOibkspkHdRjeBXI-Njj-7ius6w6yWf1Ziw4-0ji-Ri1_rc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=P5k9h3rIY6yaAr8br1o0cg&_nc_ss=8&oh=00_AfxUNi7N3-ri_bIjvs_zMs7Isw4mIxr0z2iJTovtn7MToQ&oe=69AC61C8\",\"caption\":\"Testimoni Warga : Pelayanan Kecamatan Bekasi Selatan.\\n\\n@mastriadhianto\\n@harris.bobihoe\\n@karyasukmajaya\\n@isnainihd\\n@pemkot_bekasi\\n@humaskotabekasi\\n@diskominfobekasi\",\"post_time\":1753709112,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3686701465410833696_7180179585.jpg\"},{\"id\":\"DMe1Il_yu_L\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/522345936_18317973550235586_6689774153257425846_n.jpg?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=103&ig_cache_key=MzY4MzYxNTIzMjI1NTI1ODU3MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEyODB4MTYwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=zU7j9K02f8MQ7kNvwEUo2R-&_nc_oc=AdlyKi4Fh2H7EA-0jl-airmwQUGxatPX-7hEN3etwEMtSDOHNO3AuNhoagaMBIBNMEM&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=P5k9h3rIY6yaAr8br1o0cg&_nc_ss=8&oh=00_AfxIcQxqXHoUGkrgOig-RI7eZMHdw2hdWxjz52au24uuXg&oe=69AC7A4A\",\"caption\":\"Innalillahi wa inna ilaihi raji’un\\nKami keluarga besar Aparatur Kecamatan Bekasi Selatan turut berduka cita yang sedalam-dalamnya atas wafatnya:\\n\\nRaya Robinsyah\\n🕯️ 22 Desember 1982 – 24 Juli 2025\\n\\nSemoga almarhum diberikan tempat terbaik di sisi Allah SWT dan keluarga yang ditinggalkan diberi ketabahan.\\nAamiin ya Rabbal ‘aalamiin.\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@karyasukmajaya \\n@isnainihd \\n@pemkot_bekasi \\n@humaskotabekasi \\n@diskominfobekasi\",\"post_time\":1753341176,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3683615232255258571_7180179585.jpg\"},{\"id\":\"DMeoCLSOHxY\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/522404412_18317966191235586_7131047170115973280_n.jpg?stp=dst-jpg_e35_p720x720_sh0.08_tt6&_nc_cat=106&ig_cache_key=MzY4MzU1NzYxNjY1MTg5Mzg0OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTkyMC5zZHIuQzMifQ%3D%3D&_nc_ohc=fwzthqq_QeYQ7kNvwEzAPgs&_nc_oc=AdlMKRHfB1ii9M28LA-_dtyogszi070JQYqT2mtY_YFUYt2Z8arM6Q04gLX7VU-dJhY&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=uj2rLgjw88-LMal05hjAow&_nc_ss=8&oh=00_Afwaq778_C10XnLoVOi6pMJX9T9mM0pEZTNApYOOLazXyw&oe=69AC7461\",\"caption\":\"🚧 Penertiban Bangunan Liar, PKL, dan Parkir Liar di Wilayah Bekasi Selatan\\n📍 Depan Ruko Mega Kalimalang\\n📅 Kamis, 24 Juli 2025\\n\\nCamat Bekasi Selatan bersama Kepala Dinas Tata Ruang Kota Bekasi dan Kepala Satpol PP Kota Bekasi memimpin langsung kegiatan penertiban demi mendukung terciptanya ruang kota yang lebih tertib, bersih, dan nyaman.\\n\\nTurut hadir dan terlibat aktif dalam kegiatan ini:\\n✅ Danramil 01/Kranji\\n✅ Unsur Polsek Bekasi Selatan\\n✅ Sekretaris Kecamatan Bekasi Selatan\\n✅ Kasi Trantib Kecamatan Bekasi Selatan\\n✅ Lurah Pekayon Jaya\\n✅ Korlap Satpol PP Bekasi Selatan beserta anggota\\n✅ Aparatur Kecamatan dan Kelurahan se-Bekasi Selatan\\n✅ Unsur Satpol PP Kota Bekasi\\n✅ UPTD Lingkungan Hidup (LH)\\n✅ Unsur Dinas Perhubungan (Dishub)\\n✅ Unsur Satpol PP Kecamatan Bekasi Selatan\\n\\n💡 Kegiatan ini merupakan bentuk kolaborasi lintas sektor dalam menegakkan aturan dan menata kawasan publik agar lebih nyaman bagi seluruh warga Bekasi Selatan.\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@karyasukmajaya \\n@isnainihd \\n@pemkot_bekasi \\n@humaskotabekasi \\n@diskominfobekasi\",\"post_time\":1753334428,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3683557616651893848_7180179585.jpg\"},{\"id\":\"DMcYV9DzbhI\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.71878-15/520123884_1070536941810821_1051590178223131357_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=109&ig_cache_key=MzY4MjkyNTY1NzA2OTU2NjAyNA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgzNjAuc2RyLkMzIn0%3D&_nc_ohc=GgoTARjd3wQQ7kNvwGPVNPQ&_nc_oc=AdmDKGb5VKL9HhEc4j9fnHtFxucLoBRdXitqT5OGv9zqOv7JHj6J0ajQj5E7nPD8vwU&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=uj2rLgjw88-LMal05hjAow&_nc_ss=8&oh=00_AfymHiZFLgZ9FRzxVcbFm-lYKoZZTZhPOWIuSSFBWviXgg&oe=69AC7D55\",\"caption\":\"Momen hangat saat warga menerima bantuan pangan 2025. #BantuanPangan2025 #UntukRakyat #Kotabekasi #Bekasikeren\",\"post_time\":1753259043,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3682925657069566024_7553016190.jpg\"},{\"id\":\"DMcEB8bSz7x\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/523352532_18317857636235586_2219208736816851342_n.webp?stp=dst-webp_p720x720&_nc_cat=107&ig_cache_key=MzY4MjgzNjMyMTA3MDE2OTg0MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=U4i4kcWRdj0Q7kNvwFoa2fS&_nc_oc=AdkGWNjZ9BOjjVGKWY9JuMVJSRkgz0i1HNox9m_xpCcIIqUBeFOzJQfSGUPW32KVptE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=uj2rLgjw88-LMal05hjAow&_nc_ss=8&oh=00_AfxTEAxyBCSnJno3nsaIwNSpC4iiECjbyE49aXtypudRUw&oe=69AC84E9\",\"caption\":\"📍 Apel Pagi Tingkat Kecamatan Bekasi Selatan\\n🗓️ Rabu, 23 Juli 2025\\n📌 Halaman Kantor Kecamatan Bekasi Selatan\\n\\nCamat Bekasi Selatan memimpin pelaksanaan Apel Pagi yang dihadiri oleh Sekretaris Kecamatan, para Lurah dan Sekretaris Kelurahan, para Kasi/Kasubag Kecamatan dan Kelurahan, Kepala UPTD/UPTB, serta seluruh aparatur ASN dan Non ASN se-Kecamatan Bekasi Selatan.\\n\\nKegiatan ini dilaksanakan sebagai sarana koordinasi, konsolidasi, serta penguatan komitmen bersama dalam menjalankan tugas pemerintahan dan pelayanan publik secara optimal di wilayah Kecamatan Bekasi Selatan.\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@karyasukmajaya \\n@isnainihd \\n@pemkot_bekasi \\n@humaskotabekasi \\n@diskominfobekasi\",\"post_time\":1753248323,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3682836321070169841_7180179585.jpg\"},{\"id\":\"DMZzy9NS_KM\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/522691264_18317754877235586_3418171880181543133_n.jpg?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=110&ig_cache_key=MzY4MjIwMTk3MjQxOTMyNjYwNA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=ze6J8FNbCmgQ7kNvwE8Wz6g&_nc_oc=Adki8BXixt5I1EqEi0bdGXUfR9KFBqqE4lQWTb-74H24hfvuTGHUdqfIapxX5HpdzXU&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=uj2rLgjw88-LMal05hjAow&_nc_ss=8&oh=00_AfwlsNKHatbraw9d4cqlu34zK4MXK-tit2KWooUpD-d57Q&oe=69AC8A14\",\"caption\":\"🤝✨ Pertemuan Rutin TP PKK Tingkat Kecamatan Bekasi Selatan\\n\\nCamat Bekasi Selatan membuka secara resmi kegiatan pertemuan rutin TP PKK didampingi oleh Ketua TP PKK Kecamatan Bekasi Selatan dan Ketua TP PKK Kelurahan se-Kecamatan Bekasi Selatan.\\n\\nKegiatan ini turut dihadiri oleh Ketua Pokja IV TP PKK Kota Bekasi dan berlangsung di Aula Kantor Kecamatan Bekasi Selatan dengan penuh semangat kebersamaan dan komitmen untuk meningkatkan peran serta PKK dalam pembangunan keluarga dan masyarakat.\\n\\n💐 Sinergi dan koordinasi yang kuat antar kader menjadi kunci dalam mewujudkan keluarga sehat, mandiri, dan sejahtera.\\n\\n@mastriadhianto @harris.bobihoe @wiwiekhargono @karyasukmajaya @isnainihd @pemkot_bekasi @diskominfobekasi @humaskotabekasi @pkk_kotabekasi @pkkkecbekasiselatan\",\"post_time\":1753172702,\"owner\":\"7180179585\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/7180179585/3682201972419326604_7180179585.jpg\"},{\"id\":\"DMZnusQxJCR\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/521907426_17868792840409784_4726779983791019124_n.jpg?stp=dst-jpg_e35_p720x720_sh0.08_tt6&_nc_cat=102&ig_cache_key=MzY4MjE0ODkwMjc4NzkxMTgyNTE3ODY4NzkyODM0NDA5Nzg0.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTkyMC5zZHIuQzMifQ%3D%3D&_nc_ohc=Cgm7D7dtU9EQ7kNvwEGaBJb&_nc_oc=AdkMAlcrZmAbtu90p-wQl5jBggH1FAVsPCTakcR8KbR_hWapZ1fKXUdtZtWFf1wTqG8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=uj2rLgjw88-LMal05hjAow&_nc_ss=8&oh=00_AfwCDbi9Eovvep4G1I1DeKPCQIPo8KY1RgPTmtWhTJQUug&oe=69AC6C5B\",\"caption\":\"Pengaturan Lalu Lintas dalam pelaksanan pemeliharaan jalan (Pengaspalan) oleh D