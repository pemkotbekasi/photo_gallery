2MTE0MA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM4LnNkci5DMyJ9&_nc_ohc=0nqB2YsCQUAQ7kNvwFYyJEu&_nc_oc=AdnPEd09tAy3B9T2bAPIDNK1Fsl3qDnMNrcGjfcpzlS9CmCd3JSeaCmMnQmoMNyRg9A&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=jOIdVKQ8ZQ-Ha07DUoBrOQ&_nc_ss=8&oh=00_AfynGQgo-q6AXiK9BGqmAfX7J5hVgSgnAslCnCHM0EsH7w&oe=69AC7892\",\"caption\":\"Penertiban dimulai dari pembenahan fisik! 🚧\\n\\nBapak Camat Pondokgede hari ini memantau langsung pemasangan MCB Beton oleh Dinas Perhubungan (Dishub) Kota Bekasi di sepanjang trotoar Simpang Atrium Pondokgede, khususnya sekitar SDN 01 Jatiwaringin.\\n\\nLangkah tegas ini diambil untuk mengatasi PKL yang masih berjualan di badan jalan dan trotoar, yang telah mengambil hak pejalan kaki dan pengendara kendaraan bermotor.\\n\\nDiharapkan, dengan adanya pembatas ini, trotoar dapat kembali berfungsi dengan baik dan para pedagang dapat mencari lokasi berjualan yang lebih layak dan tertib.\\n\\n#Bekasi #DishubBekasi #PemkotBekasi #Pondokgede #TertibBerkah TrotoarUntukPejalanKaki\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah \\n@fariedwajdi\",\"post_time\":1769796570,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3821652377108361140_6820604156.jpg\"},{\"id\":\"DUI1EUlCfwy\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/625113897_18349676068228157_4483326665414258929_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=110&ig_cache_key=MzgyMTUyNjU1MDEyNjkxMjQyOQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=swh36M29uF8Q7kNvwFqXDDu&_nc_oc=AdkzVHNS2iCkHX9mSIl2jKnLdhs5QcPqra4TR2FYw0gPdSt1bdD-NLrWD5f2w7F6kQM&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=jOIdVKQ8ZQ-Ha07DUoBrOQ&_nc_ss=8&oh=00_AfxfqpNb-c1_xUQFbhWAhQzYtiT5TRJQSmUdvaVz5Lj4KA&oe=69AC6853\",\"caption\":\"Dalam upaya pencegahan, Kasi Trantib Kecamatan bersama Staff Ekbang Kecamatan, Korlap Satpol PP, dan pihak Unit Pasar Pondokgede melakukan pengecekan langsung lokasi tembok APG yang runtuh di Pasar Pondokgede. Pemeriksaan ini bertujuan untuk mengajukan perbaikan segera kepada Dinas Pasar terkait guna menghindari risiko tembok rubuh yang dapat membahayakan, sekaligus merencanakan penataan agar tampilan pasar lebih indah dan tertata, mengacu pada keberhasilan penataan di Pasar Pondok Melati.\\n\\n#TindakCepat #PasarPondokgede #KasiTrantib #CegahBahaya #PasarAman\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1769782801,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3821537677263109170_6820604156.jpg\"},{\"id\":\"DUI0hXhCWwk\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/624640665_18349675393228157_2265727479948933028_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=103&ig_cache_key=MzgyMTUyMzY0NzkwMzM5NjkzNg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=uEPd8T_F5wYQ7kNvwHvNGOY&_nc_oc=Adnt_T9_RJTln2qdkrmHJTkRHY8sZA598oNKktXNKCo2ZSwQuYBX9QTYxRlpPlUEEjs&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=jOIdVKQ8ZQ-Ha07DUoBrOQ&_nc_ss=8&oh=00_AfzN7Zk7JFUsx9zmqCSbCLo2YDohJcdMGYz71TGWD4K8vA&oe=69AC625C\",\"caption\":\"Pada Kamis, 29 Januari 2026, Bapak Camat Pondokgede bersama Lurah Jatibening melakukan monitoring langsung ke RW 11, Perumahan Jatibening Permai, Kelurahan Jatibening. Kunjungan ini merupakan tindak lanjut atas hujan dengan intensitas tinggi yang berlangsung dari malam hingga pagi hari, guna memastikan kesiapan penanganan darurat, menilai langsung dampak genangan, dan memberikan arahan tepat untuk keamanan serta kenyamanan warga terdampak.\\n\\n#SiagaBanjir #JatibeningPermai #LurahSigap #CamatMonitor\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1769782514,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3821535275235503140_6820604156.jpg\"},{\"id\":\"DUIzZb5CRbO\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/625101403_18349674712228157_913329747187113946_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=106&ig_cache_key=MzgyMTUxOTcxMzk0ODIzNzc5NA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=Q5Uz8WaoVGgQ7kNvwHbWu8P&_nc_oc=AdlBFhbk06SZDtZLMNi1teFHMPjmPHyB-gShMSSpgfwh2fI97ZWQi1yzgpBADnFsaKQ&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=jOIdVKQ8ZQ-Ha07DUoBrOQ&_nc_ss=8&oh=00_AfzokYOALrk_R2fGd-p9gfjPuJUgkVE99LGvX5i6hDDfDQ&oe=69AC94EE\",\"caption\":\"Menindaklanjuti intensitas hujan yang terjadi sejak malam hingga pagi hari, Bapak Camat Pondokgede secara langsung melakukan monitoring dan pengecekan kondisi genangan/banjir di wilayah RW 15 dan RW 11, Kelurahan Jatimakmur pada Kamis, 29 Januari 2026. Kunjungan ini bertujuan untuk memastikan kesiapan penanganan darurat, menilai dampak, serta memberikan arahan cepat guna mengantisipasi dan memulihkan kondisi lingkungan terdampak.\\n\\n#SiagaBanjir #CamatMonitor #Jatimakmur #PondokgedeSigap\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi \\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1769781928,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3821530332130776782_6820604156.jpg\"},{\"id\":\"DUIyQYAiVzz\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/623807293_18349673824228157_199410094056673348_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=110&ig_cache_key=MzgyMTUxNDE5ODM3MTM4NTE1Ng%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=Fh7XpsedvWQQ7kNvwGMCPnt&_nc_oc=AdnsD6_XCOJ4PGYZsGPmljpidr4bTP3kbSQ3oxswsYPrzdSGeVLVw_jpmYCk8_UUqd0&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=jOIdVKQ8ZQ-Ha07DUoBrOQ&_nc_ss=8&oh=00_AfwM-Fc_QFuWwv65unqiDT7oG_iliq4ls-wWWo_6yZoHOQ&oe=69AC7EE0\",\"caption\":\"Memastikan kesiapan pelaksanaan program, Kasi Permas Kecamatan Pondokgede bersama Kasi Permasbang Kelurahan Jaticempaka dan Ketua BKM setempat melaksanakan monitoring dan evaluasi (monev) lapangan terhadap saluran yang akan dinormalisasi oleh BKM Kelurahan pada Tahun Anggaran 2026 di wilayah RW 02 dan RW 12. Kegiatan ini bertujuan untuk meninjau langsung kondisi eksisting, menyelaraskan rencana teknis, serta memastikan koordinasi yang solid agar pekerjaan normalisasi dapat berjalan tepat sasaran dan lancar.\\n\\n#NormalisasiSaluran #Jaticempaka #BKMUnggul #TA2026 #PermasProaktif\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1769781318,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3821525311439854835_6820604156.jpg\"},{\"id\":\"DUIxpp4Caox\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/624873129_18349672942228157_3248573669390500997_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=105&ig_cache_key=MzgyMTUxMTAzMTkxNTEwNjUzNA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=At5RM214zjAQ7kNvwESId4o&_nc_oc=AdmYpvyfA3tPgfAOParkoe_oKPgJyR9zUKZRN5FafcmDhQmUhVVUYyqd6gZyTEwEnYc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=jOIdVKQ8ZQ-Ha07DUoBrOQ&_nc_ss=8&oh=00_AfxyVzSaVj6YYja9SmH_Y5YcsKC8gcppOIG8FlWvFFYgrw&oe=69AC70AF\",\"caption\":\"Guna mendukung pengajuan bantuan pakan ternak yang tepat sasaran, Kepala Seksi Ekonomi Pembangunan (Kasi Ekbang) bersama Kepala Seksi Ketertiban Umum (Kasi Trantib) melakukan survei lapangan langsung ke Kelompok Ternak \\\"Arah Sejahtera\\\" di Kelurahan Jaticempaka. Kegiatan ini bertujuan untuk mengumpulkan data akurat mengenai kondisi kandang, jumlah ternak, dan kebutuhan pakan sebagai dasar dokumen pengajuan resmi ke dinas terkait, sehingga bantuan yang diberikan dapat optimal.\\n\\n#DukunganPeternak #ArahSejahtera #Jaticempaka #BantuanPakan #EkbangTanggap\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1769781000,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3821522650565028401_6820604156.jpg\"},{\"id\":\"DUIv_wtCZ9m\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/624061268_18349670785228157_8645237900895706300_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=108&ig_cache_key=MzgyMTUwMDczMzQyMjQwMDU3MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=vKTgpdl_ujwQ7kNvwHghjIH&_nc_oc=AdlQb-Fbxio30oeBHiZP40cx9DXU5polRsBJjy6UTw-x3CqEPHH8FYjFZ1FopASjYz4&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_AfyqUlwQ6EwDkBUZZwzUOGOYml2mTr3IBCdmPlAEvhpm6w&oe=69AC7F37\",\"caption\":\"Untuk mengantisipasi dan menanggulangi genangan air saat curah hujan tinggi, Bapak Camat Pondokgede secara resmi menerima bantuan pompa air dari Dinas Bina Marga dan Sumber Daya Air (DBMSDA). Penyerahan yang berlangsung pada Selasa, 27 Januari 2026 di Perumahan Essence Park, Kelurahan Jaticempaka ini, merupakan bentuk sinergi strategis guna meningkatkan kapasitas drainase dan memberikan rasa aman bagi warga dari potensi banjir.\\n\\n#CamatPeduli #Pondokgede #Jaticempaka #AntisipasiBanjir #EssencePark\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1769780132,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3821515373632135014_6820604156.jpg\"},{\"id\":\"DUIu0wxCXzQ\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/624844176_18349670113228157_897302506760400209_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=109&ig_cache_key=MzgyMTQ5NzU4Nzc1MzExMDU4MA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=Ab1wWa-iAk4Q7kNvwFpJUrw&_nc_oc=AdnWy7NN8tp8c1EoRidfPiDsjzEuIkJdKWskfIa9E8dqb02GzUZOzq5Z1yIC4HT6CVs&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_AfxSOfbF0_PTk1JpM1EO4Omyt2zO3naapZNuWPCmodPrZQ&oe=69AC822C\",\"caption\":\"Guna memastikan kelancaran dan kepatuhan terhadap regulasi, Kasat Trantib memimpin rapat koordinasi perizinan pembangunan gedung MBG di lingkungan RW.010, Kelurahan Jatimakmur. Rapat ini merupakan langkah antisipatif dan sinergis antara petugas trantib, pengurus RW, serta pihak pemilik proyek untuk membahas prosedur, persyaratan, serta komitmen bersama dalam menjaga ketertiban dan keamanan proses pembangunan di wilayah tersebut.\\n\\n#TrantibProaktif #Jatimakmur #PerizinanBerkelahiran #MBG #KetertibanUmum\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1769779528,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3821510219738479824_6820604156.jpg\"},{\"id\":\"DUItqeviUmt\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/625633105_18349669543228157_800339146609632093_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=104&ig_cache_key=MzgyMTQ5MzQ5MjE2NjI2MDk5NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=Q0zufOeqbKAQ7kNvwEYA4ZX&_nc_oc=AdnipyPueVHA-KjQ-9wj4pNT6TnZcgruyEF88y9LnAtVxS5LDXDOwG48vZeX4fQI6Zk&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_AfzbTuFSMwozl4vhXM2ugIQYCfLTSpln8PrtpyVCtUgeLA&oe=69AC6F08\",\"caption\":\"Bapak Camat segera menindaklanjuti laporan warga di media sosial Instagram mengenai kondisi atap rumah Bapak Kurniawan di Jalan Gamprit 2, RT 004/RW 014, Kelurahan Jatiwaringin, yang mengalami kerusakan parah. Langkah awal yang dilakukan adalah berkoordinasi dengan bagian terkait untuk segera mengajukan bantuan program rumah tidak layak huni (rutilahu) guna memperbaiki kerusakan dan meringankan beban warga yang terdampak.\\n\\n#Rutilahu #Jatiwaringin #CamatPeduli #ResponsCepat #PeduliWarga\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1769778912,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3821505115144669613_6820604156.jpg\"},{\"id\":\"DUCztqQkd_R\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.71878-15/622356437_805677775581578_8510384595961977116_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=102&ig_cache_key=MzgxOTg0Mjg3MjA4NzI3MzQyNQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM2LnNkci5DMyJ9&_nc_ohc=krHlD-w7foUQ7kNvwF9-n42&_nc_oc=AdnUlobLUrLDm4mISXVbZzflMN1HvPm3D8MGp5V6ogS5o3Unvs0gmC0xDoQvzUIgEqw&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_Afw0QEsu2TeCd4M28Gnq2RjButWkT3Nkn80Q2twsAZ0pcQ&oe=69AC822C\",\"caption\":\"Anak muda Pondokgede, saatnya jadi agen perubahan! 🌟\\n\\nIsi hari dengan aksi positif bersama #MASDARLING (Masyarakat Sadar Lingkungan): edukasi pilah sampah, kumpulkan anorganik, dan jauhi hal negatif. Lingkungan bersih, masa depan cerah!\\n\\n#PemudaPondokgede #GenerasiPeduli #AksiPositif #AntiTawuran #AntiNarkoba #PondokgedeBersinar #MASDARLING #Bekasinyamankotanyasejahterawarganya\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkotbekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah \\n@fariedwajdi\",\"post_time\":1769580951,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3819842872087273425_6820604156.jpg\"},{\"id\":\"DT2uCfQiTB8\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.71878-15/622129296_909134644917185_8910210660032323877_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=102&ig_cache_key=MzgxNjQ0MDIxNTM4NDk2MTE0OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM2LnNkci5DMyJ9&_nc_ohc=PWORrR9YNM8Q7kNvwFRLAuf&_nc_oc=AdmaQ_-4E6hvFyiMQoKjY-lNBgOB5h2gHYfs9vqPp-jXVpZwX2-GDT9qVvuI1-LZ7Lc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_AfxzTmOi5eJHtMGLQ15vBrzTo5TS6pHvqd-RCMOudppsAg&oe=69AC658B\",\"caption\":\"Banjir bukan akhir cerita, tapi awal dari kolaborasi. ✨\\n\\nSejak malam, kami pantau titik genangan di Jatibening Permai. Paginya, kami mulai dengan penataan lingkungan, menertibkan pedagang di Simpang APG dan rapikan area sekolah.\\n\\nSiangnya, kolaborasi nyata dimulai! Bersama Wali Kota Bekasi, kami mendampingi Wakil Menteri PUPR Ibu Diana Kusumastuti tinjau langsung saluran. Ada komitmen kuat untuk normalisasi saluran dari pemerintah pusat & kota.\\n\\nUsai Jumat, lanjut tinjau titik kritis outlet air di Permata Timur yang berdampak ke Antilope. Perjalanan panjang dari malam ke malam, demi satu tujuan: Pondokgede yang lebih tertib dan bebas banjir.\\n\\nTerima kasih untuk semua pihak yang terlibat, dari tingkat RT, kelurahan, kecamatan, kota, hingga pusat. Sinergi ini kunci utamanya! 🫶\\n\\n#Pondokgede #Bekasi #Kolaborasi #PenangananBanjir #NormalisasiSaluran #PUPR #LingkunganBersih\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah \\n@fariedwajdi\",\"post_time\":1769175245,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3816440215384961148_6820604156.jpg\"},{\"id\":\"DT2bAeICXWn\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.71878-15/620221947_880130634903483_4195901790174092186_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=MzgxNjM1NjUxMzg0NTk2NjI0Nw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM2LnNkci5DMyJ9&_nc_ohc=r4nCwvsoDVQQ7kNvwHhHnYL&_nc_oc=AdnXHuETFcvnp1fN1Hco5qDsgvX7hjDLhOJebNLAmpvJ5uC5lfjarJHvrCvWLGXcBB4&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_Afy60Xx4MtwggX0hyQgD3cugCkWUpEuOe7c5iQeOpMYQAw&oe=69AC7348\",\"caption\":\"Kolaborasi nyata untuk warga! Wamen PU Ibu Diana Kusumastuti bersama Pemkot Bekasi, dipimpin langsung Bapak Wali Kota dan Camat Pondokgede, turun ke lokasi guna menangani banjir di Perumahan Jatibening Permai. \\n\\nKomitmen kami: lakukan normalisasi saluran air sesuai standar untuk solusi jangka panjang. Targetnya jelas: drainase lancar, tanpa banjir, tanpa ketergantungan pompa. Demi kenyamanan dan ketenangan warga Jatibening Permai. \\n\\n#BekasiBanjir #PUPR #KolaborasiNyata #JatibeningPermai\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe \\n@zainal.abidin.syah \\n@fariedwajdi\",\"post_time\":1769165340,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3816356513845966247_6820604156.jpg\"},{\"id\":\"DTzDPOEiXZ3\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/619109284_18348422584228157_4745827415203616082_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=103&ig_cache_key=MzgxNTQwNzU0OTM1MzEyOTU5MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=_yDjmpt-XkQQ7kNvwG2tJYe&_nc_oc=AdnAi-PCiNxiWiC1llkyqzBP0pnEFL5lGJb1cR5c2NXOBI-8XNRk9hLQVLB9wqblN7Y&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_AfwoBGv7yPs_WD1zJhYdIhDTrpkBIk2PWLPATEscsJqq6A&oe=69AC6A2C\",\"caption\":\"📢 PERHATIAN ASN KOTA BEKASI! \\n\\nKhusunya Aparatur Kecamatan Pondokgede.\\n \\nAturan baru udah keluar nih, demi integritas dan kepercayaan publik. Yuk simak poin-poin pentingnya:\\n\\n🚫 Jangan Selingkuh – Baik sama sesama ASN, non-ASN, atau siapapun. Tetap jaga etika dan norma!\\n🚫 Jangan Nikah Siri – Nikah harus dicatat resmi, jangan sembunyi-sembunyi ya!\\n⚖️ Siap-Siap Kena Sanksi – Pelanggaran bakal ditindak tegas sesuai UU dan aturan yang berlaku.\\n👁️ Pengawasan Ketat – Pimpinan unit akan melakukan pembinaan dan pengawasan intensif.\\n\\nKita adalah contoh bagi masyarakat. Mari jaga nama baik diri dan instansi dengan tetap profesional dan bermartabat. 💼✨\\n\\n📄 Surat Edaran Walikota Bekasi No: 800.1.5 / 219 / BKPSDM.PKA\\n\\n#ASNKotaBekasi #IntegritasItuKeren #BekasiBermartabat #EtikaASN #LawanSelingkuh #NoNikahSiri #DisiplinASN #KotaBekasi #AparaturNegara #SipilYangBerintegritas #AturanTerbaru\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1769052045,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3815407549353129591_6820604156.jpg\"},{\"id\":\"DTxwLX0CXe8\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.71878-15/620196445_1574604280351177_6406328053703056866_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=103&ig_cache_key=MzgxNTA0MjI0NzA3NTM5NTUxNg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM2LnNkci5DMyJ9&_nc_ohc=gR59UxuYkhYQ7kNvwHC1RDY&_nc_oc=AdlD1SGCWcMWuvyCDsOCvkyBp977eBA_O9YJ9Jv0m69mHZuIHBFvkEf127WCH1tAceo&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_Afx6Zh_ftEF7QqXJXhQ3SM8WJJi42MLyi6alJ05TWghVAA&oe=69AC7FDA\",\"caption\":\"📋 On The Spot!\\nCamat Pondokgede bersama Tim Disparbud turun langsung untuk survei lokasi pengembangan Kampung Santri sebagai destinasi wisata baru.\\n\\nSinergi ini jadi langkah nyata wujudkan wisata berbasis kearifan lokal dan edukasi. Bersiaplah sambut wajah baru wisata religi di Pondokgede!\\n\\n#KampungSantriPondokgede #Disparbud #WisataReligi #PotensiDaerah #KolaborasiPondokgede #ExploreBekasi\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah \\n@fariedwajdi\",\"post_time\":1769008590,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3815042247075395516_6820604156.jpg\"},{\"id\":\"DTwtTXpkT3P\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.71878-15/620434975_1992694621591335_5314597019219584520_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=MzgxNDc0ODEyNzUzOTMxNDEyNw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM2LnNkci5DMyJ9&_nc_ohc=eh0-SZuN7u4Q7kNvwHYdEwt&_nc_oc=AdkOon-nf9QNQhz_hb4zyvmmSLT_aM7CCWaHSsqLBv-ArW2pvQGx4kC0QmmaCvWxlHg&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_AfxeG_CJco1pzAqkGifgKPmGBjL_ThUpZxIpczW2YHjAOA&oe=69AC6A71\",\"caption\":\"Turun langsung melihat kondisi! Bapak Camat Pondokgede meninjau lokasi genangan air di Jalan Jatimakmur (depan pool bus) pada Senin, 19 Januari 2026. Melalui koordinasi dengan kelurahan dan pihak terkait, disepakati bahwa tahun ini akan dilakukan peningkatan jalan beserta normalisasi saluran air di titik tersebut. Harapannya, upaya ini dapat mengatasi persoalan genangan secara permanen untuk kenyamanan dan kelancaran bersama.\\n\\n#CamatPondokgede #Jatimakmur #GenanganAir\\n#NormalisasiSaluran #PeningkatanJalan #KotaBekasi\\n#InfrastrukturBaik #LayananPublik #SolusiNyata\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah \\n@fariedwajdi\",\"post_time\":1768973823,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3814748127539314127_6820604156.jpg\"},{\"id\":\"DTsCNlukS7y\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.71878-15/619489409_1366277051442735_6327350026677186289_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=109&ig_cache_key=MzgxMzQzMjcxNDQzMTkwMTQyNg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM2LnNkci5DMyJ9&_nc_ohc=flm_NJDYsJQQ7kNvwFJvH3z&_nc_oc=Adnzk8HpM6D0uZ5Slt3UWalolJmCtjvFW1VULMsN9RbkPRp1eWhy56KRsZdP1g2CpUg&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_AfyiuxBOmyOGbOnLxTzQkh9UM4-D5bLG4fwLBrRnXkAZ8Q&oe=69AC679B\",\"caption\":\"Tinjauan langsung Bapak Camat Pondokgede di kawasan banjir RT 01 RW 011, Kelurahan Jatiwaringin, Perumahan Wisma Jaya. Hasil dari kunjungan ini menjadi dasar penyusunan Usulan Teknis Normalisasi Saluran oleh Seksi Ekonomi dan Pembangunan, untuk diajukan ke Dinas Bina Marga dan Sumber Daya Air Kota Bekasi. Upaya ini diharapkan dapat memberikan solusi bagi persoalan banjir yang telah berlangsung sejak tahun 1990. Semoga kolaborasi ini membawa hasil optimal untuk kenyamanan warga. 🤝\\n\\n#TinjauanLapangan #CamatPondokgede #WismaJaya\\n#NormalisasiSaluran #BebasBanjir #KotaBekasi\\n#Jatiwaringin #SolusiInfrastruktur #PembangunanDaerah\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe \\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1768818344,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3813432714431901426_6820604156.jpg\"},{\"id\":\"DTlBrjVCdVq\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/616207357_18347807020228157_2189640885980118168_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=111&ig_cache_key=MzgxMTQ2MDA1MDU1NjkzMzQ4Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=VFto2uuFolwQ7kNvwGnQPaR&_nc_oc=Adm4bQ_sFsjXXhhNBQqDorPn0W7P2NEO_vAj3ZBeMIAI96ns-sQfABDvj2UU-ooPAso&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_AfwctPFVIpJK6SwgsuYu4PBrXBaqzBjUyIaePRuxuLS_DA&oe=69AC87F9\",\"caption\":\"\\\"Dalam sunyi malam Isra Miraj, iman terangkat dan jiwa dipeluk cahaya Ilahi. Ketenteraman hadir tanpa suara, namun terasa nyata.\\\"\\n\\nSelamat memperingati Isra' Mi'raj 27 Rajab 1447 H. Mari kita renungi hikmah perjalanan agung Nabi Muhammad SAW untuk mempertebal iman dan keimanan kita.\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1768581468,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3811460050556933482_6820604156.jpg\"},{\"id\":\"DTefMcVCWHn\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/613588170_18347545423228157_1295812370533227909_n.jpg?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=103&ig_cache_key=MzgwOTYxOTUxODEwNDg3MTAwMQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTM1MC5zZHIuQzMifQ%3D%3D&_nc_ohc=UgdAiATfYogQ7kNvwEdpFra&_nc_oc=Adk015WQHzfGahH4Btf-6jelhdv4H_lvaKjP4rw8V210-q8GZZjujWIADRLgoPLQUj4&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=4mQbUCrDgUdGBV5n09peCw&_nc_ss=8&oh=00_Afx5uNZNs0roxCU8_Pb_h1b1TiP46rh3DmH2-nMYGxZ47g&oe=69AC8D5F\",\"caption\":\"Kegiatan Normalisasi Saluran dalam Penanganan Genangan Air di Kelurahan Jatimakmur\\n\\nKolaborasi Ekbang Kecamatan Pondokgede dan Tim Pematusan DBMSDA Tinjau Lokasi Rawan di Pool Bis & Simpang Bojong\\n\\nTim Ekonomi dan Pembangunan (Ekbang) Kecamatan Pondokgede melakukan pemantauan langsung penanganan titik genangan air di wilayah Kelurahan Jatimakmur. Lokasi yang menjadi fokus adalah area Pool Bis dan Simpang Bojong, yang sering menjadi langganan tergenang saat intensitas hujan tinggi.\\n\\nKegiatan ini dilakukan bersama tim dari Pematusan Dinas Bina Marga dan Sumber Daya Air (DBMSDA) Kecamatan Pondokgede. Monitoring lapangan bertujuan untuk mengevaluasi kondisi saluran air dan infrastruktur drainase saat ini, sekaligus menyusun langkah-langkah percepatan penanganan guna mencegah dan meminimalisir genangan air yang mengganggu kenyamanan serta aktivitas warga.\\n\\n#Jatimamkur #GenanganAir #Normalisasi #PondokgedeBersinar #KotaBekasiKeren #TimPematusanDBMSDA\\n\\n@humas_jabar \\n@humaskotabekasi \\n@pemkot_bekasi \\n@prokopimkotabekasi \\n@mastriadhianto \\n@harris.bobihoe \\n@zainal.abidin.syah \\n@fariedwajdi \\n@dbmsdakotabekasi\",\"post_time\":1768362059,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3809619529295290855_6820604156.jpg\"},{\"id\":\"DTHx1VEEY2_\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/611009154_18346643284228157_5511908422018505601_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=MzgwMzIyNzU3OTM2NTgyMTg4NzE4MzQ2NjQzMjgxMjI4MTU3.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjU0MHg5NjAuc2RyLkMzIn0%3D&_nc_ohc=8Jssb8N9npkQ7kNvwEE4Zck&_nc_oc=AdnIKb80cdW_jeuybnwhRQ0u-w3GmyBPL_3pL23D2RfrBsbBHtKCOEd1Y8n73HO0uOs&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_AfwkVFaKVBfubeSqW3V4CvS1k595wmws2oHJXxwFSDK-4A&oe=69AC86D1\",\"caption\":\"Gotong royong tanpa batas administrasi! 🛠️ Laporan warga soal saluran air perbatasan RW 02 Jatibening Baru & RW 12 Pondok Kelapa Jakarta Timur segera ditindaklanjuti. Camat dan Lurah langsung berkoordinasi dengan Tim Pematusan DBMSDA Kota Bekasi untuk melakukan normalisasi saluran. Terima kasih atas sinergi yang solid dari semua pihak demi solusi yang berkelanjutan.\\n\\n#NormalisasiSaluran\\n#KolaborasiLintasWilayah\\n#AntisipasiBanjir\\n#DrainaseBerkelanjutan\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\\n@dbmsdakotabekasi\",\"post_time\":1767600252,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3803227579365821887_6820604156.jpg\"},{\"id\":\"DTBB6FzklFH\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.71878-15/609655164_1256706796361370_3802976048576116400_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=MzgwMTMyNzk1MDQ4NzUwNzI3MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM2LnNkci5DMyJ9&_nc_ohc=IYcwYvYC5xsQ7kNvwGPVyK4&_nc_oc=AdkhzYTKlB4kFxzTeUuSEVzTmqXxZxJiX4mO1iihSIfDE1v63-l_qDaDQb5FHqjoTPs&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_AfxBocA5hGC1Ni-tRTWhuMfy7FveuPh7pvIY2PqrNRrrPA&oe=69AC95B5\",\"caption\":\"Refleksi 2025, semangat baru 2026! 🌟\\nTerima kasih atas setiap langkah bersama warga Pondokgede.\\nBersama kita wujudkan Pondokgede yang lebih maju, nyaman, dan sejahtera.\\n\\n#PondokgedeBergerak #Refleksi2025 #Pondokgede2026\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah \\n@fariedwajdi\",\"post_time\":1767373709,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3801327950487507271_6820604156.jpg\"},{\"id\":\"DS88DqbCZZz\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/607510885_18346162807228157_1796343548369322617_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=105&ig_cache_key=MzgwMDE3NjMyMDA5MzcyMjIyNw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=XHikgBAX3LcQ7kNvwFmxDUy&_nc_oc=AdmLQ-co4xb1YkXv03o3GamojLvUsua2e8Jm3Y6TaNlwrJ03i8D32a6BH_H0zEK3xx8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_Afx8ODGbK-GHnIPYBkh6_Isuv2SMdKE_U6aPMkn1zYggSg&oe=69AC90AE\",\"caption\":\"✨Selamat Tahun Baru 2026 ✨\\n\\nMari bersama kita panjatkan doa dan harapan terbaik:\\n\\n· Untuk Indonesia: Semoga negeri kita semakin maju, adil, dan sejahtera. Dilimpahkan kedamaian, kemakmuran, serta persatuan yang kokoh untuk melangkah lebih jauh di kancah dunia.\\n\\n· Untuk Kota Bekasi: Semoga Bekasi sebagai Kota Patriot terus tumbuh menjadi kota yang semakin nyaman, maju, berbudaya, dan memberikan kesejahteraan bagi seluruh warganya.\\n\\n· Untuk Warga Pondokgede tercinta: Semoga tahun 2026 membawa lebih banyak kebahagiaan, kesehatan, dan kesuksesan untuk setiap keluarga. Semoga semangat gotong royong dan kerukunan kita semakin kuat, membuat Pondokgede semakin maju, aman, dan asri.\\n\\nTerima kasih atas kerja sama dan partisipasi seluruh masyarakat sepanjang tahun 2025. Mari sambut 2026 dengan semangat baru, kolaborasi yang lebih erat, dan komitmen untuk membangun Pondokgede dan lingkungan kita bersama.\\n\\nSelamat Tahun Baru! Semoga tahun ini menjadi tahun penuh berkah dan pencapaian.\\n\\n#SelamatTahunBaru2026\\n#TahunBaru2026\\n#KecamatanPondokgede\\n#Pondokgede\\n#Bekasi\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1767236341,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3800176320093722227_6820604156.jpg\"},{\"id\":\"DS6bfhbCU2W\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/592523236_18346013164228157_808609797239159264_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=111&ig_cache_key=Mzc5OTQ3MDE0OTA4NzA4ODAyMg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=h_ZM1QuY5OwQ7kNvwGHDTPm&_nc_oc=AdlCbjWbNFTdhQGd_JzlM2O3_OIKiqWUKh-BXaLpA4bATRg1HPSCyN6VIaHxKg-HDGc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_AfzhDD3tPmZagfWcjxb9sENn6v4u1A0sIGtnaUn_HcHLdQ&oe=69AC8553\",\"caption\":\"Menyambut Tahun Baru 2026 dengan penuh kepedulian dan empati.\\nForkopimcam Kecamatan Pondokgede mengajak kita semua untuk merayakan pergantian tahun secara sederhana, tanpa kembang api, dan tanpa hura-hura.\\n\\nMari bersama:\\n✨Mengisi malam pergantian tahun dengan kegiatan positif, doa, dan refleksi diri.\\n✨Menghindari pesta berlebihan, konvoi kendaraan, serta hal yang mengganggu ketertiban umum.\\n✨Menjaga keamanan dan kenyamanan lingkungan sekitar.\\n\\nMomen pergantian tahun ini adalah saat yang tepat untuk merenung, bersyukur, dan memperkuat solidaritas, terutama untuk saudara-saudara kita di Aceh dan Sumatera yang sedang mengalami musibah.\\n\\nTahun baru, semangat baru — dengan penuh kesadaran dan kebersamaan. 🙏\\n\\n---\\n\\n#TahunBaru2026 #Pondokgede #Bekasi #TahunBaruSederhana #Solidaritas #Kamtibmas #NoFireworks #DoaBersama #RefleksiAkhirTahun #Empati #BersamaKitaBisa\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1767152158,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3799470149087088022_6820604156.jpg\"},{\"id\":\"DS3yVfXCfUp\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/605111260_18345897304228157_7264197158584386086_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=106&ig_cache_key=Mzc5ODcyNjE4OTgxNzM5NDQ3Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=xnPHz8-BjYIQ7kNvwFUyn0V&_nc_oc=AdmZmek4XauMVogA3nRZgEeYcmYaHmPngOqVXcNS8lokIPcOeoN3EJ3zm2W19avgS4U&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_Afy0U90LlKkGKFfmV_3GWgP6tuROJs7LXfhdxKuqNsHspw&oe=69AC7B25\",\"caption\":\"Mari bantu saudara kita di Aceh & Sumatra yang terdampak bencana. Setiap detik berarti, setiap donasi sangat berharga.\\n\\nDonasi dapat ditransfer ke:\\n0147160488100\\na/n Patriot Berbagi\\n\\nKonfirmasi ke: Yudi (081283699970) atau Gofar (082246616316).\\n\\n📍 Kecamatan Pondokgede, Bekasi\\n\\n🚨 #Ayoberdonasi #BantuAcehSumatra #PatriotBerbagi #DonasiBencana\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1767063472,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3798726189817394473_6820604156.jpg\"},{\"id\":\"DSsagbJklVc\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/604365481_18345440209228157_635232672905046636_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=107&ig_cache_key=Mzc5NTUyNTE2MzM1MDY0NDA2MA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=nJIs-EK_uScQ7kNvwG5SJp_&_nc_oc=AdnskGefETXJD1zRbzVM-mYn7w-hCzN6uQM3nEoblII0Z9yDGQHGu1vSzsInu-nv5cA&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_AfyT6wFXUWZ2Bc22_ssdNZ3uGR9QWTjjhKpHD9XBKYpjlg&oe=69AC8E5D\",\"caption\":\"Selamat Hari Natal 2025 & Tahun Baru 2026\\n\\nKeluarga Besar Kecamatan Pondokgede mengucapkan:\\nSelamat Hari Raya Natal bagi yang merayakan,semoga kedamaian dan sukacita menyertai kita semua.\\nSelamat menyambut Tahun Baru 2026,semoga menjadi tahun yang penuh harapan, kemajuan, dan kesejahteraan.\\n\\nMarilah kita sambut tahun baru dengan semangat baru, komitmen yang lebih kuat untuk meningkatkan pelayanan publik, membangun sinergi, dan menciptakan Pondokgede yang lebih maju, aman, dan sejahtera.\\n\\nMari jaga kerukunan dan kebersamaan.\\n\\nKecamatan Pondokgede\\nMelayani dengan Hati, Membangun dengan Sinergi\\n\\n#KecamatanPondokgede#PondokgedeBersatu #Natal2025 #TahunBaru2026 #PelayananPublik #PemerintahKotaBekasi\",\"post_time\":1766681879,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3795525163350644060_6820604156.jpg\"},{\"id\":\"DSmx__ACZGP\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/604508366_18345190858228157_2238101129933480994_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=101&ig_cache_key=Mzc5MzkzOTYzNzM1ODY2MjAzMTE4MzQ1MTkwODUyMjI4MTU3.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjU0MHg5NjAuc2RyLkMzIn0%3D&_nc_ohc=HTSYt4WXNwkQ7kNvwF29ssy&_nc_oc=AdmCEjYQ1sFNvAJY7M4vF-pw6vmi4yNRwEuS1lFu1ETovhX_8Jq_fcXanJw5HlIUXeU&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_Afwxytvmp5fL0kFoXlyKAJBjqtlxyhJNnTWl5YWv3fL9mQ&oe=69AC8331\",\"caption\":\"Siap Mengawal, Siap Melindungi. 🛡️\\n\\nKomitmen kesiapsiagaan kami wujudkan dalam Apel Pam NATARU 2025/2026 yang digelar siang ini, Selasa 23 Desember 2025 di Stadion Mini Pondokgede.\\n\\nBersama seluruh elemen kecamatan — aparatur, UPTD, dan stakeholder — kami bertekad menjaga Pondokgede tetap aman, tertib, dan lancar sepanjang momen Natal dan Tahun Baru.\\n\\nTerima kasih atas sinergi solid dari semua pihak. Mari kita bersama sebagai masyarakat turut berperan aktif menciptakan lingkungan yang nyaman dan penuh kebahagiaan.\\n\\nSelamat merayakan Natal dan menyambut Tahun Baru 2026 dalam damai dan sukacita. 🎄✨\\n\\n#ForkopimcamPondokgede #ApelNataru #Nataru2025 #TahunBaru2026 #PondokgedeAman #SinergiUntukMasyarakat #KecamatanPondokgede #Bekasi #SecurityFirst #CommunitySafety #Natal #TahunBaru\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah \\n@fariedwajdi\",\"post_time\":1766493163,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3793939637358662031_6820604156.jpg\"},{\"id\":\"DSY_BFjCfio\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/598873674_18344630755228157_9056368603145706461_n.jpg?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=104&ig_cache_key=Mzc5MDA1NjIyODAzMDg2OTkyMg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTM1MC5zZHIuQzMifQ%3D%3D&_nc_ohc=nuV0ZzMUeW0Q7kNvwHJku43&_nc_oc=Adlij0EbSG8T1YPXEKyQ2H9rVKEIEPuhi7mRHHvNv38hIpt_3q0ZrRU1Dp33U2tt8Xo&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_AfxncTKEI2Im1lS2tBHs28HXL-5WsyIt4PnJKfFI_Sgn8Q&oe=69AC87B9\",\"caption\":\"Public Hearing Ranperda Perubahan Ketiga Perda LLAJ, Wujudkan Lalu Lintas yang Lebih Tertib\\n\\nSinergi Dewan, Kelurahan, dan Kecamatan Dengar Aspirasi Warga di Pendopo Jatiwaringin\\n\\nBertempat di Pendopo Jatiwaringin, telah diselenggarakan kegiatan Public Hearing (Pendengaran Publik) membahas Rancangan Peraturan Daerah (Ranperda) tentang Perubahan Ketiga atas Perda No. 9 Tahun 2019 mengenai Penyelenggaraan Lalu Lintas dan Angkutan Jalan. Forum ini menjadi ruang penting bagi pemerintah untuk menyerap masukan dan kritik konstruktif dari masyarakat guna penyempurnaan peraturan.\\n\\nKegiatan ini dihadiri secara langsung oleh Bapak Dewan Faisal, S.E., bersama dengan Bapak Lurah Jatiwaringin dan Kasie Trantib Kecamatan Pondokgede. Kehadiran para pemangku kepentingan ini menegaskan komitmen bersama dalam membangun regulasi transportasi yang lebih baik, efektif, dan sesuai dengan kebutuhan serta kondisi aktual di masyarakat. Semoga kolaborasi yang baik ini menghasilkan peraturan yang tepat guna untuk ketertiban dan keselamatan berlalu lintas kita semua.\\n\\n#PendopoJatiwaringin #PublicHearing #Ranperda #LLAJ #PondokgedeBersinar #KotaBekasiKeren #DewanFaisal\\n\\n@humas_jabar \\n@humaskotabekasi \\n@pemkot_bekasi \\n@prokopimkotabekasi \\n@mastriadhianto \\n@harris.bobihoe \\n@zainal.abidin.syah \\n@fariedwajdi\",\"post_time\":1766029933,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3790056238038513832_6820604156.jpg\"},{\"id\":\"DSY9sg7Ce8H\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/589225056_18344630077228157_1186499005129766737_n.jpg?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=100&ig_cache_key=Mzc5MDA1MDQyNjI3NjY3MTIzOQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjg2NHgxMDgwLnNkci5DMyJ9&_nc_ohc=M6kX-CbU-68Q7kNvwEX4Eng&_nc_oc=AdmwD2-0OWMgjKjt9M2B6JMNqxFnSakVvPPa2RHUDZvb_PTkPd42xIWsCwrF834XzmE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_AfxHNlGP5qvAXKby_0oX6zpG5HGmkmdaq1FvtvtdoVSKKg&oe=69AC8E6B\",\"caption\":\"Pra Musrembang Kelurahan Jatimakmur Resmi Dibuka, Wujudkan Partisipasi Masyarakat \\n\\nKegiatan Pra Musyawarah Perencanaan Pembangunan (Pra Musrembang) Kelurahan Jatimakmur telah resmi dibuka. Acara pembukaan ini dipimpin secara langsung oleh Lurah Jatimakmur beserta jajarannya, dan dihadiri secara antusias oleh seluruh Ketua RT dan Ketua RW di wilayah kelurahan. Pertemuan ini menjadi langkah awal yang krusial dalam merancang program pembangunan yang aspiratif, transparan, dan selaras dengan kebutuhan nyata warga Jatimakmur.\\n\\n#Jatimakmur #PraMusrembang #KotaBekasiKeren #PartisipasiMasyarakat #PembangunanDaerah #PondokgedeBersinar #RT #RW #Infokelurahan\\n\\n@humas_jabar \\n@humaskotabekasi \\n@pemkot_bekasi \\n@prokopimkotabekasi \\n@mastriadhianto \\n@harris.bobihoe \\n@zainal.abidin.syah \\n@fariedwajdi\",\"post_time\":1766029240,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3790050426276671239_6820604156.jpg\"},{\"id\":\"DSY8ZD2CUc4\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/599197098_18344629273228157_3845027844521238227_n.jpg?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=101&ig_cache_key=Mzc5MDA0NDY4MjgyMzIwODk0NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTM1MC5zZHIuQzMifQ%3D%3D&_nc_ohc=YCBtlk7T2g0Q7kNvwHqIRhv&_nc_oc=AdlBzj-9gr-6-g5A2_1kWkKpn3vP2wCrxEZFTFRgnv08-3M_1m2AaaFvdTUSUEzHvtM&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_AfwtevilHHAhNybahBjL0YqLyPNRCkp1bFWWemzEA4aesQ&oe=69AC6ECD\",\"caption\":\"PASAR MURAH BERSUBSIDI KEMBALI LAGI DI KECAMATAN PONDOKGEDE ✨\\n\\nUntuk WARGA KECAMATAN PONDOKGEDE jangan Lupa Catat Waktu dan Tanggal nya\\n\\n🗓️ Jum'at, 19 Desember 2025\\n⏰ Jam: 08.00 - 12.00 WIB\\n📍 Kantor Kecamatan Pondokgede\\n\\nSyarat dan Ketentuan :\\n- Terdaftar sebagai Penerima DTKS\\n- Membawa KTP Asli\\n- Membawa Uang Pas\\n- Untuk warga diluar penerima DTKS dapat membeli diatas jam 12.00 WIB\\n\\nUntuk Harga Paket Rp. 75.000,- berupa :\\n- Beras 5Kg\\n- Minyak Goreng 2 liter\\n- Tepung Terigu 1 Kg\\n- Gula Pasir 1 Kg\\n\\n@humas_jabar \\n@humaskotabekasi \\n@pemkot_bekasi \\n@prokopimkotabekasi \\n@mastriadhianto \\n@harris.bobihoe \\n@zainal.abidin.syah \\n@fariedwajdi \\n\\n#Pasarmurah #UMKM #PondokgedeBersinar #KotaBekasiKeren #SembakoMurah\",\"post_time\":1766028556,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3790044691337660216_6820604156.jpg\"},{\"id\":\"DSXEYF1iRND\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/584404769_18344549719228157_6977426182076075731_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=100&ig_cache_key=Mzc4OTUxNjIwMzQ2MzYyMTQwOQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=hk_gM5Fiw6sQ7kNvwGXos-f&_nc_oc=Admy0Yqez3slgcJ6QyINHXEcfIk26FKh8LQ_2ZP_75QxEkJYJlpfVQZNAQV7X4QK8ng&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_AfxPUyJs_-Y0eGVFhHbWndzsHpcZa1PFHfnMi8vyONBddw&oe=69AC6FC1\",\"caption\":\"Pondokgede, 17 Desember 2025 – Seksi Pemberdayaan Masyarakat (Permas) Kecamatan Pondokgede melaksanakan kegiatan Monitoring dan Evaluasi (Monev) di Posyandu Kenanga IV, RW 03, dan Posyandu Rampai II, RW 01, Kelurahan Jatibening. Kunjungan ini merupakan bagian dari upaya untuk memastikan kualitas dan efektivitas layanan kesehatan dasar, khususnya bagi ibu dan anak.\\n\\nTim melakukan peninjauan terhadap proses pelayanan, kelengkapan administrasi, serta koordinasi antara kader posyandu dan pengurus setempat. Keikutsertaan pengurus RW 03 dan RW 01 dalam kegiatan ini menunjukkan komitmen bersama dalam mendukung program kesehatan masyarakat. Hasil Monev akan menjadi acuan untuk perbaikan dan peningkatan layanan posyandu secara berkelanjutan.\\n\\n#PermasPondokgede #MonevPosyandu #KesehatanIbuDanAnak #PosyanduKenanga #PosyanduRampai #RW01Jatibening #RW03Jatibening #PemberdayaanMasyarakat #KesehatanKomunitas\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1765965634,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3789516859175932739_6820604156.jpg\"},{\"id\":\"DSXBFvuiQ2b\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/588892889_18344548291228157_1194500994422859215_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=100&ig_cache_key=Mzc4OTUwMjQwNDM0NjA1NjA5MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=RZHB73nysdsQ7kNvwHZ2MPI&_nc_oc=Adk82OJyh7e7skVYNVgVA4oYsav4rRs59h1LIjvszyCiIRUXpnDoCBmjOJKeK3v6C7c&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=KNhDRV5Csk6gNMDedpys4g&_nc_ss=8&oh=00_AfxuhXmsTDaLuU7Zd-p9VIkJT9J9TnYqnSPIanjGeOF_Rw&oe=69AC71AF\",\"caption\":\"Masih bingung atau mengalami kendala dalam lapor SPT Tahunan dan aktivasi akun DJP Online?Jangan khawatir! Manfaatkan layanan POJOK PAJAK yang GRATIS! ✅\\n\\n📍 Kantor Kecamatan Pondok Gede\\n📅Kamis, 18 Desember 2025\\n⏰09.00 - 14.00 WIB\\n\\nDapatkan bantuan langsung dari ahlinya. Ayo selesaikan kewajiban perpajakanmu dengan mudah!\\n\\n#PojokPajak #LaporSPT #DJPOline #Bekasi #PondokGede #Fiskal #PelayananPublik\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1765963913,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3789502404346056091_6820604156.jpg\"},{\"id\":\"DSWfnguiX6w\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/600022844_18344530300228157_1118507780968527335_n.jpg?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=106&ig_cache_key=Mzc4OTM1NTE4MzE5MzU0MDM0NA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTM1MC5zZHIuQzMifQ%3D%3D&_nc_ohc=CEL9FaTAqvQQ7kNvwGJL3CA&_nc_oc=Adk-qVtClgdokhq9tGr9QIUDdZSGxx5tRDlHCc49FUvtIvi3f4AlrtUKrKf1e6G1D6M&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=Vq01RevsmS7OOpdJ7K7bIw&_nc_ss=8&oh=00_AfxpiMoaUN6WbS7XkP87Si9lRczGv13RrlD7iiEbUMHrnQ&oe=69AC7C03\",\"caption\":\"Rapat Minggon Kecamatan Pondokgede, Sinergi untuk Pondokgede yang Lebih Baik\\n\\nRapat mingguan Kecamatan Pondokgede kembali digelar di Pendopo Kecamatan Pondokgede. Dipimpin langsung oleh Camat Pondokgede, Bapak Zaenal Abidin Syah, S.T., M.M., rapat ini dihadiri secara lengkap oleh seluruh Kasi Kecamatan, Lurah, serta Kepala Puskesmas se-Kecamatan Pondokgede. Turut hadir pula perwakilan dari UPTD Lingkungan Hidup, Dishub, Pendidikan, serta unsur Polsek dan Koramil Pondokgede, menandakan komitmen bersama dalam penanganan berbagai isu di wilayah.\\n\\nPertemuan ini secara khusus membahas sejumlah permasalahan yang ada di Pondokgede serta menyusun langkah strategis menyambut Natal dan Tahun Baru (Nataru) 2025. Dengan kehadiran Ketua RT dan RW se-Kecamatan Pondokgede, diharapkan koordinasi dari tingkat kecamatan hingga masyarakat berjalan optimal, guna menciptakan keamanan, ketertiban, dan kenyamanan bagi seluruh warga selama periode Nataru mendatang.\\n\\n@humas_jabar \\n@humaskotabekasi \\n@prokopimkotabekasi \\n@pemkot_bekasi \\n@mastriadhianto \\n@harris.bobihoe \\n@zainal.abidin.syah \\n@fariedwajdi \\n\\n#Nataru2025 #Bekasikeren #PondokgedeBersinar #InfoBekasi #PelayananPublik #KoordinasiWilayah\",\"post_time\":1765946361,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3789355191120789168_6820604156.jpg\"},{\"id\":\"DSUV4TUEXaS\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/599784711_18344440579228157_7968306969516312805_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=105&ig_cache_key=Mzc4ODc0ODgzMTIzNzE3NzcwMA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=4TRMxDqARj4Q7kNvwHl4Fn5&_nc_oc=AdnkdTgeTrN4mSMNPumz9II_YATWQoD5AtHOChgVvMkmXDnYqkqE3rT1QEo_9gVHQkw&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=Vq01RevsmS7OOpdJ7K7bIw&_nc_ss=8&oh=00_AfwJhDtR-RBC5GrZMS1FfHf96N-5HiJjds3Rh8BMEsTQDg&oe=69AC6A32\",\"caption\":\"Warga dan pengurus RW 01 Taman Sari Persada Raya, Jatibening Baru, menunjukkan solidaritas dengan mengumpulkan donasi sebesar Rp 20 juta. Sumbangan tersebut diserahkan secara langsung kepada Camat Pondokgede untuk disalurkan kepada korban banjir di Aceh dan Sumatra.\\n\\nDonasi yang terkumpul merupakan hasil partisipasi warga dengan semangat gotong royong. Bantuan ini diharapkan dapat memberikan dukungan nyata bagi masyarakat yang terdampak bencana di dua wilayah tersebut.\\n\\n#AksiSolidaritas #BanjirAcehSumatra #GotongRoyongWarga #DonasiUntukKorban #JatibeningPeduli #RW01Hebat #CamatPondokgede #BersatuAtasiBencana\\n\\n@humas_jabar \\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1765874147,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3788749414530643602_6820604156.jpg\"},{\"id\":\"DSUNxvQkfY3\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/588633555_18344435896228157_8911799118319880469_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=106&ig_cache_key=Mzc4ODcxMzc3OTEyODMwMTExMQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=47U91MMzMPEQ7kNvwFQO2ps&_nc_oc=AdmoRD1l577KcJunl7LJNd5elH6t8bSj9Z6E5z3DxuT_eNTI8kdo381X93vsR-nhutE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=Vq01RevsmS7OOpdJ7K7bIw&_nc_ss=8&oh=00_AfyXufNmLqbhkyXDML1O1fR_oGN5Ows8IV-rDO2V2dvEmg&oe=69AC94D3\",\"caption\":\"📢 KECAMATAN PONDOKGEDE, KOTA BEKASI\\n📊 Hasil Survei Kepuasan Masyarakat Triwulan IV (Oktober) 2025\\n\\n🌟 Skor Kepuasan: 87,08\\n📈 Mutu Pelayanan: BAIK (B)\\n\\nTerima kasih kepada 20 responden yang telah berpartisipasi:\\n👨 Laki-laki: 9\\n👩 Perempuan: 11\\n\\nTingkat Pendidikan Responden:\\n\\n· SD: 0\\n· SMP: 1\\n· SMU/SMK: 7\\n· D3: 2\\n· S1: 9\\n· S2: 1\\n\\nHasil ini menjadi evaluasi kami untuk terus meningkatkan kualitas layanan publik di Kecamatan Pondokgede.\\n\\n📱 Info lebih lanjut:\\n🌐 kec-pondokgede.bekasikota.go.id\\n📍 Kecamatan Pondokgede, Kota Bekasi\\n\\n#KecamatanPondokgede #Bekasi #SurveiKepuasan #LayananPublik #TriwulanIV2025 #PartisipasiMasyarakat #PelayananBaik\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi\",\"post_time\":1765869902,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3788713779128301111_6820604156.jpg\"},{\"id\":\"DSRnsdckTk-\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/590411412_18344325490228157_74132671725139358_n.heic?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=102&ig_cache_key=Mzc4Nzk4MjU4MTg1ODk1ODUwNQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=ffXJTrTic2cQ7kNvwFpSd-M&_nc_oc=AdkjUMxwP17P_ZYwbxgsdXm139ttI52TKgeXXLgBAe_4b0qJC5pVhYA2Hx5fEVflqb8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=Vq01RevsmS7OOpdJ7K7bIw&_nc_ss=8&oh=00_AfzevqPDxwwSEZ82ki3GbOPyeCYCu96YiBGGOy8893pp9w&oe=69AC7E2A\",\"caption\":\"Kecamatan Pondokgede dengan bangga mengumumkan pencapaian prestasi gemilang sebagai Juara 1 dalam Monitoring dan Evaluasi(Monev) Pejabat Pengelola Informasi dan Dokumentasi (PPID) Tingkat Kota Bekasi Tahun 2025. Keberhasilan ini dibuktikan dengan perolehan nilai tertinggi sebesar 134 dari maksimal 198, yang mencerminkan capaian kinerja sebesar 68%.\\n\\nPrestasi ini merupakan bentuk pengakuan atas dedikasi dan komitmen kuat seluruh jajaran pemerintahan Kecamatan Pondokgede dalam menjalankan prinsip transparansi dan akuntabilitas publik. Pencapaian nilai terbaik ini diharapkan dapat terus memacu semangat untuk memberikan pelayanan informasi yang semakin berkualitas bagi masyarakat.\\n\\n@humas_jabar\\n@humaskotabekasi\\n@pemkot_bekasi\\n@prokopimkotabekasi\\n@mastriadhianto\\n@harris.bobihoe\\n@zainal.abidin.syah\\n@fariedwajdi \\n@diskominfobekasi\",\"post_time\":1765782824,\"owner\":\"6820604156\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/6820604156/3787983340683999550_6820604156.jpg\"},{\"id\":\"DSJ7MeLkSrc\",\"image\":\"https://scontent-atl3-3.cdninstagra