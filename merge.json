ad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=lbE_lSP6aUQQ7kNvwGFuedh&_nc_oc=AdpcNi2EoF1qKrgcronU8gYrbb2R6D0BZfNI9R6MulgxYo8v5eVxeyGVcLruLeKnyqg&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=FEIBryalc6h-IcVXbF2aMQ&_nc_ss=7e6a8&oh=00_AQJqtxCzItxbS1XRVbC_TUdFIrHh2PJIX2ZGJDxDceagMw&oe=6AA6CCC7\",\"caption\":\"🏆🔥 KOTA BEKASI SIAP MENYAMBUT PORPROV XV JAWA BARAT 2026! 🔥🏆\\n\\nSemangat olahraga terus berkobar! 💪\\nKota Bekasi terus mempersiapkan berbagai sarana dan prasarana olahraga dalam menyambut pelaksanaan Pekan Olahraga Provinsi (PORPROV) XV Jawa Barat Tahun 2026.\\n\\nMulai dari Stadion Patriot Candrabhaga hingga berbagai fasilitas olahraga lainnya, semuanya menjadi bagian dari semangat bersama untuk menghadirkan penyelenggaraan olahraga yang berkualitas serta melahirkan prestasi-prestasi terbaik. ⚽🏀🏃‍♂️🏆\\n\\nPORPROV bukan hanya tentang pertandingan dan medali, tetapi juga tentang sportivitas, persatuan, semangat juang, dan kebanggaan untuk daerah.\\n\\nKelurahan Ciketingudik turut mendukung dan menyukseskan PORPROV XV Jawa Barat 2026 di Kota Bekasi. Mari bersama-sama memberikan dukungan terbaik bagi para atlet dan membawa semangat Bekasi Keren menuju prestasi yang membanggakan! 🔥💙💚\\nSukses PORPROV XV Jawa Barat 2026!\\n\\nKota Bekasi Siap, Atlet Berprestasi! 🏆✨\\n\\n#ENERGI PATRIOT, NYALAKAN KERENMU\\n\\n#PORPROVXVIJawaBarat2026 #PORPROVJabar #KotaBekasi #BekasiKeren\\n\\nJum'at, 4 September 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi\\n@diskominfobekasi\\n@prokopimkotabekasi\\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1788484181,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":8,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/Dc2LC_nBT_e.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938241204,\"id\":\"Dc0jwT0iFZt\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/792324029_2325054751657501_2613205219816819960_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=110&ig_cache_key=Mzk3Nzk2MTYyMjMyMDIwNzQ2OQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=xsSg9X3nQGEQ7kNvwGjwDjc&_nc_oc=AdpYIHaNW5s1x9fJxpFKR7KS4a4i-JRUMblUiEZqE5l2H8_mqMII3VjICINW8AsPaOE&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=FEIBryalc6h-IcVXbF2aMQ&_nc_ss=7e6a8&oh=00_AQI6cm2My5rJvyBR2Hl_CM0fBATqz3qxzckVicpfrv876w&oe=6AA6BF10\",\"caption\":\"♻️ Tindak Lanjut Aduan Masyarakat Terkait Pembuangan Sampah Liar\\n\\nLurah Ciketingudik mendampingi Bidang Penegakan Hukum (Gakum) Dinas Lingkungan Hidup Kota Bekasi bersama UPTD Lingkungan Hidup Kecamatan Bantargebang dalam kegiatan peninjauan dan tindak lanjut atas aduan masyarakat terkait keberadaan Tempat Pembuangan Sampah (TPS) liar di wilayah Kelurahan Ciketingudik.\\n\\nKegiatan ini merupakan bentuk respons dan komitmen Pemerintah Kota Bekasi dalam menjaga kebersihan, ketertiban, serta kelestarian lingkungan. Permasalahan pembuangan sampah liar memerlukan perhatian dan penanganan bersama agar tidak menimbulkan dampak negatif bagi masyarakat dan lingkungan sekitar.\\nMelalui koordinasi dan kolaborasi lintas perangkat daerah, diharapkan permasalahan tersebut dapat segera ditindaklanjuti sesuai dengan ketentuan yang berlaku.\\n\\nMari bersama-sama menjaga lingkungan dengan membuang sampah pada tempatnya dan tidak melakukan pembuangan sampah secara sembarangan. 🌱♻️\\n\\nKelurahan Ciketingudik Bersih, Nyaman, dan Berkelanjutan!\\n\\n#KelurahanCiketingudik #Ciketingudik #Bantargebang #KotaBekasi\\n\\nKamis, 3 September 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi\\n@diskominfobekasi\\n@prokopimkotabekasi\\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1788430057,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":9,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/Dc0jwT0iFZt.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938241204,\"id\":\"Dc0ao-MiIRo\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/790547428_1755147115693449_1126264803279419051_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=Mzk3NzkyMTUzNTY0NTYxNTIwOA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=cTaOtmRDO-EQ7kNvwHJORua&_nc_oc=Adp7PRAns_odzlmJsUkjlaLrIOaj0N70YjWWYEGnOlwOM8fOEtVwvUKnDEFAqOMfXO8&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=FEIBryalc6h-IcVXbF2aMQ&_nc_ss=7e6a8&oh=00_AQLBOONvOiKvXjY6Zx0LaR2LIvTYh1pWPspva7t3yCs4Ug&oe=6AA6C691\",\"caption\":\"KELURAHAN CIKETINGUDIK HADIR DALAM SOSIALISASI PERATURAN DAERAH\\n\\nDalam rangka mendukung upaya pencegahan dan pemberantasan penyalahgunaan serta peredaran gelap narkotika dan prekursor narkotika, Kasi Pemtrantibum Kelurahan Ciketingudik menghadiri kegiatan sosialisasi Peraturan Daerah yang diselenggarakan oleh Dinas Kesehatan, mewakili Bapak Lurah Ciketingudik.\\n\\nKegiatan ini menjadi bagian penting dalam memperkuat pemahaman, koordinasi, dan sinergi antar perangkat daerah serta seluruh pemangku kepentingan dalam upaya pencegahan penyalahgunaan narkotika di tengah masyarakat.\\n\\nMelalui kegiatan ini, diharapkan seluruh elemen dapat terus berperan aktif dalam menciptakan lingkungan yang aman, sehat, dan bebas dari penyalahgunaan serta peredaran gelap narkotika.\\n\\nMari bersama-sama membangun kesadaran dan kepedulian untuk melindungi generasi masa kini dan masa depan dari bahaya narkotika.\\n\\nBersama Kita Wujudkan Masyarakat yang Sehat, Aman, dan Bebas Narkotika! 💪🇮🇩\\n\\n#KelurahanCiketingudik #Ciketingudik #Bantargebang #KotaBekasi\\n\\nKamis, 3 September 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi\\n@diskominfobekasi\\n@prokopimkotabekasi\\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1788425244,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":5,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/Dc0ao-MiIRo.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"Dc0aatNiuky\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/793000429_941957874978411_8003284001438927139_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=110&ig_cache_key=Mzk3NzkyMDU1NTMzNjI2Mzk4Ng%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=yWLv-KDkCNkQ7kNvwFkrpb4&_nc_oc=AdqKR_RzZ3KwrS3HmuzcB20ut8xKN3C7o9SSAmndDIdGS3u44t7xiT48GICP5eTTsFA&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQJYTtDETyKquecp5-BiuFyotgSrLQijDQAZDBkBUN8PvA&oe=6AA6D881\",\"caption\":\"🏢 RAPAT PERSIAPAN DAN SURVEI LOKASI PENGADAAN LAHAN SEKRETARIAT RW 001\\n\\nDalam rangka mendukung penyediaan sarana dan prasarana pelayanan serta kegiatan kemasyarakatan, telah dilaksanakan Rapat Persiapan dan Survei Lokasi Kegiatan Pengadaan Lahan Kantor Sekretariat RW 001 Kelurahan Ciketingudik, Kecamatan Bantargebang, Kota Bekasi.\\n\\nKegiatan rapat dilaksanakan di Ruang Rapat Bidang Pertanahan Dinas Perumahan, Kawasan Permukiman dan Pertanahan Kota Bekasi sebagai bagian dari tahapan koordinasi dan persiapan sebelum pelaksanaan survei lokasi.\\n\\nMelalui kegiatan ini, diharapkan proses pengadaan lahan dapat berjalan secara terencana, tertib, dan sesuai dengan ketentuan yang berlaku, sehingga keberadaan Kantor Sekretariat RW 001 nantinya dapat memberikan manfaat dalam menunjang pelayanan dan aktivitas masyarakat.\\n\\n🤝 Kolaborasi dan sinergi untuk pembangunan serta pelayanan masyarakat yang lebih baik.\\n\\n#KelurahanCiketingudik #KecamatanBantargebang #KotaBekasi\\n\\nKamis, 3 September 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi\\n@diskominfobekasi\\n@prokopimkotabekasi\\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1788425133,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":5,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/Dc0aatNiuky.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"DczQM7KzQkC\",\"image\":\"https://scontent-lhr6-1.cdninstagram.com/v/t51.71878-15/793595121_1383044030616204_116061413379869178_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=108&ig_cache_key=Mzk3NzU5NDE1MjgwODE1NTM5NA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=IOYnAOH_l8UQ7kNvwElsYfW&_nc_oc=AdqEsTQIkdJaafqAIIhR1o_sWRHEb5HBbmtYhB15JERumNJPcDReB4WTDcwV2w6npyQ&_nc_zt=23&_nc_ht=scontent-lhr6-1.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQJaSZGGV06GmyfgIxKmqDWy2I-2YCG6qrpVQVcsUzCYdw&oe=6AA6E264\",\"caption\":\"​🔥 BERSAMA KITA SUKSESKAN PORPROV XV JAWA BARAT 2026 DI KOTA BEKASI! 🔥\\n\\n​Kota Bekasi siap menjadi tuan rumah yang membanggakan! Kelurahan Ciketingudik, Kecamatan Bantargebang, mendukung penuh penyelenggaraan Pekan Olahraga Provinsi (PORPROV) XV Jawa Barat 2026.\\n\\n​Mari kobarkan semangat kebersamaan dan tunjukkan dukungan terbaik kita melalui 4 komitmen utama:\\n\\n​* Berikan energi positif bagi para putra-putri terbaik Jawa Barat.\\n​* Utamakan kejujuran dan fair play di setiap cabang olahraga.\\n​* Ciptakan PORPROV yang meriah, aman, dan sukses.\\n​* Tunjukkan keramahan dan kesiapan Kota Bekasi menyambut para kontingen.\\n\\n​\\\"Semangat Sportivitas, Bersatu untuk Prestasi, Bangga untuk Kota Bekasi!\\\"\\n\\nENERGI PATRIOT, NYALAKAN KERENMU!!!\\n\\n​📍 Kelurahan Ciketingudik, Kecamatan Bantargebang, Kota Bekasi\\n\\n​#PorprovJabar2026 #KotaBekasi #KelurahanCiketingudik #Bantargebang\\n\\nKamis, 3 September 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi\\n@diskominfobekasi\\n@prokopimkotabekasi\\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1788386244,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":10,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DczQM7KzQkC.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"DcybMKUCjxV\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/791974176_4515596658757727_8613649596447668100_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=104&ig_cache_key=Mzk3NzM2MTAwMzg4NDcyMzI4NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=lxG4r3-oL5wQ7kNvwEc7mvl&_nc_oc=AdrkFLojzD2gnNzC1tk1IJqcyc38_GI2ffAKnyIANWptkR6QE7GLqAcQn8DrrZy5M0A&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQK_2gmZCxsaiEgBJgtQxobBO7YhBlpDHmN4TK6OIoLoJQ&oe=6AA6C892\",\"caption\":\"🏗️ MONITORING KEGIATAN SARPRAS DAN RUTILAHU\\n\\nLurah Ciketingudik melaksanakan kegiatan monitoring pelaksanaan Sarana dan Prasarana (Sarpras) serta Rumah Tidak Layak Huni (Rutilahu) di wilayah RW 004 Kelurahan Ciketingudik.\\n\\nKegiatan monitoring ini dilakukan sebagai bagian dari upaya memastikan pelaksanaan program pembangunan dapat berjalan dengan baik, sesuai dengan perencanaan, serta memberikan manfaat bagi masyarakat.\\n\\nTurut hadir dalam kegiatan tersebut Bidang Pembangunan, Kasi Permas Kecamatan Bantargebang, Kasi Permasbang Kelurahan Ciketingudik, staf kecamatan serta Ketua BKM.\\n\\nMelalui kegiatan monitoring ini, diharapkan sinergi dan koordinasi antara pemerintah serta unsur masyarakat dapat terus terjalin dalam mendukung pembangunan wilayah dan meningkatkan kualitas lingkungan serta kesejahteraan masyarakat.\\n\\nBersama membangun wilayah, mewujudkan Ciketingudik yang semakin baik. 🤝🏘️\\n\\n#KelurahanCiketingudik #KecamatanBantargebang #KotaBekasi\\n\\nRabu, 2 September 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1788358434,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":11,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcybMKUCjxV.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"DcsSU3aipLy\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/791844614_1105317911921277_5573990537148048928_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=104&ig_cache_key=Mzk3NTYzMzE2OTc4OTEyOTQ1OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=nDkUpTBVLWIQ7kNvwFlz6DI&_nc_oc=AdpW6POnuP9AUcQjFZLWIzUtYumDyjc56V2zEF0A2teG_0sNS9C_IWfJOsUKy0YrPkg&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQJWuGSI41ChKI-8ULhaeL0UNQPRW2FcBqMojc7EXsF7eQ&oe=6AA6E2E7\",\"caption\":\"✨ PESONA NUSANTARA BEKASI KEREN ✨\\n\\nLurah bersama aparatur Kelurahan serta para Ketua RT dan RW turut hadir dan berpartisipasi dalam kegiatan Pesona Nusantara Bekasi Keren.\\n\\nKegiatan ini menjadi wujud semangat kebersamaan dalam merayakan keberagaman budaya, mempererat silaturahmi, serta menumbuhkan rasa bangga terhadap kekayaan budaya Nusantara. 🇮🇩✨\\n\\nMelalui kebersamaan dan kolaborasi seluruh elemen masyarakat, mari bersama-sama terus menjaga persatuan serta menjadikan Kota Bekasi semakin Keren, Berbudaya, dan Membanggakan.\\n\\nBekasi Keren, Nusantara Bersatu! 🇮🇩❤️\\n\\n#PesonaNusantara #BekasiKeren #KotaBekasi #KebudayaanNusantara\\n \\nSenin, 31 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1788152475,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":17,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcsSU3aipLy.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"DcnvcKZCgCF\",\"image\":\"https://scontent-lhr6-2.cdninstagram.com/v/t51.82787-15/786065665_18152545039508742_3126399203866902178_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=105&ig_cache_key=Mzk3NDM1MzgzOTY2NjYyNjY5MzE4MTUyNTQ1MDMzNTA4NzQy.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=TqE02-xXvyAQ7kNvwFnJ7Sp&_nc_oc=AdoB-UESUyB_KK2D409R8i3D8FHT0Gdw90G8uXQt5Dr0CIW20WihD59WI1oZRd2dwpI&_nc_zt=23&_nc_ht=scontent-lhr6-2.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQIkSBvBsx4pmZQOGhgYxJ089Gp1bM3o39PSDHmlDYuzKQ&oe=6AA6DCDC\",\"caption\":\"RESPONS DAN KEPEDULIAN UNTUK WARGA 🤝\\n\\nMenindaklanjuti keluhan warga yang disampaikan melalui DM Instagram Wali Kota Bekasi, Bapak Lurah Ciketingudik bersama Ketua RT 001 RW 007 segera melakukan tindak lanjut dengan mengunjungi langsung kediaman warga.\\n\\nDalam kunjungan tersebut, dilakukan komunikasi dan pendataan untuk mengetahui secara langsung kondisi serta kebutuhan warga yang menyampaikan keluhan, khususnya terkait kebutuhan keluarga dan kesejahteraan.\\n\\nSebagai bentuk kepedulian pribadi, Bapak Lurah turut menyampaikan sedikit bantuan yang diharapkan dapat membantu dan meringankan kebutuhan warga beserta keluarganya.\\n\\nSemoga perhatian dan kepedulian ini dapat memberikan manfaat serta menjadi penguat bagi warga yang sedang menghadapi kesulitan. Pemerintah akan terus berupaya hadir, mendengarkan, dan menindaklanjuti aspirasi masyarakat dengan sebaik-baiknya.\\n\\nKarena setiap keluhan warga adalah perhatian, dan setiap perhatian adalah bagian dari pelayanan kepada masyarakat. 🙏\\n\\n#KelurahanCiketingudik #KecamatanBantargebang #KotaBekasi #PeduliWarga #PelayananMasyarakat\\n\\n \\nSabtu, 29 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1788000112,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":12,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcnvcKZCgCF.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"Dci1118C5Jm\",\"image\":\"https://scontent-lhr6-1.cdninstagram.com/v/t51.71878-15/788230758_1762838068398625_2570932314280929585_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=102&ig_cache_key=Mzk3Mjk3NDYxNzgwNzI2MjMxMDEwMzcxNjExNTU4NjE5OTQ%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=XOIPxZDPt1EQ7kNvwEpuOQh&_nc_oc=Adoh34ONv_I5xgK-SVSDDeCA3kuUcaOwW6CU_TxPnF0QkUam_Kd4JQ9YWf9TrmNSSWE&_nc_zt=23&_nc_ht=scontent-lhr6-1.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQInGdtIb-dvVqEP6hS5TQB-4P_5wRGwpZ8ZyHZH1Ubt4g&oe=6AA6D7FC\",\"caption\":\"Bagaimana jika sampah yang selama ini kita anggap sebagai masalah… bisa menjadi energi untuk masa depan? ♻️⚡\\n\\nHari ini menjadi sebuah langkah penting menuju perubahan.\\n\\nMelalui Ground Breaking Pengolahan Sampah Menjadi Energi Listrik (PSEL), kita memulai perjalanan menuju sistem pengelolaan sampah yang lebih modern, inovatif, dan berkelanjutan.\\n\\nPSEL bukan hanya tentang mengelola sampah. Lebih dari itu, ini adalah bagian dari upaya menghadirkan solusi bagi lingkungan, memberikan nilai tambah dari sampah, mendukung energi, serta mewujudkan masa depan kota yang lebih bersih.\\n\\n🤝 Bersama pemerintah, stakeholder, dan seluruh elemen masyarakat, mari kita jadikan momentum ini sebagai awal dari sebuah perubahan besar.\\n\\nDARI SAMPAH MENJADI ENERGI.\\nDARI MASALAH MENJADI SOLUSI.\\nUNTUK BEKASI YANG LEBIH BERSIH DAN BERKELANJUTAN. 🌱🏙️⚡\\n\\n✨ Ini bukan akhir dari permasalahan sampah. Ini adalah awal dari solusi.\\n\\n#GroundBreakingPSEL #PSEL #DariSampahMenjadiEnergi #KotaBekasi #Ciketingudik\\n \\nJum'at, 27 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1787841439,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":10,\"like_count\":47,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/Dci1118C5Jm.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"DcgYIimyrxa\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/788414074_2632603670532056_4282276243931536621_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=110&ig_cache_key=Mzk3MjI4MTAxMTM3MDkwMDU3MDEwNzI5NjgwMjIzNjIzNjc%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=uoVltxtzU8AQ7kNvwFEIGiz&_nc_oc=AdpKZwi05WIkHJnVjhhL08ed9BAokMQ34tn_JDE7KUnmJY5xz8XYFEuaeXVibdHH3Xk&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQID0qkaV5YMJL2oB1QGeKxh828IHirS9Hv-0MsEG3CMcQ&oe=6AA6C01F\",\"caption\":\"APEL GEBRAK – RANGKAIAN GROUNDBREAKING PSEL KOTA BEKASI\\n\\nTelah dilaksanakan Apel Gebrak (Gerakan Energi Bersih, Reduksi Sampah, Aksi Pilah, Kolaborasi Inovatif) sebagai bagian dari rangkaian kegiatan Peresmian Pembangunan Pengolahan Sampah Menjadi Energi Listrik (PSEL) Kota Bekasi, dengan mengusung semangat “Menuju Indonesia Bersih dan ASRI.”\\nKegiatan dilaksanakan pada:\\n\\n📅 Rabu, 26 Agustus 2026\\n⏰ Pukul 09.00 WIB s.d. selesai\\n📍 Polder Ciketingudik, RT 001/RW 003, Kecamatan Bantargebang, Kota Bekasi\\n\\nApel Gebrak menjadi momentum untuk memperkuat komitmen bersama dalam mewujudkan pengelolaan sampah yang lebih bersih, terpilah, berkelanjutan, dan memberikan manfaat bagi masyarakat.\\n\\nKegiatan ini merupakan bagian dari rangkaian Groundbreaking PSEL Kota Bekasi, yang dilanjutkan dengan peninjauan maket dan informasi proyek, pembukaan acara, penayangan video transformasi pengelolaan sampah Indonesia, laporan dan sambutan, proses penandatanganan kerja sama, arahan pimpinan, hingga prosesi peresmian pembangunan proyek PSEL Bekasi dan foto bersama.\\n\\nMelalui sinergi pemerintah, masyarakat, dunia usaha, dan seluruh pemangku kepentingan, diharapkan PSEL dapat menjadi salah satu langkah inovatif dalam mengatasi persoalan sampah sekaligus mendukung pemanfaatan sampah menjadi energi listrik.\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@achmadshovie007 \\n@ventus1208 \\n@pemkot_bekasi \\n@prokopim.kotabekasi \\n@diskominfobekasi\",\"post_time\":1787753364,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":1,\"like_count\":117,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcgYIimyrxa.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"Dcdx_H3TE47\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/785776051_18412865707159744_3595822083162322026_n.heic?stp=dst-jpg_e35_tt6&_nc_cat=101&ig_cache_key=Mzk3MTU1MDI4ODQ2MDY2NDM3OQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=XMgY5xyyOTUQ7kNvwG_4FR1&_nc_oc=Adq1VOkXvZmGK5P3_MpDABeF-4fILcja5qf3PPK0xdS88ZxFbmDSlkven2Dgj1h8IzM&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQLKc5tv2eZxVZWrxSUdO0R45AMGYsRUuZoihB4cH5EVbw&oe=6AA6C24A\",\"caption\":\"Mari bersama-sama dukung langkah Kota Bekasi menuju masa depan yang lebih bersih, hijau, dan berkelanjutan! 🌱⚡\\n\\nPembangunan **Pengolahan Sampah menjadi Energi Listrik (PSEL) Kota Bekasi** menjadi langkah nyata dalam menghadirkan pengelolaan sampah yang lebih baik.\\n\\n📢 **Ayo, warga Kota Bekasi!**\\nMari bersama mendukung pembangunan PSEL dan membangun kesadaran untuk mengelola sampah dengan lebih bijak. Mulai dari diri sendiri, mulai dari lingkungan sekitar, demi Kota Bekasi yang lebih bersih dan masa depan yang lebih baik untuk generasi mendatang.\\n\\n🗓️ **26 Agustus 2026**\\n⏰ **08.00 WIB – selesai**\\n📍 **Ciketing Udik, Kecamatan Bantargebang, Kota Bekasi**\\n\\n▶️ Saksikan juga melalui **Live Streaming YouTube Pemerintah Kota Bekasi**.\\n\\n**Bersama membangun Kota Bekasi yang lebih bersih, hijau, dan berkelanjutan!**\\n\\n#BekasiMakinKeren #PSELKotaBekasi #KotaBekasi #Bantargebang #CiketingUdik\",\"post_time\":1787665713,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":4,\"like_count\":371,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/Dcdx_H3TE47.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"DcazIJICpcD\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/784004040_934066185755336_3231685552414619160_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=104&ig_cache_key=Mzk3MDcxMDg4MTQwNjk4MTg5MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=D085vHXoLYYQ7kNvwELL5E3&_nc_oc=AdpxWjftDdBXqzqO6LvlF5NQIjNYvXxURWzIK2nHBaopx7HUjQFUhDsnhyyviYTsqRg&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQIUjtBnHSE9xBJc6_6GOLSNJjBAi2jwmRnRly7C9OaUuw&oe=6AA6D221\",\"caption\":\"♻️ APEL GEBRAK CIKETINGUDIK ♻️\\n\\nGerakan Energi Bersih, Reduksi Sampah, Aksi Pilah, Kolaborasi Inovatif\\n\\nWarga Ciketingudik yang kami banggakan!\\n\\nSebagai rangkaian dari Groundbreaking Pengolahan Sampah menjadi Energi Listrik (PSEL) - Peletakan Batu Pertama Fasilitas PSEL Ciketingudik, solusi inovatif sampah menuju Bekasi Mandiri Energi, Kelurahan Ciketingudik akan melaksanakan:\\n\\nAPEL GEBRAK\\nMari kita wujudkan lingkungan bersih melalui 5 gerakan:\\n1️⃣ BERSIHKAN lingkungan rumah & fasilitas umum\\n2️⃣ PILAH SAMPAH organik, anorganik & residu\\n3️⃣ GOTONG ROYONG untuk lingkungan sehat\\n4️⃣ JAGA SALURAN & drainase bebas sampah\\n5️⃣ RAWAT LINGKUNGAN agar hijau & nyaman\\n\\n📅 Hari: Rabu, 26 Agustus 2026\\n⏰ Pukul: 06.00 WIB s.d Selesai\\n📍 Tempat: Wilayah RW 001 s.d RW 009 Kelurahan Ciketingudik\\n\\nKegiatan ini akan dihadiri oleh Wali Kota Bekasi, Wakil Wali Kota Bekasi, Camat Bantargebang, dan Lurah Ciketingudik.\\n\\nLingkungan Bersih, Warga Sehat!\\nMari bersama-sama mewujudkan Ciketingudik Bersih, Sehat, dan Maju!\\n\\n#ApelGEBRAK #CiketingudikBersih #Bantargebang #KotaBekasi #PSELBekasi BekasiMandiriEnergi GotongRoyong PilapSampah EnergiBersih KelurahanCiketingudik GroundbreakingPSEL\\n\\nSenin, 24Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1787565679,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":12,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcazIJICpcD.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"DcU8h-_CkOi\",\"image\":\"https://scontent-lhr6-2.cdninstagram.com/v/t51.82787-15/780949590_18151791289508742_4226680661830122985_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=109&ig_cache_key=Mzk2OTA2MzM4OTc4MzI3ODQ5OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=40apJuqNemYQ7kNvwHN5iWs&_nc_oc=AdrUCtnr0b_nruhbIQIfKYuMkfsWyO0BnQxQsAzZv0QD-uSnJRScje46s0xC7Y_rLtU&_nc_zt=23&_nc_ht=scontent-lhr6-2.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQKOxWviytCOeomwssQ93QpC2BXSorH0ZTyxHhqiflF9Hw&oe=6AA6DA2D\",\"caption\":\"​Semangat Gotong Royong! Persiapan Ground Breaking di Ciketing Udik 🏗️✨\\n\\n​Halo Warga Ciketing Udik! 👋\\n\\n​Pagi ini, semangat kebersamaan mewarnai lingkungan kita. Dalam rangka menyambut acara Ground Breaking (Peletakan Batu Pertama) yang akan segera dilaksanakan, Bapak Lurah Ciketing Udik turun langsung memimpin kegiatan K3 (Kebersihan, Ketertiban, dan Keindahan).\\n\\n​Kegiatan ini melibatkan sinergi dari:\\n✅ Seluruh jajaran Aparatur Kelurahan Ciketing Udik\\n✅ Anggota Satlinmas yang selalu siaga\\n\\n​Mengapa K3 ini penting?\\n\\nSelain untuk memastikan lokasi acara Ground Breaking nanti bersih, rapi, dan nyaman, kegiatan ini adalah bentuk komitmen nyata kami dalam menjaga dan merawat lingkungan Ciketing Udik agar selalu asri. Sinergi ini juga menjadi cerminan nilai-nilai pelayanan prima dari aparatur untuk masyarakat.\\n\\n​Terima kasih kepada seluruh aparatur dan Satlinmas yang sudah berkeringat dan bekerja keras hari ini. Kinerja hebat untuk lingkungan yang lebih baik! 💪🔥\\n​Yuk, Warga Ciketing Udik, kita dukung terus program pembangunan di wilayah kita dan mulai dari diri sendiri untuk selalu menjaga kebersihan lingkungan!\\n​Ada yang tadi pagi melihat bapak-bapak dan ibu-ibu kita sedang bersih-bersih? Coba absen di kolom komentar ya! 👇😊\\n\\n​#KelurahanCiketingUdik #Bantargebang #KotaBekasi #K3CiketingUdik\\n\\nSabtu, 22 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1787369318,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":9,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcU8h-_CkOi.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"DcUn-poBjQg\",\"image\":\"https://scontent-lhr6-2.cdninstagram.com/v/t51.71878-15/779957696_1567797861467296_5696660719400305835_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=109&ig_cache_key=Mzk2ODk3MzAwMDczNjY1MDI3Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=SBSs-nhkumoQ7kNvwFlzJv7&_nc_oc=AdpfsKnNSk5bEw-cmEMqL1zYnQpGNsS3X6M0wOuZBFxZtTU3uJ2IJRjvPaU8DJslF6s&_nc_zt=23&_nc_ht=scontent-lhr6-2.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQKLWpgRRZp-nAond53sFOJUwBde5rcsxGuajvpGtR48DQ&oe=6AA6D6D6\",\"caption\":\"*NANTIKAN! RIDHO BERPECI SPECIAL EDITION!*\\n\\nKali ini RIDHO BERPECI mempersembahkan edisi spesial bertemakan: *_Soft Launching Aplikasi SICANTIK_ - Kemudahan Administrasi Terpadu Keluarga*.\\n\\nDi episode kali ini, spesial akan diluncurkan *Aplikasi SICANTIK: Sistem Catatan Administrasi dan Nilai Terpadu Informasi Keluarga* yang diinisiasi oleh Dinas Pemberdayaan Perempuan dan Perlindungan Anak (DPPPA) Kota Bekasi bersama TP. PKK Kota Bekasi. \\n\\nApa itu Aplikasi SICANTIK? di RIDHO BERPECI SPECIAL EDITION akan lengkap dijelaskan oleh para narasumber, yakni Ridwan AS, S.H, M.Si selaku kepala DPPPA Kota Bekasi, Wiwiek Hargono Tri Adhinato selaku Ketua TP. PKK Kota Bekasi, dan Paras Sujiwo, S.Si, M.M yang akan tayang pada: \\n\\n🗓️Minggu, 23 Agustus 2026\\n🕣15.30 s.d 17.00 WIB\\nTayang melalui Live Streaming YouTube Pemerintah Kota Bekasi dan melalui Zoom Meeting.\\n\\nYuk! Catat tanggalnya dan ikut serta dalam RIDHO BERPECI: RIDHO bersama untuk pecahkan masalah dan mencari solusi.\\n\\n#kotabekasi \\n#kotapatriot \\n#kotabekasikeren \\n#bekasikerenmenujukotaglobal \\n#ridhoberpeci\\n\\nSabtu, 22 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1787358495,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":4,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcUn-poBjQg.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788938247263,\"id\":\"DcS75MjirgD\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/780201759_18151713076508742_8296426721406947063_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=Mzk2ODQ5NzYzNjkwMjM1Mjg5OQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=2lc45wzbTFoQ7kNvwFZqngM&_nc_oc=AdpdpAAL14qR1iyx0uSZ0yYOPNRxqK6lScJOgXM2VzpqYkMG7Fiqoze12Gx1Nq2TxFM&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=4xRVWSiGFkugz7i6DiAmfw&_nc_ss=7e6a8&oh=00_AQJzzVzQgL_kK9cBJ_Q_i4dBmo3aPm6lkgR11a3NUkMNpA&oe=6AA6E03F\",\"caption\":\"PENYALURAN BANSOS MUB CIKETINGUDIK 🤝✨\\n\\nSekretaris Kelurahan bersama Kasi Kesos menghadiri kegiatan Penyaluran Bantuan Sosial yang diselenggarakan oleh MUB Kelurahan Ciketingudik untuk warga penerima manfaat.\\n\\nPenyaluran bantuan ini diserahkan secara langsung dan tepat sasaran kepada warga yang telah ditetapkan sesuai dengan verifikasi data serta ketentuan yang berlaku.\\n\\nSinergi antara pihak kelurahan dan MUB ini diharapkan dapat memberikan dampak positif nyata serta meringankan beban kebutuhan masyarakat yang membutuhkan. Terima kasih kepada seluruh pihak yang telah mengawal jalannya acara hingga tertib dan lancar! 🌿\\n\\n📍 Lokasi: Kelurahan Ciketingudik\\n\\n👥 Kehadiran: Sekel, Kasi Kesos, & Pengurus MUB Kelurahan Ciketingudik\\n\\n#MUB #MUBCiketingudik #PenyaluranBansos #BantuanSosial\\n\\nJum'at, 21 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1787301830,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":7,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcS75MjirgD.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788957741599,\"id\":\"DdDISsxS2sL\",\"image\":\"https://scontent-iad3-2.cdninstagram.com/v/t51.71878-15/801395673_2160669711146352_2493421416571175561_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=103&ig_cache_key=Mzk4MjA2Mjk2NDkxOTk4Njk1NTEwNDQwMjkyMTE4MzgxMjA%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=PGBtYD7oz9cQ7kNvwEi4Gpg&_nc_oc=AdrAXOP3OvHgxpbgcGUG3AmZ-V3ylVuPbvIfVfLtjIxfHJKGcC3xVT1F9EVJktZg7jY&_nc_zt=23&_nc_ht=scontent-iad3-2.cdninstagram.com&_nc_gid=E2Vmo6LbO92_bL_4nnHEUQ&_nc_ss=7e6a8&oh=00_AQJthq0rCucxky3sEg60MrmzSf4RdLjroEg6XC4tp12Sxw&oe=6AA71DB0\",\"caption\":\"Abu Vulkanik sampai ke Bantargebang!\\n\\nSebagai Langkah Cepat dalam Penanganan Dampak Abu Vulkanik Gunung Anak Krakatau, Sekretaris Kecamatan Bantargebang, Disdamkarmat Sektor Vida, Unsur TNI (Yon Armed), Polsek Bantargebang, Satpol PP dan Perangkat Terkait Lainnya Bergerak Melakukan Penyemprotan \\nSerta Pembersihan Ruas Jalan di Wilayah Kecamatan Bantargebang.\\n\\nLangkah ini dilakukan Untuk Mengurangi Debu dan Sisa Abu Vulkanik, Menjaga Kebersihan Serta Kondisi jalan, Sekaligus Memastikan Keamanan dan Kenyamanan Masyarakat dalam Beraktivitas.\\n\\nKeselamatan adalah Tanggung Jawab Kita Bersama.\\nTetap Tenang, Waspada, dan Selalu Perbarui Informasi Melalui Kanal Resmi Pemerintah\\n\\n@mastriadhianto\\n@harris.bobihoe\\n@achmadshovie007 \\n@ventus1208\\n@pemkot_bekasi\\n@prokopim.kotabekasi\\n@diskominfobekasi\\n@disdamkarmatkotabekasi.id \\n@satpolppkotabks \\n@dishubbekasikota \\n@uptdllapbtg\",\"post_time\":1788919122,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":1,\"like_count\":43,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DdDISsxS2sL.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788973395481,\"id\":\"DdEds9CiDVa\",\"image\":\"https://scontent-hkg1-2.cdninstagram.com/v/t51.71878-15/801786230_1893788524919251_2934581396159942477_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=107&ig_cache_key=Mzk4MjQzODYwMzA0ODg5MTczOA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=PtDV-7uMfIMQ7kNvwEZdErl&_nc_oc=Ado1g7T0XZxTPk7p_XVMswVhQyM7mhvaDvO9-7gOoSklvc64gEXNu7-Pgk6BRTzkWqk&_nc_zt=23&_nc_ht=scontent-hkg1-2.cdninstagram.com&_nc_gid=TEeUZR4nGBmVKHZbrZpVeQ&_nc_ss=7e6a8&oh=00_AQLUxMTV25ct5L6cQL9fyMMG3qykjj7vuNESMpVT1rz0Xw&oe=6AA74DF6\",\"caption\":\"🚫 STOP GRATIFIKASI! 🚫\\n\\nTahukah kamu? \\nGratifikasi adalah pemberian dalam bentuk apapun — uang, barang, parcel, diskon, fasilitas, hingga traktiran — yang diberikan kepada penyelenggara negara karena jabatannya. Dan itu termasuk KORUPSI! \\n\\nDi Kelurahan Ciketing Udik, kami berkomitmen:\\n✅ Pelayanan GRATIS sesuai aturan\\n✅ Tanpa pungli\\n✅ Tanpa \\\"uang terima kasih\\\"\\n✅ Transparan & Akuntabel\\n\\nMari jadi bagian dari gerakan #BeraniJujurHebat !\\nJangan memberi, jangan menerima, dan berani melaporkan jika menemukan praktik gratifikasi.\\n\\nPelayanan bersih, warga bahagia. 🤝\\n\\nBersama @official.kpk \\nBersama Pariwara Antikorupsi\\n\\n---\\n📍 Kelurahan Ciketing Udik - Bantargebang - Kota Bekasi\\n📢 Laporkan gratifikasi melalui kanal pengaduan resmi atau hubungi kami via DM\\n\\n#StopGratifikasi #AntiKorupsi #TolakGratifikasi #kpkri \\nRabu, 9 September 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi\\n@diskominfobekasi\\n@prokopimkotabekasi\\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1788963725,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":4,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DdEds9CiDVa.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788973399016,\"id\":\"DcS3jGMCsyK\",\"image\":\"https://scontent-hkg4-2.cdninstagram.com/v/t51.82787-15/780456743_18151709722508742_9107475427864588090_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=Mzk2ODQ3ODUyNjA1MTExMDAyNg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=Y5Uc3VCF9HcQ7kNvwF064pz&_nc_oc=AdrhxJ47LknZGNqM303ePi2Qd0OYMDGcPvPbULIK82s_FMTt31_hDc9DHRz7JJg4EW8&_nc_zt=23&_nc_ht=scontent-hkg4-2.cdninstagram.com&_nc_gid=lMPIAV1K2DaLjkbY7ihbCQ&_nc_ss=7e6a8&oh=00_AQJTZdFym32fjwRPWlTv-W0qu3LQ9lNdHCytQ-GNHmDfAw&oe=6AA759BC\",\"caption\":\"TINDAK LANJUT PEMBAKARAN SAMPAI ILEGAL 🚫🔥\\n\\nMerespons keluhan warga Perumahan Srimaya Summarecon terkait aktivitas pembakaran sampah yang mengganggu kenyamanan dan kualitas udara, Lurah bersama tim UPTD Lingkungan Hidup (LH) langsung turun ke lokasi untuk melakukan peninjauan dan penanganan lapangan.\\n\\nLangkah ini diambil sebagai bentuk komitmen dalam menjaga kebersihan lingkungan, kesehatan masyarakat, serta menegakkan aturan larangan membuang dan membakar sampah sembarangan.\\n\\nMari saling menjaga kenyamanan bersama dengan tidak membakar sampah dan mengelola limbah rumah tangga secara bijak. Lingkungan sehat, warga tenang! 🍃\\n📍 Lokasi: Area Perumahan Srimaya Summarecon & Sekitarnya\\n\\n🤝 Pelaksana: Lurah & Tim UPTD Lingkungan Hidup\\n\\n#ResponCepat #LingkunganHidup #StopBakarSampah #Bantargebang\\n\\nJum'at, 21 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\",\"post_time\":1787299553,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":7,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcS3jGMCsyK.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788973399016,\"id\":\"DcSziSRCQ2Z\",\"image\":\"https://scontent-hkg4-1.cdninstagram.com/v/t51.82787-15/783424086_18151709782508742_3940091524147922314_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk2ODQ2MDg3ODExNDI2MjQyNTE4MTUxNzA5Nzc5NTA4NzQy.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=ES1mMnn81CEQ7kNvwH3Zwfd&_nc_oc=Adq3oAq4QQiECY5BCUK24a_U-XXtzjwCRNMwA-VYr27qoS8ndRI4g3yOfWfeka1j_GU&_nc_zt=23&_nc_ht=scontent-hkg4-1.cdninstagram.com&_nc_gid=lMPIAV1K2DaLjkbY7ihbCQ&_nc_ss=7e6a8&oh=00_AQIUSlucYBGL2MWARUP-L0oxWwYLfO4hHMYFCoxoPiJZGA&oe=6AA75B0B\",\"caption\":\"Mendukung pengembangan potensi atlet lokal, Lurah Ciketingudik mendampingi Camat Bantargebang dalam pembukaan Turnamen Olahraga Floorball yang berlangsung di Lapangan GOR Bumen Jaya, Kelurahan Ciketingudik.\\n\\nAjang olahraga ini diselenggarakan sebagai langkah strategis serta persiapan matang menyambut gelaran Pekan Olahraga Provinsi (Porprov) Jawa Barat XV di mana Kota Bekasi akan menjadi tuan rumah.\\n\\nDukungan penuh terus diberikan demi melahirkan atlet-atlet berbakat yang siap mengharumkan nama wilayah di tingkat provinsi! 🏆🔥\\n\\nDetail Kegiatan:\\n📍 Lokasi: Lapangan GOR Bumen Jaya, Kelurahan Ciketingudik\\n🏆 Agenda: Pembukaan Turnamen Olahraga Floorball (Ajang Persiapan Porprov Jabar XV)\\n\\n#Ciketingudik #Bantargebang #KotaBekasi #Floorball #PorprovJabarXV\\n\\nJum'at, 21 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\",\"post_time\":1787297451,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":4,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcSziSRCQ2Z.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788973399016,\"id\":\"DcQmZ7ACWUh\",\"image\":\"https://scontent-hkg4-2.cdninstagram.com/v/t51.82787-15/776714748_18151628896508742_5762965322864366686_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=Mzk2Nzg0MDE3ODgxOTEzMDY1NzE4MTUxNjI4ODkwNTA4NzQy.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=yZDXe6AqnOYQ7kNvwGToP9p&_nc_oc=AdolevUc3nkxIgSElbdbJ_ATidsQE19VYsq2OYjq7SOv5eidFpM2t0mP1fmCOdt5FdQ&_nc_zt=23&_nc_ht=scontent-hkg4-2.cdninstagram.com&_nc_gid=lMPIAV1K2DaLjkbY7ihbCQ&_nc_ss=7e6a8&oh=00_AQJQMgF7gUuVTsDojKXFjmHYTk4FRDDFUg9pDy-WditLxg&oe=6AA775E7\",\"caption\":\"🥊 Sinergi Penuh Persiapan Cabor Tinju PORPROV XV JABAR 2026!\\n\\n​Semangat persiapan menyambut pesta olahraga terbesar di Jawa Barat terus dikobarkan! \\nPemerintah setempat terus bergerak cepat untuk memastikan kesiapan Kota Bekasi sebagai tuan rumah yang membanggakan.\\n\\n​Langkah konkret kembali dilakukan hari ini melalui peninjauan langsung dan koordinasi intensif. \\n\\nCamat Bantargebang bersama Lurah Ciketingudik, serta didampingi oleh Ketua BKM Ciketing Udik, telah melangsungkan pertemuan penting dengan jajaran Dispora Jawa Barat.\\n\\nFokus Agenda Pertemuan & Peninjauan:\\n\\n​1. Membahas persiapan menyeluruh terkait kelancaran pelaksanaan perlombaan cabang olahraga (cabor) tinju.\\n​2. Melakukan peninjauan langsung ke GOR Bumen Jaya untuk memastikan kesiapan fasilitas, ring, dan infrastruktur pendukung agar sesuai dengan standar pertandingan.\\n​3. Memperkuat sinergi antara Pemerintah Kecamatan, Kelurahan, pengurus BKM, dan Dispora Provinsi demi menyukseskan gelaran acara tanpa hambatan.\\n\\n​Dukungan penuh dari aparatur Kelurahan Ciketing Udik dan Kecamatan Bantargebang ini adalah bukti nyata komitmen bersama untuk menyukseskan PORPROV XV Jabar 2026 di Kota Bekasi. \\n\\nMari kita kawal terus persiapannya agar kita dapat memberikan fasilitas dan pelayanan terbaik bagi para atlet kebanggaan Jawa Barat!\\n\\n​#PORPROVXVJabar2026 #CiketingUdik #Bantargebang #TinjuJabar\\n\\nKamis, 20 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\",\"post_time\":1787223654,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":13,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcQmZ7ACWUh.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788973399016,\"id\":\"DcQkW1liPyI\",\"image\":\"https://scontent-hkg4-1.cdninstagram.com/v/t51.71878-15/777622052_3983177621984454_5625108678156197289_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk2NzgzMTE3MDc1NDM0NjEyMA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=HE5Lrq151IIQ7kNvwHI0Rvu&_nc_oc=Ado8D0ZEzyNHHrAshWAuzRdSs80jx7tL-4xUYhoVqpDhc_5SaxDvIMPDlZbL0y9YYMs&_nc_zt=23&_nc_ht=scontent-hkg4-1.cdninstagram.com&_nc_gid=lMPIAV1K2DaLjkbY7ihbCQ&_nc_ss=7e6a8&oh=00_AQLZQZizsvCqPZdTNSeRYubJd52XNNtgGnPRzNqR9P89Pg&oe=6AA77D65\",\"caption\":\"Mari kita sambut dengan antusiasme yang meriah! 🎉\\n\\nKelurahan Ciketing Udik di bawah kepemimpinan Bapak Usep Sudharma Wijaya, SE, memberikan acungan jempol dan dukungan penuh untuk mensukseskan PORPROV XV JABAR 2026 di Kota Bekasi. \\n\\nBersama Lurah Ciketingudik dan maskot resmi kita yang lincah, mari kita persiapkan diri untuk menjadi tuan rumah yang luar biasa bagi atlet-atlet terbaik Jawa Barat. \\n\\nSemangat olahraga, semangat Ciketing Udik!\\n\\n#CiketingUdik #KotaBekasi #PORPROVXVJABAR2026 #\\n\\nKamis, 20 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\",\"post_time\":1787222425,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":19,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcQkW1liPyI.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788973399016,\"id\":\"DcQjb-6CHCS\",\"image\":\"https://scontent-hkg4-1.cdninstagram.com/v/t51.71878-15/782413357_37762425473372592_2628262743850029483_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=110&ig_cache_key=Mzk2NzgyNzEyNjMxMjc5MjIxMA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=PcBA3RqTSFAQ7kNvwEOdDFU&_nc_oc=AdoT6obGpvTO2cDZyL1_ikZID0gI_y_CmwEtshPHyUKSZ0fuS1tuudVKuDSFu0d-J-4&_nc_zt=23&_nc_ht=scontent-hkg4-1.cdninstagram.com&_nc_gid=lMPIAV1K2DaLjkbY7ihbCQ&_nc_ss=7e6a8&oh=00_AQKl3tODCApMIOaNQBSsn4O7E6l_ZHPMpw04KVGMlt_gbQ&oe=6AA7524D\",\"caption\":\"Pengecekan Lokasi Persiapan Groundbreaking\\n\\nDalam rangka memastikan kesiapan pelaksanaan groundbreaking PSEL, telah dilaksanakan pengecekan lokasi di Stadion Mini Ciketingudik, Kecamatan Bantargebang.\\n\\nKegiatan ini dihadiri oleh Camat Bantargebang, Lurah Ciketingudik, Wakapolsek Bantargebang, Danramil Bantargebang, serta perwakilan dari Dinas Lingkungan Hidup, Dinas Perhubungan, Satpol PP, Danantara, dan Dinas Pemadam Kebakaran.\\n\\nPengecekan dilakukan untuk memastikan kesiapan lokasi, keamanan, ketertiban, serta koordinasi antarinstansi agar seluruh rangkaian kegiatan dapat berjalan dengan baik, aman, dan lancar.\\n\\nSinergi dan kolaborasi menjadi kunci dalam mendukung kelancaran pelaksanaan kegiatan serta pengelolaan sampah yang lebih baik di Kota Bekasi.\\n\\n#Ciketingudik #Bantargebang #KotaBekasi #Groundbreaking #PSEL\\n\\nKamis, 20 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\",\"post_time\":1787221944,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":11,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcQjb-6CHCS.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788973399016,\"id\":\"DcQGPyCiqoe\",\"image\":\"https://scontent-hkg4-1.cdninstagram.com/v/t51.71878-15/775416616_1611343820347897_5713487494414459599_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=Mzk2NzY5ODc0NDUxNDM1Nzc5MA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=3tSl1WhmH6sQ7kNvwEgZ0zo&_nc_oc=AdoLX4WtbJZFG8-unLJcKRBBKHHF6RKDxcUbawOCxVQTLCdYx-TPXnxMga1JC7Qu5Os&_nc_zt=23&_nc_ht=scontent-hkg4-1.cdninstagram.com&_nc_gid=lMPIAV1K2DaLjkbY7ihbCQ&_nc_ss=7e6a8&oh=00_AQKy9CxV3wPw2gD5FAWOIC4VAzy71oiYJQBMyLOsTg-cOw&oe=6AA77767\",\"caption\":\"📍 Kesiapan Groundbreaking PSEL di Stadion Mini Ciketingudik\\n\\nLurah Ciketingudik mendampingi Camat Bantargebang dalam kegiatan pengecekan dan memastikan kesiapan lokasi groundbreaking PSEL di Stadion Mini Ciketingudik.\\n\\nKegiatan ini dilakukan sebagai bagian dari persiapan agar pelaksanaan groundbreaking dapat berjalan dengan baik, aman, dan lancar.\\n\\nSemoga pembangunan dan program PSEL ini dapat memberikan manfaat bagi masyarakat serta mendukung pengelolaan sampah yang lebih baik di wilayah Bantargebang.\\n\\n#Ciketingudik #Bantargebang #KotaBekasi #PSEL #PengelolaanSampah\\n\\nKamis, 20 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargeba\",\"post_time\":1787206608,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":11,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcQGPyCiqoe.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788973399016,\"id\":\"DcMDi1jyIIb\",\"image\":\"https://scontent-hkg1-2.cdninstagram.com/v/t51.71878-15/774795954_1370376728503389_2828194274896217661_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=104&ig_cache_key=Mzk2NjU2MDk1OTkxNjk2NjQyNzE1MDQyMDE3NjEzOTU4OTI%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=ZE7nXyVjmocQ7kNvwFiIgoh&_nc_oc=AdoLTlf8_YMaoE_eP6TrEzIWPKvrgRcL614NxLwQAl4LgGgqFkrjZ4uNV04TqFx54qo&_nc_zt=23&_nc_ht=scontent-hkg1-2.cdninstagram.com&_nc_gid=lMPIAV1K2DaLjkbY7ihbCQ&_nc_ss=7e6a8&oh=00_AQIAforr6xAeg5UEA__q3x4oNU_BnPpbKClsUSlSAyDabQ&oe=6AA774E6\",\"caption\":\"Camat Bantargebang bersama Sekcam Bantargebang dan seluruh Pemangku Jabatan Se Kecamatan Bantargebang mengikuti kegiatan Fun Games bagi Pejabat Struktural dan Fungsional di Lingkungan Kota Bekasi dalam rangka memperingati  HUT ke-81 Bertempat di Plaza Pemerintah Kota bekasi, Selasa (18/08).\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@achmadshovie007\\n@ventus1208 \\n@pemkot_bekasi\\n@prokopim.kotabekasi @diskominfobekasi\",\"post_time\":1787071513,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":2,\"like_count\":62,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcMDi1jyIIb.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788973399016,\"id\":\"DcMB8zRSGIm\",\"image\":\"https://scontent-hkg1-2.cdninstagram.com/v/t51.71878-15/778291846_1040444638834295_8400922934376449336_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=102&ig_cache_key=Mzk2NjU1Mzk0ODA3MjQ2OTAzMDEwODMxODk4ODgwMTYwNTc%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=9FDaD5rzDBUQ7kNvwGdXnsO&_nc_oc=AdoxlTGnqG1DkL4vXMmTf7pYPEJVK53Mlhv8S8vAJk04puLlqACsrDDkNSVVKiEpvGg&_nc_zt=23&_nc_ht=scontent-hkg1-2.cdninstagram.com&_nc_gid=lMPIAV1K2DaLjkbY7ihbCQ&_nc_ss=7e6a8&oh=00_AQKku2lfFq2OHARo8lTeRd9T8nJCCxYI1PZ1JJFUI84jGg&oe=6AA77231\",\"caption\":\"🇮🇩 UPACARA PENGIBARAN BENDERA 🇮🇩\\nDALAM RANGKA HUT KE-81 KEMERDEKAAN REPUBLIK INDONESIA\\nSenin, 17 Agustus 2026, telah dilaksanakan Upacara Pengibaran Bendera dalam rangka memperingati Hari Ulang Tahun ke-81 Kemerdekaan Republik Indonesia.\\n\\nUpacara berlangsung dengan khidmat, tertib, dan penuh semangat nasionalisme. Momentum ini menjadi pengingat bagi kita semua untuk terus menghargai jasa para pahlawan serta mengisi kemerdekaan dengan karya, pengabdian, dan kontribusi terbaik bagi bangsa dan negara.\\n\\nTerima kasih kepada seluruh petugas Paskibra @smkn2.kotabks, Tim Aubade @smpn49kotabekasi_official, Seluruh Aparatur Kecamatan dan para tamu undangan yang telah berperan serta mensukseskan pelaksanaan upacara.\\n\\nDirgahayu ke-81 Republik Indonesia! 🇮🇩\\nMerdeka! Merdeka! Merdeka!\\n\\n#HUTRI81 #DirgahayuRI #UpacaraBendera #17Agustus2026 KemerdekaanRI IndonesiaMerdeka IndonesiaMaju SemangatKemerdekaan HariKemerdekaan\\n\\n@mastriadhianto \\n@harris.bobihoe\\n@achmadshovie007 \\n@ventus1208 \\n@pemkot_bekasi \\n@prokopim.kotabekasi \\n@diskominfobekasi\",\"post_time\":1787070733,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":2,\"like_count\":156,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcMB8zRSGIm.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788973399016,\"id\":\"DcJADUxCWut\",\"image\":\"https://scontent-hkg4-1.cdninstagram.com/v/t51.71878-15/777064700_1957449584934257_4660488303116608306_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=Mzk2NTcwMTE3NTMzMjQwMDA0NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=GAXYtjgGmQYQ7kNvwGWgVzh&_nc_oc=AdrV4-lt-kMsdAL6MhVTs5CuA8o9u_E6y0rCRZOl2buVvKkLRIQHCatQ50ZF1Y-geWY&_nc_zt=23&_nc_ht=scontent-hkg4-1.cdninstagram.com&_nc_gid=lMPIAV1K2DaLjkbY7ihbCQ&_nc_ss=7e6a8&oh=00_AQJdrWY86va9vXjglzNvCTn7rOPDeMxRNh1rBWfbMyLW-w&oe=6AA771E7\",\"caption\":\"Dirgahayu Republik Indonesia ke-81! 🇮🇩✨\\n\\n​Semangat kebersamaan dan cinta tanah air terasa begitu kuat dalam Upacara Peringatan Hari Kemerdekaan Republik Indonesia ke-71 di Taman Kecamatan Bantargebang, Senin (17/08/2026).\\n\\n​Upacara khidmat ini dipimpin langsung oleh Camat Bantargebang dan dihadiri dengan penuh antusias oleh Lurah se-Kecamatan Bantargebang, beserta jajaran kelurahan, LPM, MUB, Satlinmas, serta para tokoh masyarakat setempat. \\n\\nMomentum ini menjadi pengingat bagi kita semua untuk terus memperkuat sinergi dalam membangun lingkungan yang lebih maju.\\n\\n​Nusantara Baru, Indonesia Maju! Merdeka! 🔥\\n\\n​#HUTRI81 #KemerdekaanIndonesia #KecamatanBantargebang #KotaBekasi\\n\\nSenin, 17 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1786968814,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":3,\"like_count\":17,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcJADUxCWut.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1788973399016,\"id\":\"DcFkQXZq-id\",\"image\":\"https://scontent-hkg4-1.cdninstagram.com/v/t51.71878-15/774033794_1066679672606127_6261729182317304038_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk2NDczNDUwMTI4MjM3NTgzNw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=X54EH8DD36UQ7kNvwFsquR7&_nc_oc=Adqiiw7sYb-vBnNVloRX70fVYkDbyTmH78EfjlFBu3H0K7b9j2l2hDIZ0YQfWBwPZ4I&_nc_zt=23&_nc_ht=scontent-hkg4-1.cdninstagram.com&_nc_gid=lMPIAV1K2DaLjkbY7ihbCQ&_nc_ss=7e6a8&oh=00_AQLanHaUg0Ri3wJsYBsgzgGl18qUpRBBBcIfa5X_588CsQ&oe=6AA77590\",\"caption\":\"Semarak HUT RI ke-81 & Menuju Porprov XV Kota Bekasi 2026! 🏆✨\\n\\n​Dalam rangka menyambut Hari Ulang Tahun Kemerdekaan Republik Indonesia ke-81 sekaligus menggemakan semangat Porprov ke-15 Tahun 2026 di Kota Bekasi, Lurah Ciketingudik bersama jajaran dan warga sekitar bergerak aktif melaksanakan aksi nyata di wilayah! 🤝\\n\\n​Pemasangan banner POrprov XV dan umbul-umbul semarak kemerdekaan serta Kegiatan K3 (Kebersihan, Keindahan, dan Ketertiban) telah sukses dilaksanakan serentak di sepanjang Jalan TPST Bantargebang (Wilayah RW 001 & RW 003, Kelurahan Ciketingudik). 🧹💪\\n\\nLingkungan yang bersih adalah cerminan kepribadian bangsa. Mari bersama-sama kita jaga kebersihan wilayah kita dan sukseskan perhelatan akbar Porprov XV 2026 di Kota Bekasi. Semangat gotong royong untuk Ciketingudik yang semakin maju!\\\" 🇮🇩🔥\\n\\n​#HUTRI81 #PorprovXV2026 #KotaBekasi #Ciketingudik #Bantargebang\\n\\nMinggu, 16 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1786853321,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":10,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcFkQXZq-id.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcUn-poBjQg\",\"image\":\"https://scontent-sjc6-1.cdninstagram.com/v/t51.71878-15/779957696_1567797861467296_5696660719400305835_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=109&ig_cache_key=Mzk2ODk3MzAwMDczNjY1MDI3Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZmlyc3RfZnJhbWVfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=SBSs-nhkumoQ7kNvwFv7TJm&_nc_oc=AdphEvkq9PPHw8wQHusO0A2qaJuxaHBGGyYlrdWIi0NZWPaR1EtWJPQysYIs9fq0xoY&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQL3ITdNJ-LByYQnZiC0jI8q4_Xb0WQybMARCoOiNEPHCg&oe=6AA8D116\",\"caption\":\"*NANTIKAN! RIDHO BERPECI SPECIAL EDITION!*\\n\\nKali ini RIDHO BERPECI mempersembahkan edisi spesial bertemakan: *_Soft Launching Aplikasi SICANTIK_ - Kemudahan Administrasi Terpadu Keluarga*.\\n\\nDi episode kali ini, spesial akan diluncurkan *Aplikasi SICANTIK: Sistem Catatan Administrasi dan Nilai Terpadu Informasi Keluarga* yang diinisiasi oleh Dinas Pemberdayaan Perempuan dan Perlindungan Anak (DPPPA) Kota Bekasi bersama TP. PKK Kota Bekasi. \\n\\nApa itu Aplikasi SICANTIK? di RIDHO BERPECI SPECIAL EDITION akan lengkap dijelaskan oleh para narasumber, yakni Ridwan AS, S.H, M.Si selaku kepala DPPPA Kota Bekasi, Wiwiek Hargono Tri Adhinato selaku Ketua TP. PKK Kota Bekasi, dan Paras Sujiwo, S.Si, M.M yang akan tayang pada: \\n\\n🗓️Minggu, 23 Agustus 2026\\n🕣15.30 s.d 17.00 WIB\\nTayang melalui Live Streaming YouTube Pemerintah Kota Bekasi dan melalui Zoom Meeting.\\n\\nYuk! Catat tanggalnya dan ikut serta dalam RIDHO BERPECI: RIDHO bersama untuk pecahkan masalah dan mencari solusi.\\n\\n#kotabekasi \\n#kotapatriot \\n#kotabekasikeren \\n#bekasikerenmenujukotaglobal \\n#ridhoberpeci\\n\\nSabtu, 22 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1787358495,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":4,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcUn-poBjQg.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcS75MjirgD\",\"image\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.82787-15/780201759_18151713076508742_8296426721406947063_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=Mzk2ODQ5NzYzNjkwMjM1Mjg5OQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fdXNlcl91cGxvYWRlZF90aHVtYm5haWwuQzMifQ%3D%3D&_nc_ohc=LdIl4XU96DcQ7kNvwHQoBRx&_nc_oc=Adr7qyZ6bUluqd9yLjtLPeeHqKrzEWCeeMShMyEX8pjX2kntzva1Qh693iV1pLxaXjs&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQLJuFYQd90mr4lcvGhNXllbQyQnh7AjzmYm58pW8Cxi6g&oe=6AA8DA7F\",\"caption\":\"PENYALURAN BANSOS MUB CIKETINGUDIK 🤝✨\\n\\nSekretaris Kelurahan bersama Kasi Kesos menghadiri kegiatan Penyaluran Bantuan Sosial yang diselenggarakan oleh MUB Kelurahan Ciketingudik untuk warga penerima manfaat.\\n\\nPenyaluran bantuan ini diserahkan secara langsung dan tepat sasaran kepada warga yang telah ditetapkan sesuai dengan verifikasi data serta ketentuan yang berlaku.\\n\\nSinergi antara pihak kelurahan dan MUB ini diharapkan dapat memberikan dampak positif nyata serta meringankan beban kebutuhan masyarakat yang membutuhkan. Terima kasih kepada seluruh pihak yang telah mengawal jalannya acara hingga tertib dan lancar! 🌿\\n\\n📍 Lokasi: Kelurahan Ciketingudik\\n\\n👥 Kehadiran: Sekel, Kasi Kesos, & Pengurus MUB Kelurahan Ciketingudik\\n\\n#MUB #MUBCiketingudik #PenyaluranBansos #BantuanSosial\\n\\nJum'at, 21 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1787301830,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":7,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcS75MjirgD.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcS3jGMCsyK\",\"image\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.82787-15/780456743_18151709722508742_9107475427864588090_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=Mzk2ODQ3ODUyNjA1MTExMDAyNg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fdXNlcl91cGxvYWRlZF90aHVtYm5haWwuQzMifQ%3D%3D&_nc_ohc=Z6-wkSJg2OAQ7kNvwElCFZa&_nc_oc=AdpGwSL8vykbRBOy9HixARGw0_FLgpo8PC29esKttErgK2IC29yeC7h4DE61OlVQmcQ&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQIPTgJjofzf0QtM33deEuSUrGtKqjLFdk1NBxR_tjm1Tg&oe=6AA8AB3C\",\"caption\":\"TINDAK LANJUT PEMBAKARAN SAMPAI ILEGAL 🚫🔥\\n\\nMerespons keluhan warga Perumahan Srimaya Summarecon terkait aktivitas pembakaran sampah yang mengganggu kenyamanan dan kualitas udara, Lurah bersama tim UPTD Lingkungan Hidup (LH) langsung turun ke lokasi untuk melakukan peninjauan dan penanganan lapangan.\\n\\nLangkah ini diambil sebagai bentuk komitmen dalam menjaga kebersihan lingkungan, kesehatan masyarakat, serta menegakkan aturan larangan membuang dan membakar sampah sembarangan.\\n\\nMari saling menjaga kenyamanan bersama dengan tidak membakar sampah dan mengelola limbah rumah tangga secara bijak. Lingkungan sehat, warga tenang! 🍃\\n📍 Lokasi: Area Perumahan Srimaya Summarecon & Sekitarnya\\n\\n🤝 Pelaksana: Lurah & Tim UPTD Lingkungan Hidup\\n\\n#ResponCepat #LingkunganHidup #StopBakarSampah #Bantargebang\\n\\nJum'at, 21 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\",\"post_time\":1787299553,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":7,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcS3jGMCsyK.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcSziSRCQ2Z\",\"image\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.82787-15/783424086_18151709782508742_3940091524147922314_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk2ODQ2MDg3ODExNDI2MjQyNTE4MTUxNzA5Nzc5NTA4NzQy.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fdXNlcl91cGxvYWRlZF90aHVtYm5haWwuQzMifQ%3D%3D&_nc_ohc=ES1mMnn81CEQ7kNvwHJTzu8&_nc_oc=Ado4i2RnetwubTTehMYWTRDqQ2YIg_Pd750b7LTm2BGp7nmGJBjQS2vT_7t43Ekb4gw&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQK-gyFyjCsbytkQi4DjfaXjbv0zBZjC_g9jz2G1blGTxA&oe=6AA8AC8B\",\"caption\":\"Mendukung pengembangan potensi atlet lokal, Lurah Ciketingudik mendampingi Camat Bantargebang dalam pembukaan Turnamen Olahraga Floorball yang berlangsung di Lapangan GOR Bumen Jaya, Kelurahan Ciketingudik.\\n\\nAjang olahraga ini diselenggarakan sebagai langkah strategis serta persiapan matang menyambut gelaran Pekan Olahraga Provinsi (Porprov) Jawa Barat XV di mana Kota Bekasi akan menjadi tuan rumah.\\n\\nDukungan penuh terus diberikan demi melahirkan atlet-atlet berbakat yang siap mengharumkan nama wilayah di tingkat provinsi! 🏆🔥\\n\\nDetail Kegiatan:\\n📍 Lokasi: Lapangan GOR Bumen Jaya, Kelurahan Ciketingudik\\n🏆 Agenda: Pembukaan Turnamen Olahraga Floorball (Ajang Persiapan Porprov Jabar XV)\\n\\n#Ciketingudik #Bantargebang #KotaBekasi #Floorball #PorprovJabarXV\\n\\nJum'at, 21 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\",\"post_time\":1787297451,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":4,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcSziSRCQ2Z.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcQmZ7ACWUh\",\"image\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.82787-15/776714748_18151628896508742_5762965322864366686_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=Mzk2Nzg0MDE3ODgxOTEzMDY1NzE4MTUxNjI4ODkwNTA4NzQy.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fdXNlcl91cGxvYWRlZF90aHVtYm5haWwuQzMifQ%3D%3D&_nc_ohc=yZDXe6AqnOYQ7kNvwFQ4Jue&_nc_oc=AdqVl5yC8qCKJ5A7ojc6VFmGDdga671xVVcuk8pryjGhUcbl0IocHrqglvCfNAjWA6Y&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQIhCARMcBXpCCNwZnhLNysHVYXA0pkGefp4M0uC19gKLw&oe=6AA8C767\",\"caption\":\"🥊 Sinergi Penuh Persiapan Cabor Tinju PORPROV XV JABAR 2026!\\n\\n​Semangat persiapan menyambut pesta olahraga terbesar di Jawa Barat terus dikobarkan! \\nPemerintah setempat terus bergerak cepat untuk memastikan kesiapan Kota Bekasi sebagai tuan rumah yang membanggakan.\\n\\n​Langkah konkret kembali dilakukan hari ini melalui peninjauan langsung dan koordinasi intensif. \\n\\nCamat Bantargebang bersama Lurah Ciketingudik, serta didampingi oleh Ketua BKM Ciketing Udik, telah melangsungkan pertemuan penting dengan jajaran Dispora Jawa Barat.\\n\\nFokus Agenda Pertemuan & Peninjauan:\\n\\n​1. Membahas persiapan menyeluruh terkait kelancaran pelaksanaan perlombaan cabang olahraga (cabor) tinju.\\n​2. Melakukan peninjauan langsung ke GOR Bumen Jaya untuk memastikan kesiapan fasilitas, ring, dan infrastruktur pendukung agar sesuai dengan standar pertandingan.\\n​3. Memperkuat sinergi antara Pemerintah Kecamatan, Kelurahan, pengurus BKM, dan Dispora Provinsi demi menyukseskan gelaran acara tanpa hambatan.\\n\\n​Dukungan penuh dari aparatur Kelurahan Ciketing Udik dan Kecamatan Bantargebang ini adalah bukti nyata komitmen bersama untuk menyukseskan PORPROV XV Jabar 2026 di Kota Bekasi. \\n\\nMari kita kawal terus persiapannya agar kita dapat memberikan fasilitas dan pelayanan terbaik bagi para atlet kebanggaan Jawa Barat!\\n\\n​#PORPROVXVJabar2026 #CiketingUdik #Bantargebang #TinjuJabar\\n\\nKamis, 20 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\",\"post_time\":1787223654,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":13,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcQmZ7ACWUh.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcQkW1liPyI\",\"image\":\"https://scontent-sjc6-1.cdninstagram.com/v/t51.71878-15/777717145_966686169788312_8594638186756081209_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=Mzk2NzgzMTE3MDc1NDM0NjEyMA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZmlyc3RfZnJhbWVfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=7L821Qgy500Q7kNvwE0mvI7&_nc_oc=AdrDZvRsXK99lGp0rw2WNCXxACFi2fYPRT3uvkDeyC5xCMsNV6RTgL3eAKxxNgHVOHU&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQIywA2k9h5xTL1thIragx0xCbKtc7RHkDCIJyX1LYhWhQ&oe=6AA8B052\",\"caption\":\"Mari kita sambut dengan antusiasme yang meriah! 🎉\\n\\nKelurahan Ciketing Udik di bawah kepemimpinan Bapak Usep Sudharma Wijaya, SE, memberikan acungan jempol dan dukungan penuh untuk mensukseskan PORPROV XV JABAR 2026 di Kota Bekasi. \\n\\nBersama Lurah Ciketingudik dan maskot resmi kita yang lincah, mari kita persiapkan diri untuk menjadi tuan rumah yang luar biasa bagi atlet-atlet terbaik Jawa Barat. \\n\\nSemangat olahraga, semangat Ciketing Udik!\\n\\n#CiketingUdik #KotaBekasi #PORPROVXVJABAR2026 #\\n\\nKamis, 20 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\",\"post_time\":1787222425,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":19,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcQkW1liPyI.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcQjb-6CHCS\",\"image\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.71878-15/782413357_37762425473372592_2628262743850029483_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=110&ig_cache_key=Mzk2NzgyNzEyNjMxMjc5MjIxMA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZmlyc3RfZnJhbWVfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=PcBA3RqTSFAQ7kNvwG9n9gW&_nc_oc=AdoE2pHpY5lFF805N0yWZbAPjNlLwjYiYom1k7Dox-p9D1vYMmrIw7oAtM_Pl4qBhog&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQLDXcKpds4KGGDXwI_K2mcUxU-A7_nCA8hZsWwbXox6LA&oe=6AA8DC0D\",\"caption\":\"Pengecekan Lokasi Persiapan Groundbreaking\\n\\nDalam rangka memastikan kesiapan pelaksanaan groundbreaking PSEL, telah dilaksanakan pengecekan lokasi di Stadion Mini Ciketingudik, Kecamatan Bantargebang.\\n\\nKegiatan ini dihadiri oleh Camat Bantargebang, Lurah Ciketingudik, Wakapolsek Bantargebang, Danramil Bantargebang, serta perwakilan dari Dinas Lingkungan Hidup, Dinas Perhubungan, Satpol PP, Danantara, dan Dinas Pemadam Kebakaran.\\n\\nPengecekan dilakukan untuk memastikan kesiapan lokasi, keamanan, ketertiban, serta koordinasi antarinstansi agar seluruh rangkaian kegiatan dapat berjalan dengan baik, aman, dan lancar.\\n\\nSinergi dan kolaborasi menjadi kunci dalam mendukung kelancaran pelaksanaan kegiatan serta pengelolaan sampah yang lebih baik di Kota Bekasi.\\n\\n#Ciketingudik #Bantargebang #KotaBekasi #Groundbreaking #PSEL\\n\\nKamis, 20 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\",\"post_time\":1787221944,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":11,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcQjb-6CHCS.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcQGPyCiqoe\",\"image\":\"https://scontent-sjc6-1.cdninstagram.com/v/t51.71878-15/775416616_1611343820347897_5713487494414459599_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=Mzk2NzY5ODc0NDUxNDM1Nzc5MA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZmlyc3RfZnJhbWVfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=3tSl1WhmH6sQ7kNvwHfTzpT&_nc_oc=AdoLXX5ISL1KX2S2WLgS8Or0MNmya_-5q7_-a8cewxmXhuraU2C-BjNuuvNrhgAK2Lc&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQIruygy22AxVnltFy0u02wmXgzMIKllhu_wdNkvKYhRnw&oe=6AA8C8E7\",\"caption\":\"📍 Kesiapan Groundbreaking PSEL di Stadion Mini Ciketingudik\\n\\nLurah Ciketingudik mendampingi Camat Bantargebang dalam kegiatan pengecekan dan memastikan kesiapan lokasi groundbreaking PSEL di Stadion Mini Ciketingudik.\\n\\nKegiatan ini dilakukan sebagai bagian dari persiapan agar pelaksanaan groundbreaking dapat berjalan dengan baik, aman, dan lancar.\\n\\nSemoga pembangunan dan program PSEL ini dapat memberikan manfaat bagi masyarakat serta mendukung pengelolaan sampah yang lebih baik di wilayah Bantargebang.\\n\\n#Ciketingudik #Bantargebang #KotaBekasi #PSEL #PengelolaanSampah\\n\\nKamis, 20 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargeba\",\"post_time\":1787206608,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":11,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcQGPyCiqoe.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcMDi1jyIIb\",\"image\":\"https://scontent-sjc6-1.cdninstagram.com/v/t51.71878-15/774795954_1370376728503389_2828194274896217661_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=104&ig_cache_key=Mzk2NjU2MDk1OTkxNjk2NjQyNzE1MDQyMDE3NjEzOTU4OTI%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fdXNlcl9zZWxlY3RlZF90aHVtYm5haWwuQzMifQ%3D%3D&_nc_ohc=S50RVXZERV0Q7kNvwEanomd&_nc_oc=AdppeKzGeve2YvCOLJePraE8AZVn38p18e629EOXyPUs5EEWls4vXuXsPDvaHpi1d18&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQKkYu12frEUYNtdOFZGox7-b9QJFDb7OwQINP8atwIgPQ&oe=6AA8C666\",\"caption\":\"Camat Bantargebang bersama Sekcam Bantargebang dan seluruh Pemangku Jabatan Se Kecamatan Bantargebang mengikuti kegiatan Fun Games bagi Pejabat Struktural dan Fungsional di Lingkungan Kota Bekasi dalam rangka memperingati  HUT ke-81 Bertempat di Plaza Pemerintah Kota bekasi, Selasa (18/08).\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@achmadshovie007\\n@ventus1208 \\n@pemkot_bekasi\\n@prokopim.kotabekasi @diskominfobekasi\",\"post_time\":1787071513,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":2,\"like_count\":62,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcMDi1jyIIb.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcMB8zRSGIm\",\"image\":\"https://scontent-sjc6-1.cdninstagram.com/v/t51.71878-15/778291846_1040444638834295_8400922934376449336_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=102&ig_cache_key=Mzk2NjU1Mzk0ODA3MjQ2OTAzMDEwODMxODk4ODgwMTYwNTc%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fdXNlcl9zZWxlY3RlZF90aHVtYm5haWwuQzMifQ%3D%3D&_nc_ohc=stXCWxU4y0AQ7kNvwFblmWj&_nc_oc=AdqRSkMI6q6lZAVCJANEOzOm9hEau_v5EpbvHzaZALv1oEn9Mly51xrJPsnboX4GoKI&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQIJCclSPjV1KjszchpQrZowkQrTa4Zkclgt41lhqquoFA&oe=6AA8C3B1\",\"caption\":\"🇮🇩 UPACARA PENGIBARAN BENDERA 🇮🇩\\nDALAM RANGKA HUT KE-81 KEMERDEKAAN REPUBLIK INDONESIA\\nSenin, 17 Agustus 2026, telah dilaksanakan Upacara Pengibaran Bendera dalam rangka memperingati Hari Ulang Tahun ke-81 Kemerdekaan Republik Indonesia.\\n\\nUpacara berlangsung dengan khidmat, tertib, dan penuh semangat nasionalisme. Momentum ini menjadi pengingat bagi kita semua untuk terus menghargai jasa para pahlawan serta mengisi kemerdekaan dengan karya, pengabdian, dan kontribusi terbaik bagi bangsa dan negara.\\n\\nTerima kasih kepada seluruh petugas Paskibra @smkn2.kotabks, Tim Aubade @smpn49kotabekasi_official, Seluruh Aparatur Kecamatan dan para tamu undangan yang telah berperan serta mensukseskan pelaksanaan upacara.\\n\\nDirgahayu ke-81 Republik Indonesia! 🇮🇩\\nMerdeka! Merdeka! Merdeka!\\n\\n#HUTRI81 #DirgahayuRI #UpacaraBendera #17Agustus2026 KemerdekaanRI IndonesiaMerdeka IndonesiaMaju SemangatKemerdekaan HariKemerdekaan\\n\\n@mastriadhianto \\n@harris.bobihoe\\n@achmadshovie007 \\n@ventus1208 \\n@pemkot_bekasi \\n@prokopim.kotabekasi \\n@diskominfobekasi\",\"post_time\":1787070733,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":2,\"like_count\":156,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcMB8zRSGIm.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcJADUxCWut\",\"image\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.71878-15/776877182_1594368482047651_8842382508244420246_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=Mzk2NTcwMTE3NTMzMjQwMDA0NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZmlyc3RfZnJhbWVfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=Lo8J0ZgQT08Q7kNvwEdETnZ&_nc_oc=Adrqa0Fdx6vIxpmX0XdzyHdIZLpBeiTnAKyQllHIaJjZSc3vQZ8Vr-joltzk9sjdmRE&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQLSZdBgBloc4VaQ50a5AbHVWfy5N4egBJDcyM7xLsKXAg&oe=6AA8AA54\",\"caption\":\"Dirgahayu Republik Indonesia ke-81! 🇮🇩✨\\n\\n​Semangat kebersamaan dan cinta tanah air terasa begitu kuat dalam Upacara Peringatan Hari Kemerdekaan Republik Indonesia ke-71 di Taman Kecamatan Bantargebang, Senin (17/08/2026).\\n\\n​Upacara khidmat ini dipimpin langsung oleh Camat Bantargebang dan dihadiri dengan penuh antusias oleh Lurah se-Kecamatan Bantargebang, beserta jajaran kelurahan, LPM, MUB, Satlinmas, serta para tokoh masyarakat setempat. \\n\\nMomentum ini menjadi pengingat bagi kita semua untuk terus memperkuat sinergi dalam membangun lingkungan yang lebih maju.\\n\\n​Nusantara Baru, Indonesia Maju! Merdeka! 🔥\\n\\n​#HUTRI81 #KemerdekaanIndonesia #KecamatanBantargebang #KotaBekasi\\n\\nSenin, 17 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1786968814,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":3,\"like_count\":17,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcJADUxCWut.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan_ciketingudik/?_showcaption=true\",\"snapshot_date\":1789063427563,\"id\":\"DcFkQXZq-id\",\"image\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.71878-15/774033794_1066679672606127_6261729182317304038_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk2NDczNDUwMTI4MjM3NTgzNw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZmlyc3RfZnJhbWVfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=X54EH8DD36UQ7kNvwGhPcoJ&_nc_oc=Ado913YYLMLh_NWgFLwUpeRF1phDzvae6vH90HLs8JcyPYaQOCVbuJSaqvuFp4Uv_aY&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=NKSdypwtjY7FEBrCgUz4AA&_nc_ss=7e6a8&oh=00_AQJuMe2AqzkPhZ0ZoVhEUCFVHRB0g8FyLtA6goQVF8XC5Q&oe=6AA8C710\",\"caption\":\"Semarak HUT RI ke-81 & Menuju Porprov XV Kota Bekasi 2026! 🏆✨\\n\\n​Dalam rangka menyambut Hari Ulang Tahun Kemerdekaan Republik Indonesia ke-81 sekaligus menggemakan semangat Porprov ke-15 Tahun 2026 di Kota Bekasi, Lurah Ciketingudik bersama jajaran dan warga sekitar bergerak aktif melaksanakan aksi nyata di wilayah! 🤝\\n\\n​Pemasangan banner POrprov XV dan umbul-umbul semarak kemerdekaan serta Kegiatan K3 (Kebersihan, Keindahan, dan Ketertiban) telah sukses dilaksanakan serentak di sepanjang Jalan TPST Bantargebang (Wilayah RW 001 & RW 003, Kelurahan Ciketingudik). 🧹💪\\n\\nLingkungan yang bersih adalah cerminan kepribadian bangsa. Mari bersama-sama kita jaga kebersihan wilayah kita dan sukseskan perhelatan akbar Porprov XV 2026 di Kota Bekasi. Semangat gotong royong untuk Ciketingudik yang semakin maju!\\\" 🇮🇩🔥\\n\\n​#HUTRI81 #PorprovXV2026 #KotaBekasi #Ciketingudik #Bantargebang\\n\\nMinggu, 16 Agustus 2026\\n@mastriadhianto\\n@harris.bobihoe\\n@humaskotabekasi \\n@diskominfobekasi \\n@prokopimkotabekasi \\n@kec_bantargebang\\n@usepsudarma\",\"post_time\":1786853321,\"owner\":\"15157812741\",\"username\":\"kelurahan_ciketingudik\",\"comment_count\":0,\"like_count\":10,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/15157812741/DcFkQXZq-id.jpg\"},{\"current_url\":\"https://www.instagram.com/kelurahan.medansatria/?_showcaption=true\",\"snapshot_date\":1780917025174,\"id\":\"C-Y_6sOy0tg\",\"image\":\"https://scontent-sin11-1.cdninstagram.com/v/t51.82787-15/628540604_18422243209186622_6876962643947518914_n.jpg?stp=dst-jpg_e35_s720x720_tt6&_nc_cat=100&ig_cache_key=MzQyOTc3MjIyNjM5NTMyNzMyOA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=UOKBrW830AAQ7kNvwFzLm8E&_nc_oc=AdqrsFRRvuFsh1NsnmQNQoKFoBG5L3OhFCoHl9qQBwsaACELf1_t2eGNk-6Y6kl4Cac&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin11-1.cdninstagram.com&_nc_gid=CYVshL2sju6Ip0_mBYM8pA&_nc_ss=7a22e&oh=00_Af9DXExrtUBCJEoKfoxEftuU5KjZgNxqPPuMjf86iQB4rw&oe=6A2C76D2\",\"caption\":\"Kamis, 8 Agustus 2024\\n\\nHallo Abang dan Mpok warga kelurahan Medansatria, dalam rangka percepatan tranformasi digital saat ini pelayanan Adminduk dapat di akses melalui identitas Kependudukan digital ( IKD ). \\n\\nAgar segera aktivasi identitas kependudukan digital ( IKD ) di kantor