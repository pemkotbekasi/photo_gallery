fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=NFCFoJEbWBkQ7kNvwH2mQQR&_nc_oc=Adq70on02T7YyeW3IBP2BkT8rzkLCBc0MZLfLTDNJD4-U04A0p-wwdkXmHeVZCgGl6Y&_nc_zt=23&_nc_ht=scontent-lhr6-2.cdninstagram.com&_nc_gid=XuMfnOXatNcyEP-9t4S2jw&_nc_ss=7e6a8&oh=00_AQLWutgVQwLWtv5agSCD9axPfMBYzj_f8zEXRqV3kHjHGw&oe=6AA6E5BA\",\"caption\":\"PESONA NUSANTARA BEKASI KEREN JILID III Tahun 2026 \\n\\nSerunya kebangetan, vibes-nya dapet banget, dan pastinya penuh warna! Pesona Nusantara Bekasi Keren Jilid III Tahun 2026 hadir dengan segudang keseruan yang bikin momen ini nggak cuma lewat, tapi juga jadi cerita! \\n\\nDari budaya yang kece, penampilan yang epic, sampai vibes kebersamaan yang auto bikin bangga jadi bagian dari Indonesia! \\n\\nKarena budaya itu bukan cuma untuk dikenang, tapi juga buat dirayakan dengan cara yang paling KEREN! \\n\\nSatu Nusantara, Banyak Pesona!\\nBekasi Keren, Budaya Makin On Point!\\n\\nSiapa nih yang ikut merasakan vibes serunya? \\n\\n@mastriadhianto @harris.bobihoe @pemkot_bekasi @bramsum45 @heryanto_suparjan\\n\\n#PesonaNusantaraBekasiKeren #KotaBekasiKeren #damkarindonesia #pemerintahkotabekasi 🇮🇩\",\"post_time\":1788074138,\"owner\":\"65124131210\",\"username\":\"disdamkarmatkotabekasi.id\",\"comment_count\":51,\"like_count\":3332,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/65124131210/Dcp80f9TIvl.jpg\"},{\"current_url\":\"https://www.instagram.com/disdamkarmatkotabekasi.id/?_showcaption=true\",\"snapshot_date\":1788938142205,\"id\":\"DciglUyT9b5\",\"image\":\"https://scontent-lhr6-2.cdninstagram.com/v/t51.82787-15/787044852_17965229037171211_5837758251381509686_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=105&ig_cache_key=Mzk3Mjg4MTEyMzcyMjEyMzAwMTE3OTY1MjI5MDMxMTcxMjEx.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=s1wNaYzPoYgQ7kNvwH1yMqm&_nc_oc=AdrVZT8KcphuhBEae25CdjzeMPUTuL2AOjXU3kDnc3HN8fw7-yZtNqvyxVCpRL0_cno&_nc_zt=23&_nc_ht=scontent-lhr6-2.cdninstagram.com&_nc_gid=XuMfnOXatNcyEP-9t4S2jw&_nc_ss=7e6a8&oh=00_AQKnnbTxIMpKy6SclVh0R41kQjXxk7kyH6qMzNuyE7Bd-Q&oe=6AA6CCFA\",\"caption\":\"♻️⚡ SAMPAH? JANGAN CUMA JADI MASALAH. SAATNYA JADI ENERGI!\\n\\nHari ini jadi momen penting buat Kota Bekasi! 🚀\\nPembangunan PSEL Kota Bekasi resmi dimulai!\\n\\nIni bukan sekadar proyek, tapi langkah nyata menuju pengelolaan sampah yang lebih modern dan berkelanjutan. 🌱\\n\\nSampah yang selama ini identik dengan “ribet” dan “numplek” sekarang didorong untuk bisa diolah menjadi energi listrik. 🔥⚡\\n\\nKarena Bekasi nggak mau jalan di tempat.\\nSampah dikelola, energi dihasilkan, masa depan disiapkan. 💚\\n\\nSo, ini saatnya kita sama-sama upgrade cara kita memperlakukan sampah.\\nMulai dari hal kecil: pilah, kurangi, dan jangan buang sembarangan. 👊\\n\\nBekasi lagi upgrade. Are you ready? 🚀♻️\\n\\n@mastriadhianto @harris.bobihoe @pemkot_bekasi @bramsum45 @heryanto_suparjan\\n\\n#PSELKotaBekasi #KotaBekasi #BekasiUpgrade #BekasiBergerak #SampahJadiEnergi\",\"post_time\":1787824417,\"owner\":\"65124131210\",\"username\":\"disdamkarmatkotabekasi.id\",\"comment_count\":75,\"like_count\":375,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/65124131210/DciglUyT9b5.jpg\"},{\"current_url\":\"https://www.instagram.com/disdamkarmatkotabekasi.id/?_showcaption=true\",\"snapshot_date\":1788938142205,\"id\":\"DdBe5GJz0-t\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/799601282_18282436039291261_3322176378465788553_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk4MTU5OTQxMDU4NDc2ODQyOTE4MjgyNDM2MDM2MjkxMjYx.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=hECQT-8MTL8Q7kNvwE8kXQP&_nc_oc=Adp5Jc3u3dAxxUFG-a02qyUJvtlqQDaLa7qY2mmK8JMCuyJmlmEyWCPnlH8PvLryEjk&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=XuMfnOXatNcyEP-9t4S2jw&_nc_ss=7e6a8&oh=00_AQJBfWyxUzeNmFx34MNh108O2N8MwwyXjYXD9L5OrfzpyQ&oe=6AA6D680\",\"caption\":\"🚒 PENYEMPROTAN JALAN RAYA JATIWARINGIN\\n\\nSelasa, 8 September 2026,\\nMulai pukul 09.00 WIB s.d. selesai, \\ntelah dilaksanakan penyemprotan Jalan Raya Jatiwaringin oleh Disdamkarmat Sektor Pondokgede.\\n\\nPenyemprotan menggunakan campuran eco enzyme dengan perbandingan 1:5.000 L, melalui sistem tembakan spray/embun dengan kemiringan sekitar 60° ke atas.\\n\\nKegiatan ini merupakan salah satu langkah untuk meminimalisir debu vulkanik akibat erupsi Gunung Anak Krakatau pada 4 September 2026.\\n\\n🙏 Terima kasih kepada Disdamkarmat Sektor Pondokgede atas respons dan dukungannya dalam menjaga kenyamanan serta kebersihan lingkungan.\\n\\n💙 Untuk warga Jatiwaringin, tetap waspada, gunakan masker saat beraktivitas di luar rumah, dan ikuti imbauan dari pihak berwenang.\\n\\nJatiwaringin Bersih, Warga Sehat, Lingkungan Terjaga!\\n\\n#jatiwaringin #pondokgede #kotabekasijuara #KotaBekasiKeren \\n@mastriadhianto @harris.bobihoe @zainal6905 @mursidiroy27 @haririh60 @pemkot_bekasi @diskominfobekasi @prokopim.kotabekasi @diskominfobekasi @humas_jabar @disdamkarmatkotabekasi.id\",\"post_time\":1788863878,\"owner\":\"65124131210\",\"username\":\"disdamkarmatkotabekasi.id\",\"comment_count\":3,\"like_count\":107,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/65124131210/DdBe5GJz0-t.jpg\"},{\"current_url\":\"https://www.instagram.com/disdamkarmatkotabekasi.id/?_showcaption=true\",\"snapshot_date\":1788938142205,\"id\":\"DdBMLeZT6MJ\",\"image\":\"https://scontent-lhr6-2.cdninstagram.com/v/t51.71878-15/800958814_2012302186141931_2662396158934365437_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=109&ig_cache_key=Mzk4MTUxNzExMDY4MTUxMDY2NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=MoYo_GIkPlMQ7kNvwGuD39v&_nc_oc=Adqmc-QDeV_7o0dH4u7x5HUFjIpoOpClZ4rcoXgMfQFCV6vGOnCqO5UDBuuapcHtmCE&_nc_zt=23&_nc_ht=scontent-lhr6-2.cdninstagram.com&_nc_gid=XuMfnOXatNcyEP-9t4S2jw&_nc_ss=7e6a8&oh=00_AQIkkOllj6EQ0r2Kt54_wVcadbD7QmNcLWRKYN12yrAXfg&oe=6AA6C1B8\",\"caption\":\"GERAK CEPAT ATASI ABU VULKANIK\\n\\nSebagai bentuk respons cepat terhadap adanya abu vulkanik yang berdampak pada lingkungan dan jalanan, Kelurahan Margamulya berkolaborasi dengan Dinas Pemadam Kebakaran Kota Bekasi melakukan penyiraman jalan menggunakan mobil pemadam kebakaran di wilayah Kelurahan Margamulya.\\nLangkah ini dilakukan untuk membantu membersihkan abu vulkanik yang berada di permukaan jalan, mengurangi debu yang beterbangan, serta menjaga kenyamanan dan keselamatan masyarakat dalam beraktivitas.\\n\\n🤝 Sinergi dan kolaborasi menjadi kunci dalam memberikan pelayanan terbaik dan penanganan cepat bagi masyarakat.\\n\\nKelurahan Margamulya — Sigap Melayani, Cepat Bertindak, Bersama untuk Masyarakat.\\n\\n#KelurahanMargamulya #KotaBekasi #DamkarKotaBekasi #GerakCepat #BekasiSigap\\n\\n@mastriadhianto \\n@ikhwanudinrahmat \\n@makpudinalmaktub \\n@kecbekasi_utara \\n@disdamkarmatkotabekasi.id\",\"post_time\":1788853902,\"owner\":\"65124131210\",\"username\":\"disdamkarmatkotabekasi.id\",\"comment_count\":0,\"like_count\":48,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/65124131210/DdBMLeZT6MJ.jpg\"},{\"current_url\":\"https://www.instagram.com/disdamkarmatkotabekasi.id/?_showcaption=true\",\"snapshot_date\":1788938142205,\"id\":\"DdAs6g7T4QU\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/800538793_17966912613171211_7612507227839395350_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=Mzk4MTM3OTYwNTcyNjQ2Mjk5NjE3OTY2OTEyNjEwMTcxMjEx.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=JHJ2OjEdZLkQ7kNvwHwrxta&_nc_oc=AdpRVmTmhaARgF-Nh1pwDWCInvQwl9iyrMo1465F2f036GWttqtQAvuy7fnUr6118D8&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=XuMfnOXatNcyEP-9t4S2jw&_nc_ss=7e6a8&oh=00_AQKwAxRUep91YDjS2ozAd4yOz4LgBeC1aNSjpasfI44mIA&oe=6AA6E834\",\"caption\":\"Membangun keluarga yang tanggap dan siap menghadapi risiko kebakaran dimulai dari pengetahuan, kewaspadaan, dan kesiapsiagaan bersama. \\n\\nKehadiran dan partisipasi Ibu Wali Kota Bekasi dan Wakil Wali Kota Bekasi selaku Ketua PKK dan Posyandu Se Kota Bekasi dalam kegiatan Pelatihan Keluarga Tanggap Kebakaran Rumah Tangga menjadi wujud nyata kepedulian terhadap keselamatan masyarakat.\\n\\nTidak hanya memberikan dukungan, Ibu Wali Kota dan Wakil Wali Kota juga menunjukkan semangat untuk belajar dan memahami penanggulangan kebakaran, mulai dari upaya pencegahan hingga langkah yang tepat dalam menghadapi keadaan darurat.\\n\\nsosok Ibu Wali Kota dan Wakil Wali Kota sebagai pemimpin yang peduli dan mau turun langsung belajar. Jadi, kalian jangan ragu ya untuk belajar😉\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@wiwiekhargono \\n@bramsum45 \\n@heryanto_suparjan \\n@kecamatan_bekasi_timur \\n@kelurahan_bekasijaya \\n@pemkot_bekasi \\n\\n#damkarkotabekasi\",\"post_time\":1788838089,\"owner\":\"65124131210\",\"username\":\"disdamkarmatkotabekasi.id\",\"comment_count\":0,\"like_count\":69,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/65124131210/DdAs6g7T4QU.jpg\"},{\"current_url\":\"https://www.instagram.com/disdamkarmatkotabekasi.id/?_showcaption=true\",\"snapshot_date\":1788938142205,\"id\":\"Dc_BygkzppG\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/798414202_17966817825171211_4540303402849093260_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=Mzk4MDkwODQ2NDYxNjQxMzc2NjE3OTY2ODE3ODIyMTcxMjEx.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=dg7qphUE8j4Q7kNvwEpjcc_&_nc_oc=AdpqjsFZVbEmXLQrnQNX6wAaBeuojj7X4mQTXCCzPLUfv-yEjt-ilCszpu9V66bRGf8&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=XuMfnOXatNcyEP-9t4S2jw&_nc_ss=7e6a8&oh=00_AQIqzOG0kuX-Mds5LIx0PcASZ8lcjU0LR-6oqUJWJrK1QQ&oe=6AA6F60B\",\"caption\":\"Petugas Pemadam Kebakaran dan Penyelamatan Kota Bekasi melaksanakan penyemprotan jalan yang terdampak abu vulkanik sebagai upaya mengurangi debu dan menjaga kebersihan serta kenyamanan lingkungan.\\n\\nPenyemprotan menggunakan eco enzyme sebagai bagian dari upaya penanganan abu vulkanik yang lebih ramah lingkungan.\\n\\nStay safe, warga Kota Bekasi! 💙\\nTetap waspada terhadap dampak abu vulkanik, gunakan masker saat beraktivitas di luar rumah, dan jaga kesehatan serta keselamatan bersama. \\n\\n@mastriadhianto @harris.bobihoe @pemkot_bekasi @bramsum45 @heryanto_suparjan\\n\\n#StaySafe #AbuVulkanik #KotaBekasiKeren #PemerintahKotaBekasi #DamkarIndonesia\",\"post_time\":1788781360,\"owner\":\"65124131210\",\"username\":\"disdamkarmatkotabekasi.id\",\"comment_count\":20,\"like_count\":223,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/65124131210/Dc_BygkzppG.jpg\"},{\"current_url\":\"https://www.instagram.com/disdamkarmatkotabekasi.id/?_showcaption=true\",\"snapshot_date\":1788938142205,\"id\":\"Dc-KHt4y6Dy\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/799346378_17937490119364141_4064760552317704823_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=104&ig_cache_key=Mzk4MDY2MzYzMTQxNDc5NjUzMDE3OTM3NDkwMTE2MzY0MTQx.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjExNzkuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=uWd29pDLnToQ7kNvwFl8Zgz&_nc_oc=AdrGL2ryq9nSDIfQy8PYW28tpNnGPfXsNnmNqx4Ch37YczhdrMJT_oouiG6vxJi0atc&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=XuMfnOXatNcyEP-9t4S2jw&_nc_ss=7e6a8&oh=00_AQIb787r9F15EnWUXFNd__pCsmE4DJY5HtYytQESfXUnqg&oe=6AA6DB8A\",\"caption\":\"Senin (07/09/2026) sekitar pukul 10.30 WIB, Damkar Kota Bekasi melakukan penyemprotan air di sepanjang Jalan Ahmad Yani. Penyemprotan dilakukan di tengah sebaran abu vulkanik yang mulai berdampak ke wilayah Bekasi.\\n\\n#ceritabekasi\",\"post_time\":1788752144,\"owner\":\"65124131210\",\"username\":\"disdamkarmatkotabekasi.id\",\"co