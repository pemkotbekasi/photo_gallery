ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQwMi5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=-fIuj8K8Cv4Q7kNvwEu1bso&_nc_oc=AdqwA-TetcATeTnTElYJUzbW_MBPZ-dfe_0FiU2H7NTvuf4zmuNBvj_5m0Peww1eIjc&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=EA7Rdk-VyJVCTjVOUA1f8Q&_nc_ss=7e2a8&oh=00_AQKidF0Qf0qm7lCtEgzRKYrq8rQ9p3uswk7M_18XbzZ9oA&oe=6AA8B085\",\"caption\":\"SEMANGAT HAORNAS 2026! \\n\\nDalam semangat Hari Olahraga Nasional (HAORNAS) 2026, Dinas Perhubungan Kota Bekasi turut mengajak seluruh masyarakat untuk terus membudayakan hidup aktif, sehat, dan bugar.\\n\\nOlahraga bukan sekadar aktivitas fisik, tetapi juga menjadi sarana untuk membangun kebersamaan, kedisiplinan, sportivitas, dan semangat berprestasi.\\n\\nSebagai bagian dari masyarakat Kota Bekasi, mari kita dukung bersama Kota Bekasi sebagai Tuan Rumah PORPROV XV Jawa Barat 2026.\\n\\nAyo berolahraga!\\nBersama membangun prestasi!\\nMasyarakat sehat, Indonesia kuat! \\nSukses Tuan Rumah, Sukses Prestasi!\\n\\nBekasi Keren, Berprestasi!\\nDari Bekasi untuk Jawa Barat, Lebih Juara!\\n\\n#DishubKotaBekasi #DinasPerhubunganKotaBekasi #HAORNAS2026 #HariOlahragaNasional #KotaBekasi\",\"post_time\":1789007515,\"owner\":\"4410364431\",\"username\":\"dishubbekasikota\",\"comment_count\":0,\"like_count\":17,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/4410364431/DdFxRWTp0Ar.jpg\"},{\"current_url\":\"https://www.instagram.com/dishubbekasikota/?_showcaption=true\",\"snapshot_date\":1789063296094,\"id\":\"DdFtAddJxAG\",\"image\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.82787-15/802778816_18425196217148432_3762743352736779002_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=103&ig_cache_key=Mzk4Mjc4NzM4OTE5OTY4MzU5MA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQwMi5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=enrttJ14WxIQ7kNvwH825eK&_nc_oc=AdqDqWX2avTR1be2tXqVAH3gv9NJSh8mU5b01sBr03rPtibSVIll24NBE3rnHMQhwUQ&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=EA7Rdk-VyJVCTjVOUA1f8Q&_nc_ss=7e2a8&oh=00_AQL_Yvy9VuDLr4FttzkjPxToetx0MLA8QKjISJZkB28kYQ&oe=6AA8D2AA\",\"caption\":\"Halo Sobat Perhubungan, Sahabat Terang Kota Bekasi! 👋\\n\\n🚫 TOLAK GRATIFIKASI DALAM BENTUK APA PUN!\\n\\nDinas Perhubungan Kota Bekasi berkomitmen untuk terus memberikan pelayanan yang bersih, transparan, profesional, dan berintegritas, serta bebas dari praktik gratifikasi.\\n\\nGratifikasi dapat berupa uang, barang, hadiah atau bingkisan, fasilitas perjalanan atau wisata, diskon, jamuan makan, maupun keuntungan lainnya, baik secara langsung maupun tidak langsung, yang berkaitan dengan jabatan dan berpotensi bertentangan dengan kewajiban atau tugas.\\n\\nMari bersama-sama membangun budaya integritas dan pelayanan publik yang bersih.\\nJangan memberi dan jangan menerima gratifikasi.\\n\\nTOLAK | LAPORKAN | BERSAMA KITA WUJUDKAN PELAYANAN PUBLIK YANG BERSIH DAN BERINTEGRITAS. ✨\\n\\n💙 Transportasi Bersih, Kota Bekasi Lebih Baik.\\n\\n#DishubKotaBekasi #TolakGratifikasi #AntiGratifikasi #berakhlak\",\"post_time\":1789005307,\"owner\":\"4410364431\",\"username\":\"dishubbekasikota\",\"comment_count\":6,\"like_count\":52,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/4410364431/DdFtAddJxAG.jpg\"},{\"current_url\":\"https://www.instagram.com/dishubbekasikota/?_showcaption=true\",\"snapshot_date\":1789063296094,\"id\":\"DdFltRsE6Sm\",\"image\":\"https://scontent-sjc6-1.cdninstagram.com/v/t51.82787-15/801882194_18425189944148432_5105971598875468961_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=102&ig_cache_key=Mzk4Mjc1NTExMzQ1NDEzNDM1OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTI3OC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=o7_knb-JTDIQ7kNvwFe4xn-&_nc_oc=AdoHLRH8NT2ZHhUb91fyFbAi0VUYMUzA7dzwQcISAUfJi59eHKpMIedtclGfdMt5vI0&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=EA7Rdk-VyJVCTjVOUA1f8Q&_nc_ss=7e2a8&oh=00_AQLHcaCf9_v5IS0oUSLFFsNL8ymBFDGcLFta8mR8ohrCQQ&oe=6AA8D8F2\",\"caption\":\"Halo Sobat Perhubungan, Sahabat Terang Kota Bekasi! 👋\\n\\nDalam upaya menciptakan kawasan yang tertib, aman, dan nyaman, Dinas Perhubungan Kota Bekasi melaksanakan penertiban rutin serta pemasangan spanduk larangan parkir di kawasan Pasar Baru, sejak Rabu malam hingga Kamis pagi, 10 September 2026.\\n\\nPetugas turut mengarahkan pengendara untuk memanfaatkan lokasi parkir yang telah disediakan, serta memberikan imbauan kepada para pedagang agar bersama-sama menjaga ketertiban dan kelancaran aktivitas di kawasan Pasar Baru.\\n\\nTerhadap kendaraan yang parkir secara liar dan tidak diketahui pemiliknya, petugas melakukan tindakan pencabutan pentil ban sebagai bagian dari penertiban.\\n\\nMari bersama-sama wujudkan Pasar Baru yang lebih tertib, nyaman, dan lancar dengan mematuhi aturan parkir dan menggunakan fasilitas parkir yang telah tersedia. 🚦\\n\\nTertib Parkir, Lancar Aktivitas, Nyaman Kotanya.\\n\\n#DishubKotaBekasi #InfoLalinBekasi #BekasiTertib #ParkirTertib #PasarBaruBekasi SahabatTerang\",\"post_time\":1789001449,\"owner\":\"4410364431\",\"username\":\"dishubbekasikota\",\"comment_count\":0,\"like_count\":42,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/4410364431/DdFltRsE6Sm.jpg\"},{\"current_url\":\"https://www.instagram.com/dishubbekasikota/?_showcaption=true\",\"snapshot_date\":1789063296094,\"id\":\"DdEi_mOjzhF\",\"image\":\"https://scontent-sjc6-1.cdninstagram.com/v/t51.82787-15/801952125_17993830824010496_2459734315047264015_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=102&ig_cache_key=Mzk4MjQ2MTQyNTgxMjMyNzAxNA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=2X15mgwzKNAQ7kNvwH-IyUk&_nc_oc=AdpqgFgk_3EV30DZnpNqpKnzci6kk-QDWFQkNveQTB5bVOOzBZQEiKy0P5a6h12b7x0&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=EA7Rdk-VyJVCTjVOUA1f8Q&_nc_ss=7e2a8&oh=00_AQIPWNj8KnWUeEndPlJBT_URErVxSe9bECM-jN8u9R_fhQ&oe=6AA8C860\",\"caption\":\"Sobat Teranggg!💡\\n\\n📌Pada hari Rabu, 09 Sep