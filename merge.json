=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=YwSwkiy3u-QQ7kNvwFeLJ_7&_nc_oc=AdqLAuL_3ia3Rq6qAhd-29hLsMK2nIWK_-UQ2a6_HbWWnjVW9z7o5mwKugFPTly4sOE&_nc_zt=23&_nc_ht=scontent-lhr6-1.cdninstagram.com&_nc_gid=Y474BEksk1Awp4mXpxuS1A&_nc_ss=7e6a8&oh=00_AQK_7SY5Sf6OAb-7pcXyrneBs7__av5T9HrC2smA26YPnQ&oe=6AA6C1C0\",\"caption\":\"Pendistribusian Bantuan Pangan Bulog Tahun Anggaran 2026.\\nKelurahan Bojong Rawalumbu melaksanakan Pendistribusian Bantuan Pangan Bulog 2026 yang dilaksanakan Kamis, 03 September 2026 berlokasi di Aula Kantor Kelurahan Bojong Rawalumbu.\\nKegiatan ini dimonitoring oleh Lurah serta Kasi Kesos Kelurahan Bojong Rawalumbu agar pendistribusian berjalan lancar aman dan tertib tidak ada penumpukan penerima bantuan .\\nBantuan ini di terima oleh masing-masing KPM yaitu sebanyak 30 Kg atau setara 3 karung beras.\\nBantuan Pangan ini sangat amat bermanfaat untuk penerima dari keluarga tidak mampu.\\n@mastriadhianto @pemkot_bekasi @diskominfobekasi @warjan1872 @kodir9359\",\"post_time\":1788442386,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":0,\"like_count\":13,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/Dc06wg7NqWk.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938188407,\"id\":\"DcxXDy6s8pR\",\"image\":\"https://scontent-lhr6-1.cdninstagram.com/v/t51.71878-15/790590628_1085048647819878_4061945168969407976_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=103&ig_cache_key=Mzk3NzA2MTM2MTg0NDk5NjY4OQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=XI3HJynS6csQ7kNvwHAZaCD&_nc_oc=AdoxG-VSD3KsiC1y7uf_-d1MIoPRnPGFrnSIqy2fMV9evWqleBmCAG6KPD06TZ47v4Q&_nc_zt=23&_nc_ht=scontent-lhr6-1.cdninstagram.com&_nc_gid=Y474BEksk1Awp4mXpxuS1A&_nc_ss=7e6a8&oh=00_AQIwanuSobL9dBovByZLlFDiUh0NwOQCoCA16uabLp7KwQ&oe=6AA6D5B9\",\"caption\":\"Kelurahan Bojong Rawalumbu mengikuti kegiatan \\nPESONA NUSANTARA BEKASI KEREN JILID III .\\nkegiatan pagelaran seni budaya dan tarian Nusantara, Minggu 30; Agustus 2026 .\\nKegiatan PNBK juga dirangkaikan dengan penggalang Dana untuk masyarakat terdampak bencana di Kalimantan dan Nusa Tenggara Timur (NTT).\\n@mastriadhianto @pemkot_bekasi @diskominfobekasi @warjan1872\",\"post_time\":1788322787,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":0,\"like_count\":4,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/DcxXDy6s8pR.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938188407,\"id\":\"DciP0SGvGYE\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/787244120_2880091072390980_4701676836165305291_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk3MjgwNzM4NDg0NTAxODYyODIyNjEwMDcyNDc5OTE4ODc%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=aTEEGB7Fai0Q7kNvwGrXUzK&_nc_oc=AdoimEz5wQM-a7ZmNNs2sauBLrDLrO3f11bYoRit1f61rWFjfH-dxYvKKwSlxKqE97A&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=Y474BEksk1Awp4mXpxuS1A&_nc_ss=7e6a8&oh=00_AQKUPUAC-mXKN0s-UHE5XfIG_rzOu3pZ_BYqppzA1zazEw&oe=6AA6F26F\",\"caption\":\"Satu langkah besar untuk bumi yang lebih sehat 🌎✨, Hari ini telah dilaksanakan Ground breaking PSEL Kota Bekasi lewat teknologi Waste-to-Energy, sampah warga Bekasi bakal diolah menjadi energi listrik yang bermanfaat.\\nBukan sekedar ceremonial Ground breaking PSEL Kota Bekasi juga menjadi komitmen kita untuk generasi masa depan, Proyek ini hadir untuk mengurangi beban Tempat Pembuangan Sampah (TPA) dan menciptakan lingkungan hidup yang lebih layak.\\nYuk dukung terus aksi hijau mulai dari rumah dengan mengurangi sampah plastik ♻️🔋.\\nkota Bersiz Warganya Sehat, energinya melimpah !!! \\n#PSELBekasi #WasteToEnergi\\n\\n@mastriadhianto @prokopim.kotabekasi @diskominfobekasi @pemkot_bekasi @kecrawalumbu @warjan1872\",\"post_time\":1787816152,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":0,\"like_count\":7,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/DciP0SGvGYE.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938188407,\"id\":\"DcfZksik5T-\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/786818504_18118145375484034_3351727992795919320_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=111&ig_cache_key=Mzk3MjAwNTA1MTY4NjEyMzM1Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=0VsWRljIt8sQ7kNvwH14JWt&_nc_oc=AdoY0bCfdGfjZgSD7zYQr1nGZXum7anHGI5GmAr7ShIzBPa92GttYVIbN6DUJ3bI2mk&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=Y474BEksk1Awp4mXpxuS1A&_nc_ss=7e6a8&oh=00_AQKRIYFc59W4saEIBzyt9SFYUWC_4RfMOCGxKP0kSfraDg&oe=6AA6C69A\",\"caption\":\"🌱 APEL GEBRAK KOTA BEKASI 🌱\\nGerakan Energi Bersih, Reduksi Sampah, Aksi Pilah, Kolaborasi Inovatif\\n\\nSebagai rangkaian Ground Breaking Pengolahan Sampah menjadi Energi Listrik (PSEL) Kota Bekasi, Apel GEBRAK menjadi momentum untuk memperkuat komitmen bersama dalam mewujudkan pengelolaan sampah yang lebih modern, berkelanjutan, dan memberikan manfaat bagi masyarakat.\\n\\n♻️ Energi Bersih untuk masa depan\\n🗑️ Reduksi Sampah mulai dari sumbernya\\n🔄 Aksi Pilah demi lingkungan yang lebih sehat\\n🤝 Kolaborasi Inovatif untuk Bekasi yang lebih bersih dan berkelanjutan\\n\\nMari bersama-sama membangun budaya pilah sampah dari rumah, mengurangi sampah, dan mendukung transformasi sampah menjadi energi.\\n\\nGEBRAK! Bergerak Bersama, Kelola Sampah, Ciptakan Energi, Wujudkan Bekasi Bersih dan Berkelanjutan! 💚⚡\\n\\n#ApelGEBRAK #GEBRAKKotaBekasi #PSELKotaBekasi #PengelolaanSampah #EnergiBersih PilahSampah BekasiBersih BekasiBerkelanjutan KotaBekasi\",\"post_time\":1787720019,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":1,\"like_count\":5551,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/DcfZksik5T-.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938188407,\"id\":\"DcduNZwsrfi\",\"image\":\"https://scontent-lhr6-1.cdninstagram.com/v/t51.82787-15/786150822_18135812833610457_1715142365756456790_n.webp?_nc_cat=102&ig_cache_key=Mzk3MTUzMzY3NzU2MzkxODMwNg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=jglAgYWxB9oQ7kNvwEBn111&_nc_oc=AdrY1rtDjd8dDFGahInj8k6xBwUlNNT7zuyuX0pV7hus1nAbwGBYOb2H6mjBgMoEkw4&_nc_zt=23&_nc_ht=scontent-lhr6-1.cdninstagram.com&_nc_gid=Y474BEksk1Awp4mXpxuS1A&_nc_ss=7e6a8&oh=00_AQLQxfUmJJf1UOLBxh7OXQs-bmZ-MRR4dqs1CL-haXGcPA&oe=6AA6C5DA\",\"caption\":\"SELANGKAH LAGI, BEKASI MENUJU KOTA YANG LEBIH BERSIH DAN ASRI! ♻️⚡\\n\\nHari yang dinantikan semakin dekat! Groundbreaking PSEL (Pengelolaan Sampah Menjadi Energi Listrik) akan segera dilaksanakan sebagai langkah besar Kota Bekasi dalam mewujudkan pengelolaan sampah yang lebih modern, berkelanjutan, dan bermanfaat bagi masyarakat.\\n\\n📅 26 Agustus 2026\\n🕢 07.30 WIB - Selesai \\n📍 Kec. Bantargebang, Kel. Cikiwul, Kota Bekasi\\nAlamat: TAMAN POLDER CIKETINGUDIM, Jl. Kp. Ciketing Udik, RT.001/RW.003, Ciketing Udik, Kec. Bantar Gebang, Kota Bks, Jawa Barat 17153\\n\\nDari tumpukan sampah, kita bergerak menuju masa depan yang lebih baik. 💚\\nMelalui PSEL, sampah tidak hanya dipandang sebagai masalah, tetapi juga sebagai potensi energi untuk mendukung lingkungan yang lebih bersih dan kota yang lebih berkelanjutan.\\n\\n✨ Besok bukan sekadar groundbreaking.\\nBesok adalah awal dari langkah nyata menuju Indonesia yang bersih dan asri, dimulai dari Kota Bekasi.\\n\\nMari bersama-sama dukung perubahan ini.\\nBekasi Bersih, Bekasi Asri, Bekasi Hebat! 💚\\n\\n@mastriadhianto @pemkot_bekasi @diskominfobekasi @kecrawalumbu\",\"post_time\":1787663733,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":0,\"like_count\":0,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/DcduNZwsrfi.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938188407,\"id\":\"Dccwy1jPSnq\",\"image\":\"https://scontent-lhr6-2.cdninstagram.com/v/t51.71878-15/784617636_1531096904988875_2651033316876647857_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=105&ig_cache_key=Mzk3MTI2MzU3MTEzOTgzMjI5ODE5MjM4MTE1NzQ5MTg2Njc%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=AX8PwQ6xbUAQ7kNvwGmiimS&_nc_oc=AdrKiBlzMy7-6LiCNiwmgUVCt2bb72S0ja_pyRcShyZGMbGUNicSt5X5DwS0Y3xJFoA&_nc_zt=23&_nc_ht=scontent-lhr6-2.cdninstagram.com&_nc_gid=Y474BEksk1Awp4mXpxuS1A&_nc_ss=7e6a8&oh=00_AQJjNdZRLoUTYoEGvqLeLNPd-HWi-Gvyp0uGIsWJScQxjQ&oe=6AA6F092\",\"caption\":\"Aparatur Kelurahan Bojong Rawalumbu mengucapkan \\nSelamat Memperingati Maulid Nabi Muhammad SAW.\\nMari meneladani akhlak Rasulullah menjadi pribadi yang lebih baik dan membawa Rahmat bagi semesta.\\n12 Rabi'ul Awal 1448 H\\n@mastriadhianto @pemkot_bekasi @prokopim.kotabekasi @diskominfobekasi @warjan1872\",\"post_time\":1787631787,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":0,\"like_count\":6,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/Dccwy1jPSnq.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938190595,\"id\":\"DcbqnD5AA36\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/785689356_2160549047908584_6408559323591319150_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=110&ig_cache_key=Mzk3MDk1NDg5ODY0NzgxMzYyNjE0NDE4NzM3MDEzMjk5MDA%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=acnOoV50yIwQ7kNvwG71hry&_nc_oc=Ado0oX4H17NY-cTJDh01Xmy0ZyymkYzx_KXc6APNNI66OSktvnQAVatopIQwzmvE-YM&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=5JETWEvfNco5l9NGD4R92w&_nc_ss=7e6a8&oh=00_AQKE2Jt3HGGtg7pxELJHjfV-zyGrtrm2Mji8uneMFbPvjQ&oe=6AA6E989\",\"caption\":\"Kegiatan Penertiban, Pencopotan, dan Pengamanan Spanduk,Baliho atau banner yang melanggar aturan di Wilayah Kelurahan Bojong Rawalumbu.\\nKegiatan dipimpin langsung oleh Lurah Bojong Rawalumbu dan Satlinmas Kelurahan yang memulai titik di sepanjang Jalan Raya Siliwangi Wilayah Kelurahan Bojong Rawalumbu meliputi diarea  tiang listrik dan pohon-pohon sepanjang jalan Raya Siliwangi.\\nKegiatan Penertiban dan pengamanan spanduk dan banner melanggar aturan ini di laksanakan secara berkala disaat kondisi pelanggaran meningkat.\\nDilakukan penertiban dan pengamanan ini adalah adanya baliho, banner yang tidak memiliki izin  yang dapat merusak keindahan Kota.\\nSeluruh Aparatur Kelurahan beserta Satlinmas menyisir lokasi penertiban menggunakan perlengkapan seadanya dan mengangkut barang bukti berupa spanduk/ baliho melanggar hukum ke kelurahan.\\nAyo jaga selalu kebersihan dan keindahan Lingkungan sekitar.\\n@mastriadhianto \\n@pemkot_bekasi \\n@diskominfobekasi \\n@kecrawalumbu \\n@warjan1872 \\n@kodir9359\",\"post_time\":1787595458,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":0,\"like_count\":14,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/DcbqnD5AA36.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938190595,\"id\":\"DcbpVW7MiU2\",\"image\":\"https://scontent-lhr6-1.cdninstagram.com/v/t51.71878-15/785281336_38850420987878186_72897322063683432_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=102&ig_cache_key=Mzk3MDk0OTI4NDA4ODY1MzExMDEwNTUwNzk0ODA3NTEwNzY%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=4Wx-TX5rXegQ7kNvwFNSB-s&_nc_oc=AdqlIZPV8HY6LcvgFZdfqwZZdvewDpErisFfEa-qARxIIjbapTCyJoaeXTvb_030u74&_nc_zt=23&_nc_ht=scontent-lhr6-1.cdninstagram.com&_nc_gid=5JETWEvfNco5l9NGD4R92w&_nc_ss=7e6a8&oh=00_AQLI3eWGzl9aszySemx8NY3zFqrWOK6VM1XWc0Og_PZ_8Q&oe=6AA6F444\",\"caption\":\"Rangkaian Peringatan HUT ke 81 Republik Indonesia.\\nDalam semarak kegiatan peringatan HUT ke 81  RI, Lurah Bojong Rawalumbu hadir didalam beberapa kegiatan tingkat RW dan Perwakilan Jajaran Kepala Seksi di Kelurahan Bojong Rawalumbu.\\nKegiatan peringatan HUT ke 81 RI sebagai wadah kekompakan dan mempererat hubungan antar warga masyarakat di Sekitaran RW di Wilayah Kelurahan Bojong Rawalumbu.\\n\\n#hutri81indonesia🇮🇩 \\n@mastriadhianto \\n@harris.bobihoe\\n@prokopim.kotabekasi \\n@diskominfobekasi \\n@kecrawalumbu\\n@warjan1872 \\n@kodir9359 \\n@asmah.aas73\",\"post_time\":1787594436,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":0,\"like_count\":5,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/DcbpVW7MiU2.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938190595,\"id\":\"DcYblN3hmPd\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/782582088_1590008389146644_4321557367726652184_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=Mzk3MDA0NDM3NjI5MzcyOTI0NTEzNjQ4NjQ2MDg1ODEyNDE%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=v0dNxaQtRgoQ7kNvwEVcnNx&_nc_oc=Ado69g-41WR7Ts3zUeRqpF6yGwkmyiFUKeRlORhy4fRCVuGbezkw7X55QfmFAoR-xrg&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=5JETWEvfNco5l9NGD4R92w&_nc_ss=7e6a8&oh=00_AQKN7hoZpuQlIaKnwx17m3CMftoOpyIA38FTsJHMWO6Bmw&oe=6AA6CC8F\",\"caption\":\"Lurah Bojong Rawalumbu menghadiri kegiatan peringatan HUT PAN yang di hadiri oleh Wali Kota Bekasi, sekaligus membuka kegiatan senam bersama warga Masyarakat yang  berlokasi di Pasar Segar RW 01 Kelurahan Bojong Rawalumbu sekaligus \\nKegiatan lanjutan Lurah Bojong Rawalumbu membuka secara resmi kegiatan lomba senam dan Mancing gratis yang dilaksanakan oleh Ketua RW 02 Kelurahan Bojong Rawalumbu dengan pengurus RT dan  Karang Taruna wilayah, ajang perlombaan ini menjadi momentum untuk saling bersinergi dalam kegiatan kewilayahan.\\n\\n@mastriadhianto\\n@pemkot_bekasi @prokopim.kotabekasi @warjan1872\",\"post_time\":1787486416,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":0,\"like_count\":10,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/DcYblN3hmPd.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938190595,\"id\":\"DcXkemOuMs5\",\"image\":\"https://scontent-lhr6-2.cdninstagram.com/v/t51.82787-15/782208148_18135576715610457_8009847373820266705_n.webp?_nc_cat=109&ig_cache_key=Mzk2OTgwMjAyODg1ODI2NDM3Nw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=wOllNGbJ-QkQ7kNvwFH1g_6&_nc_oc=Adri5HfiQ5VTXSFKCCgXL1KFjXDYIPKh80FOeGKUrj7GLxLUaeBjk4IcewLuDeA_zJs&_nc_zt=23&_nc_ht=scontent-lhr6-2.cdninstagram.com&_nc_gid=5JETWEvfNco5l9NGD4R92w&_nc_ss=7e6a8&oh=00_AQI6Ye86_GofJiFdxBx5BewS7Hmq8i6FGAS-jvBIRvloRQ&oe=6AA6C49A\",\"caption\":\"*NANTIKAN! RIDHO BERPECI SPECIAL EDITION!*\\n\\nKali ini RIDHO BERPECI mempersembahkan edisi spesial bertemakan: *_Soft Launching Aplikasi SICANTIK_ - Kemudahan Administrasi Terpadu Keluarga*.\\n\\nDi episode kali ini, spesial akan diluncurkan *Aplikasi SICANTIK: Sistem Catatan Administrasi dan Nilai Terpadu Informasi Keluarga* yang diinisiasi oleh Dinas Pemberdayaan Perempuan dan Perlindungan Anak (DPPPA) Kota Bekasi bersama TP. PKK Kota Bekasi. \\n\\nApa itu Aplikasi SICANTIK? di RIDHO BERPECI SPECIAL EDITION akan lengkap dijelaskan oleh para narasumber, yakni Ridwan AS, S.H, M.Si selaku kepala DPPPA Kota Bekasi, Wiwiek Hargono Tri Adhinato selaku Ketua TP. PKK Kota Bekasi, dan Paras Sujiwo, S.Si, M.M yang akan tayang pada: \\n\\n🗓️Minggu, 23 Agustus 2026\\n🕣15.30 s.d 17.00 WIB\\nTayang melalui Live Streaming YouTube Pemerintah Kota Bekasi dan melalui Zoom Meeting.\\n\\nYuk! Catat tanggalnya dan ikut serta dalam RIDHO BERPECI: RIDHO bersama untuk pecahkan masalah dan mencari solusi.\\n\\n#kotabekasi \\n#kotapatriot \\n#kotabekasikeren \\n#bekasikerenmenujukotaglobal \\n#ridhoberpeci\\n\\n@mastriadhianto @pemkot_bekasi @diskominfobekasi @warjan1872\",\"post_time\":1787457304,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":0,\"like_count\":1,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/DcXkemOuMs5.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938190595,\"id\":\"DcQr5lzNG7T\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/775667486_18135313888610457_4765391044071581783_n.webp?_nc_cat=101&ig_cache_key=Mzk2Nzg2NDM0NTMxMTA4MDE0Nw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=Muj_KgF1c0QQ7kNvwGZWpUA&_nc_oc=AdpqewrZiM5iUAfx-grQNZuCqhqdqj6PiExvYTbTnu2LEIi8llyH6Z7EEkOm7JY-JVQ&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=5JETWEvfNco5l9NGD4R92w&_nc_ss=7e6a8&oh=00_AQL0ygd6tly7KMcmyUYal7PqObdlh3smgeJIzuChwbf74A&oe=6AA6CA18\",\"caption\":\"Haloo warga masyarakat Kelurahan Bojong Rawalumbu.\\nMari sukseskan kegiatan PORPROV XV Jawa Barat 2026 di Kota Bekasi\\nDari Kita Untuk Jawa Barat Dari Bekasi Untuk Prestasi🔥\\n\\n@mastriadhianto @pemkot_bekasi @diskominfobekasi @warjan1872\",\"post_time\":1787226314,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":4,\"like_count\":14,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/DcQr5lzNG7T.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938190595,\"id\":\"DcOJF01wwDg\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/777592053_27599189453116350_6178407221437276333_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk2NzE0ODMwNDUxMjUxNjMyMDIyNjcwMTMxNTc0NTMxMzE%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=1U9yInZV8UsQ7kNvwHjemaw&_nc_oc=AdoH3t4s31EGpGVe22eEk3hZiNiyymkVzzthI8k7XM5yPWTZsVj_Tp1PSAkNRbquxqM&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=5JETWEvfNco5l9NGD4R92w&_nc_ss=7e6a8&oh=00_AQIjs_HMwm--XODRZTnIsM7slmmm2Jjwd5JqxfN7t1icPQ&oe=6AA6D655\",\"caption\":\"Semangat Berlomba dalam rangka perayaan HUT RI Ke 81 Tingkat Kecamatan Rawalumbu.\\nBerlomba adalah salah satu tradisi dalam peringatan HUT RI 🇮🇩 , begitu juga dengan Aparatur Kelurahan Bojong Rawalumbu yang ikut melaksanakan kegiatan Perlombaan Seperti Gerak Jalan dan Lomba Sepak Bola Perempuan antar OPD.\\nDalam kegiatan perlombaan Lurah Bojong Rawalumbu  mendampingin dan memberikan support kepada para aparatur yang mengikuti kegiatan perlombaan antar Kecamatan Rawalumbu.\\nBentuk Apresiasi dari Kecamatan Rawalumbu dalam kegiatan perlombaan yang diberikan kepada kelurahan Bojong Rawalumbu adalah Penerima Juara 2 Lomba menghias Gapura Tingkat Kecamatan Rawalumbu yaitu RW 14 Taman Narogong Indah.\\n@mastriadhianto\\n@pemkot_bekasi @diskominfobekasi @prokopim.kotabekasi @warjan1872\",\"post_time\":1787141498,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":0,\"like_count\":11,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/DcOJF01wwDg.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938190595,\"id\":\"DcJHIJvzZrb\",\"image\":\"https://scontent-lhr6-2.cdninstagram.com/v/t51.82787-15/774906379_18117043670484034_989055022564804342_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=105&ig_cache_key=Mzk2NTczMjI5MzQyMzUwNDA5MTE4MTE3MDQzNjY0NDg0MDM0.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEzMjAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=z4EL9WONXIIQ7kNvwH_0n9E&_nc_oc=Adouy4SHoAZK38yMvZOAY9nCuQ9o5rXxhCn7SlYcdqJzz_vrUTXLxncFQtS7nCXsIMY&_nc_zt=23&_nc_ht=scontent-lhr6-2.cdninstagram.com&_nc_gid=5JETWEvfNco5l9NGD4R92w&_nc_ss=7e6a8&oh=00_AQJ9sAKFDhhH0w8mRYBDa6rasFMio-v_-92FcjDV8B-OMQ&oe=6AA6F55C\",\"caption\":\"🇮🇩 KHIDMAT, SEMANGAT, DAN CINTA TANAH AIR 🇮🇩\\n\\nDalam suasana penuh khidmat dan semangat nasionalisme, Kecamatan Rawalumbu melaksanakan Upacara Peringatan Hari Ulang Tahun ke-81 Kemerdekaan Republik Indonesia Tahun 2026 bertempat di Plaza Kantor Kecamatan Rawalumbu.\\n\\nUpacara menjadi momentum untuk mengenang jasa para pahlawan sekaligus memperkuat semangat persatuan, gotong royong, dan pengabdian dalam memberikan pelayanan terbaik kepada masyarakat.\\n\\n🇮🇩 Dirgahayu Republik Indonesia ke-81!\\nBersatu, Berdaulat, Maju, dan Sejahtera.\\n\\nMari terus kobarkan semangat kemerdekaan dengan bekerja nyata, menjaga persatuan, dan bersama-sama membangun Kecamatan Rawalumbu yang semakin maju, harmonis, dan melayani.\\n\\nMerdeka! Merdeka! Merdeka! 🇮🇩❤️🤍\\n\\n#HUTRI81 #HUTRI2026 #KemerdekaanRI #DirgahayuIndonesia #KecamatanRawalumbu Rawalumbu KotaBekasi BekasiKeren SemangatKemerdekaan IndonesiaMaju\",\"post_time\":1786972239,\"owner\":\"18260210456\",\"username\":\"kel_bojongrawalumbu\",\"comment_count\":0,\"like_count\":109,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/18260210456/DcJHIJvzZrb.jpg\"},{\"current_url\":\"https://www.instagram.com/kel_bojongrawalumbu/?_showcaption=true\",\"snapshot_date\":1788938190595,\"id\":\"DcHdPTXzNf4\",\"