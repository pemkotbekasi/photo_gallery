jQ0MDExODMyNjA3Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTQ0MC5zZHIuQzMifQ%3D%3D&_nc_ohc=JJ5B1v6QVEUQ7kNvwHuJLL0&_nc_oc=AdlotK_NklBK-8zbCCRTJMH6aNWfmbpAT5l1Hz0BAlbMSAhqF4sgL6peRjGZ21gPrxs&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=8ntfphXnx_wMcuPlYTQyyQ&_nc_ss=8&oh=00_Afw6DZnl_P5y_Aehpg4bLLdSVHEKINmw9Owgws9BcFjLPA&oe=69AC7542\",\"caption\":\"Pray For Sumatra \\n\\n@mastriadhianto\\n@harris.bobihoe\\n@pemkot_bekasi\\n@diskominfobekasi\\n@dewi.astiyanti\",\"post_time\":1765283230,\"owner\":\"10847474028\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/10847474028/3783792440118326073_10847474028.jpg\"},{\"id\":\"DR6bTN3j2ql\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.71878-15/589808964_742572638860190_5689203650485569210_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzc4MTQ1NDkwNDk0NzYwMDAzNw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM2LnNkci5DMyJ9&_nc_ohc=rDhmOmwRp_0Q7kNvwF2ThVd&_nc_oc=Adkhby5OUL_BkkWrC9KsejAMAlYg9_xUdKg_DON4ic0vjYHj8xc3HNCnUy4K-vVgFDc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=8ntfphXnx_wMcuPlYTQyyQ&_nc_ss=8&oh=00_Afz7Tzi-Hs7Oiha-GGQBtGHREvSdf4L7DrC3gqISgj1jng&oe=69AC6E1C\",\"caption\":\"KEGIATAN MANJAKAN PELAYANAN\\nSABTU, 06 DESEMBER 2025\\nKantor Kecamatan Bekasi Barat\\n\\nDalam rangka memberikan pelayanan terbaik bagi masyarakat, Kecamatan Bekasi Barat kembali melaksanakan program Manjakan Pelayanan pada Sabtu, 06 Desember 2025. Kegiatan ini digelar di Kantor Kecamatan Bekasi Barat sebagai wujud komitmen aparatur dalam menghadirkan pelayanan yang cepat, ramah, dan responsif meskipun di hari libur.\\n\\nMelalui program ini, berbagai jenis layanan administrasi kependudukan seperti pembuatan Kartu Keluarga, perekaman dan pencetakan e-KTP, layanan Akta Kelahiran maupun Kematian, penerbitan SKTM, serta layanan informasi umum, dibuka untuk memudahkan warga yang tidak sempat mengurus dokumen pada hari kerja.\\n\\nAparatur Kecamatan Bekasi Barat hadir sejak pagi untuk memastikan proses pelayanan berjalan lancar. Dengan prinsip sopan, ramah, dan berakhlak, kegiatan Manjakan Pelayanan terus menjadi bukti nyata bahwa kecamatan berkomitmen mendekatkan layanan kepada masyarakat dan memberikan pengalaman pelayanan yang mudah serta nyaman.\\n\\nProgram ini diharapkan dapat terus meningkatkan kualitas pelayanan publik serta memperkuat hubungan baik antara pemerintah kecamatan dan masyarakat Bekasi Barat.\\n\\n#opinipublikbekasi2025\\n#pelayananpublik \\n#berakhlak #kecamatanbekasibarat \\n#banggamelayanibangsa \\n\\n@mastriadhianto @harris.bobihoe @dewi.astiyanti @disdukcapilkotabekasi @pemkot_bekasi @diskominfobekasi\",\"post_time\":1765004816,\"owner\":\"10847474028\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/10847474028/3781454904947600037_10847474028.jpg\"},{\"id\":\"DR38aoAj_-G\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.71878-15/589905095_865977485893048_2838672271327191930_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=Mzc4MDc1NjEyNDY1Njk5MjEzNA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM2LnNkci5DMyJ9&_nc_ohc=LrsZ9m4n8T0Q7kNvwFxV-m6&_nc_oc=AdkhHiJe-SaH4ROBPwvQUkYiXEYIoZPQLSDYk8toMXlnvCi9FCp3Kbl0aCPU3MmVsO8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=8ntfphXnx_wMcuPlYTQyyQ&_nc_ss=8&oh=00_AfxAFtUQnYkBHTe3JyPNTPLTl3pTBBgTaUS6scVsWDeT4w&oe=69AC9205\",\"caption\":\"Kunjungan Walikota Bekasi @mastriadhianto\\nMenghadiri Kunjungan Pelantikan Jatman Kota Bekasi.\\n\\nBertempat Gedung Jatman Kota Bekasi Kranji.\\n\\nJumat 05 Desember 2025.\\n\\n@mastriadhianto\\n@harris.bobihoe\\n@pemkot_bekasi\\n@diskominfobekasi\\n@dewi.astiyanti\",\"post_time\":1764921331,\"owner\":\"10847474028\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/10847474028/3780756124656992134_10847474028.jpg\"},{