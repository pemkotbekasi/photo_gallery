cD1BwA&_nc_ss=7a22e&oh=00_Af9ASWCRRvPK1V1QrvWugv-7QOwb4jlrnthIQggHPuVBMg&oe=6A2C7C11\",\"caption\":\"Halo Sahabat Disdik Kota Bekasi.\\nada kabar baik nih, Kota Bekasi melalui Dinas Pendidikan menyediakan beasiswa ke sekolah swasta bagi kalian Calon Peserta Didik kurang mampu yang belum bisa masuk sekolah negeri pada SPMB kemarin. untuk syarat dan ketentuannya cek video berikut ini ya\\n\\nCc, @mastriadhianto @diskominfobekasi @alexander.zulkarnain.9406 @ws_0611 \\n\\n#DisdikUpdate #SPMBTahun2025/2026 #BeasiswaSwasta #SekolahDimanaSajaSama\",\"post_time\":1752031519,\"owner\":\"3668578984\",\"username\":\"disdik_kota_bekasi\",\"comment_count\":38,\"like_count\":211,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/3668578984/DL3y3uFJW2E.jpg\"},{\"current_url\":\"https://www.instagram.com/disdik_kota_bekasi/?_showcaption=true\",\"snapshot_date\":1780919048961,\"id\":\"DZJ_bs9iV0Z\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/715079126_18267674911293420_5240178372033615833_n.jpg?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=106&ig_cache_key=MzkxMTkzNjczMTk4MTExMDU1Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=T6F3E8V9JMgQ7kNvwEgvzbs&_nc_oc=Adrd8LUxHbxlC11AWi4LR-DCHLEimRIMNwmaJ-OtxtvTkuM1qvuKEiy5uHIMroZXmfQ&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=K-nXRND2Hf8chEJ8cD1BwA&_nc_ss=7a22e&oh=00_Af9tu7h8JfO-9xtgif4rosWlBy5rlqSBId8QVLbTV2enUQ&oe=6A2C9577\",\"caption\":\"📢 SPMB 2026 Bersih Tanpa Gratifikasi! 📢\\n\\nPenerimaan peserta didik baru harus dilaksanakan secara objektif, transparan, akuntabel, dan sesuai dengan peraturan yang berlaku. Tidak ada alasan untuk memberikan ataupun menerima gratifikasi dalam bentuk apa pun terkait proses SPMB.\\n\\n🚫 Jangan Titip, Jangan Memberi!\\n🚫 Jangan meminta atau menerima hadiah, uang, bingkisan, maupun fasilitas yang berkaitan dengan proses penerimaan peserta didik.\\n🚫 Jangan menjanjikan kelulusan atau penyelesaian proses administrasi dengan imbalan tertentu.\\n🚫 Hindari segala bentuk konflik kepentingan yang dapat mencederai kepercayaan masyarakat.\\n\\n✅ Jika menerima gratifikasi yang tidak dapat ditolak, segera laporkan sesuai ketentuan yang berlaku.\\n✅ Untuk gratifikasi berupa makanan atau bingkisan yang mudah rusak, dapat disalurkan sebagai bantuan sosial kepada pihak yang membutuhkan.\\n\\nMari bersama mewujudkan SPMB 2026 yang jujur, adil, dan berintegritas, demi memberikan kesempatan yang setara bagi seluruh peserta didik serta menjaga kepercayaan masyarakat terhadap pelayanan publik.\\n\\nTolak Gratifikasi, Jaga Integritas, Wujudkan Pendidikan Berkualitas. ✨\\n\\n#SPMB2026\\n#StopGratifikasi\\n#JanganTitipJanganMemberi\\n#TolakGratifikasi\\n#ZonaIntegritas\\n#InspektoratKotaBekasi\\n#BerAKHLAK\\n#BanggaMelayaniBangsa\\n#PendidikanBerkualitas\\n#PelayananPublikBersih\\n#BekasiKeren\\n#ASNBerintegritas\",\"post_time\":1780559220,\"owner\":\"3668578984\",\"username\":\"disdik_kota_bekasi\",\"comment_count\":59,\"like_count\":176,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/3668578984/DZJ_bs9iV0Z.jpg\"},{\"current_url\":\"https://www.instagram.com/disdik_kota_bekasi/?_showcaption=true\",\"snapshot_date\":1780919048961,\"id\":\"DY6m5gtTYmC\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.71878-15/708877269_2206879346756035_3548704171458141913_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=MzkwNzYwNjcwNDU5NDcxNzA1OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fbmZyYW1lX2NvdmVyX2ZyYW1lLkMzIn0%3D&_nc_ohc=u6UeaR4VWk4Q7kNvwE-T35x&_nc_oc=Adog_jDDEnNzqdkDFHkt1G_9A93jshcfOK-BELsZF3RyprKDorlSDVz_RYer3HnZZbU&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=K-nXRND2Hf8chEJ8cD1BwA&_nc_ss=7a22e&oh=00_Af_XqJleYvTYBF6-h3iZcNty6__TuS1TGbTgfvkS7vPM7g&oe=6A2C7BEE\",\"caption\":\"MASYARAKAT BERTANYA, RIDHO BERPECI MENJAWAB\\n\\nM