8xRPiQwBJYDsQ&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=WIRKvzpRO-Z65X3hD9tOCw&_nc_ss=8&oh=00_AfxVAGIIl7udtWn1NhArrwCMG2gLA9RphUCkdEDAujLXJw&oe=69AC7B70\",\"caption\":\"Pamor Kelurahan Perwira menghadiri Pemilihan Ketua RT 005 RW 006 Periode 2025–2030, Sabtu (15/11).\\n\\nKehadiran ini sebagai bentuk dukungan dan partisipasi dalam pelaksanaan demokrasi tingkat lingkungan demi terwujudnya kepengurusan yang amanah dan melayani masyarakat.\\n\\nSelamat dan Sukses kepada Bapak KEN SAMAPTO Ketua RT.005/006 terpilih, dengan harapan dapat menjalankan tugas dan tanggung jawab sesuai amanat warga.\\n\\n@mastriadhianto @harris.bobihoe @bambangsuswanto75 @diskominfojabar @pemkot_bekasi @diskominfobekasi @humaskotabekasi @kec_bekasiutara\\n\\n#kotabekasi #kotapatriot #kecamatanbekasiutara #kelurahanperwira\",\"post_time\":1767074739,\"owner\":\"59084226036\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/59084226036/3798825472818626557_59084226036.jpg\"},{\"id\":\"DS4Hz0Xj0f2\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/606958989_17976402872970037_5481433352984238225_n.webp?stp=dst-webp_p720x720&_nc_cat=103&ig_cache_key=Mzc5ODgwOTA0OTc3ODAzMjk0OQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=3WJtWHY0vvsQ7kNvwGL62xh&_nc_oc=Admm7c_h0PXnhWxCt4iriEL2_u2Z3IWjaCefIDGwfeOiITYLHs7Xx6veZPW-nBM-PR0&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=WIRKvzpRO-Z65X3hD9tOCw&_nc_ss=8&oh=00_Afx686rUzI4f9hsTa8fy5QkUc48x7LLHtKcazIMpD_KAYQ&oe=69AC6896\",\"caption\":\"Kelurahan Perwira melaksanakan kegiatan K3 (Kebersihan, Keindahan, dan Ketertiban) di halaman kantor, Sabtu (15/11).\\n\\nKegiatan ini dilakukan untuk menjaga lingkungan kantor tetap bersih, rapi, dan nyaman bagi masyarakat yang datang menerima pelayanan.\",\"post_time\":1767074724,\"owner\":\"59084226036\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/59084226036/3798820632935745526_59084226036.jpg\"},{\"id\":\"DS4HyicD_3u\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/605858378_17976403661970037_6299657940262714599_n.webp?stp=dst-webp_p720x720&_nc_cat=103&ig_cache_key=Mzc5ODgyMDUzNjI1NzA0NjA4NA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=BhGFdorIECAQ7kNvwEdFD2y&_nc_oc=AdmqLaOm6bLUBN00UOvl6v5PeX3sqHsfY3EMJ4TuJna0m29mBvey07jekCz-8gwNFmo&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=WIRKvzpRO-Z65X3hD9tOCw&_nc_ss=8&oh=00_AfxytXpUcGlJY5Uq7533A440nPNDazxw4xoOPWQqqctKrg&oe=69AC8559\",\"caption\":\"Lurah Perwira menghadiri sekaligus melantik, mewakili Camat Bekasi Utara, Ketua RW 018 Kelurahan Perwira Bapak Acep Budi Supriyanto Periode 2025-2030 di Villa Mas Indah RW.018, Sabtu (15/11).\\n\\nPelantikan ini menjadi awal masa tugas bagi Ketua RW 018 yang diharapkan dapat menjalankan amanah dengan baik. \\n\\nSelamat dan Sukses kepada Bapak Acep Budi Supriyanto. Semoga dapat mengemban tugas dengan penuh tanggung jawab, menjadi pemimpin yang dekat dengan warga, serta membawa kemajuan bagi lingkungan RW 018.\",\"post_time\":1767074720,\"owner\":\"59084226036\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/59084226036/3798820544964460014_59084226036.jpg\"},{\"id\":\"DS4HR3_jyF4\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/605626087_17976400571970037_6164459307493296771_n.webp?stp=dst-webp_p720x720&_nc_cat=106&ig_cache_key=Mzc5ODc5MzEyMzcxMjE0ODQ2OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=1Z4JR2opzuQQ7kNvwED8UQM&_nc_oc=AdlnaGgo-PH63URXU0VttLWmZob7Ij4hDaD7ScrWyUQ4wIsxeTTchIo5z3-018GKDF0&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=WIRKvzpRO-Z65X3hD9tOCw&_nc_ss=8&oh=00_AfwwDsn91JnuVq39QJqjmT_Nw7nBnFf6JrSosw2kRR8YZg&oe=69AC6154\",\"caption\":\"Staf Kelurahan Perwira turut berpartisipasi dalam kegiatan Donor Darah yang diselenggarakan PMI Kota Bekasi bekerja sama dengan Persatuan Darma Wanita, Jum’at (14/11).\\n\\nKegiatan ini menjadi salah satu bentuk nyata kepedulian terhadap sesama, sekaligus wujud dukungan untuk menjaga ketersediaan stok darah bagi masyarakat yang membutuhkan.\\n\\n@mastriadhianto @harris.bobihoe @bambangsuswanto75 @diskominfojabar @pemkot_bekasi @diskominfobekasi @humaskotabekasi @kec_bekasiutara\\n\\n#kotabekasi #kotapatriot #kecamatanbekasiutara #kelurahanperwira\",\"post_time\":1767074402,\"owner\":\"59084226036\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/59084226036/3798818300365840760_59084226036.jpg\"},{\"id\":\"DRvko1Mjzg1\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/588474512_17973395807970037_285301686211411215_n.webp?stp=dst-webp_p720x720&_nc_cat=109&ig_cache_key=Mzc3ODM5OTczOTA0MjU4OTY3MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjE0NDB4MTgwMC5zZHIuQzMifQ%3D%3D&_nc_ohc=0BHWvEu-YscQ7kNvwHa70yB&_nc_oc=AdkhFu0FCZD3c8jTmxIskajzp1QsOATVO6EQvycBquvxsV82wxXiNEJGXTFhLJJrxOo&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=mIdOKuTnuVx0wTXQ32qphA&_nc_ss=8&oh=00_AfxMysPxLDWiVIdpE8nnUXtzEGJD_VuxR3WeAuTimzoeVg&oe=69AC90E4\",\"caption\":\"Lurah Perwira didampingi Kasi Pemtratibum Kelurahan Perwira melakukan monitoring kegiatan pematusan saluran air oleh UPTD Pematusan DBMSDA Kota Bekasi, Jum’at (14/11). Kegiatan ini berlokasi di Jalan Utama KH. Muchtar Tabrani, RT.001 RW.001.\\n\\nMonitoring dilakukan untuk memastikan proses pematusan berjalan optimal, guna mencegah genangan air serta menjaga kebersihan dan kelancaran saluran di wilayah Kelurahan Perwira.\\n\\n@mastriadhianto @harris.bobihoe @bambangsuswanto75 @diskominfojabar @pemkot_bekasi @diskominfobekasi @humaskotabekasi @kec_bekasiutara\\n\\n#kotabekasi #kotapatriot #kecamatanbekasiutara #kelurahanperwira