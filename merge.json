1-1.cdninstagram.com&_nc_gid=JQo3ZTNzq8xw7IOUp18gcw&_nc_ss=7e6a8&oh=00_AQJIx7cod3qZ7Oqp___kCiKHYSLdgIwacSIB8s_8ADd8zA&oe=6AA6F31D\",\"caption\":\"🏆 Semangat, Kreativitas, dan Kolaborasi untuk Padurenan! 🏆\\n\\nLurah Padurenan bersama Ketua TP PKK Kelurahan Padurenan turut serta mengikuti Lomba Anugerah Sribaduga dan Lomba Kreasi PKK Tingkat Kota Bekasi.\\n\\nKeikutsertaan ini menjadi wujud semangat dan komitmen Kelurahan Padurenan dalam mendukung berbagai program pembangunan, pemberdayaan masyarakat, serta meningkatkan peran aktif PKK dalam menciptakan lingkungan yang kreatif, inovatif, dan berdaya.\\n\\nMelalui kegiatan ini, diharapkan dapat terus terjalin sinergi antara pemerintah, TP PKK, dan seluruh elemen masyarakat untuk bersama-sama memberikan yang terbaik bagi kemajuan Kelurahan Padurenan. \\n\\nMari terus dukung dan doakan Kelurahan Padurenan agar dapat memberikan hasil terbaik serta mengharumkan nama wilayah di tingkat Kota Bekasi! 💙\\n\\nPadurenan Bisa... Padurenan Juara...\\n\\n@mastriadhianto @harris.bobihoe @s.saepulloh77_ @kecamatanmustikajaya @diskominfobekasi @pemkot_bekasi @prokopimkotabekasi\",\"post_time\":1788443246,\"owner\":\"3252462986\",\"username\":\"kecamatanmustikajaya\",\"comment_count\":7,\"like_count\":50,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/3252462986/Dc08mOaJ9J9.jpg\"},{\"current_url\":\"https://www.instagram.com/kecamatanmustikajaya/?_showcaption=true\",\"snapshot_date\":1788938043089,\"id\":\"DcvCRr_Eh7h\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/792053420_18482643028110987_5548598703842995168_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=106&ig_cache_key=Mzk3NjQwNjk5NzU3MDU3NjIzMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=JnsZRX3Lo7QQ7kNvwFjexu1&_nc_oc=AdrVwpcACKCeqob7CaNYP5CRHqNM3h3c7z7a-JGjYwuYRq_L2m9sEblcw5sraQRxWzA&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=JQo3ZTNzq8xw7IOUp18gcw&_nc_ss=7e6a8&oh=00_AQJRYfWrX_lMbVG8c0utqXMXUM6E9l9S1gYH0EmSCBBXPw&oe=6AA6DCB9\",\"caption\":\"Menindaklanjuti aduan masyarakat terkait pembuangan air limbah dari aktivitas pemotongan ayam Panglima Chicken di wilayah RT 01 RW 10 Kelurahan Mustikajaya, Camat Mustikajaya bersama Lurah Mustikajaya turun langsung ke lokasi untuk melihat kondisi dan mendengarkan permasalahan yang dirasakan masyarakat.\\n\\nPemerintah Kecamatan Mustikajaya akan terus melakukan koordinasi dan pemantauan bersama pihak terkait agar permasalahan dapat ditangani sesuai ketentuan dan tidak menimbulkan dampak bagi lingkungan maupun masyarakat sekitar.\",\"post_time\":1788244676,\"owner\":\"3252462986\",\"username\":\"kecamatanmustikajaya\",\"comment_count\":6,\"like_count\":47,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/3252462986/DcvCRr_Eh7h.jpg\"},{\"current_url\":\"https://www.instagram.com/kecamatanmustikajaya/?_showcaption=true\",\"snapshot_date\":1788938043089,\"id\":\"DcsxcImy-7D\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/790968848_18482471878110987_1323886339385328399_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk3NTc3MDAwODcyNjUzMTc3OTE4NDgyNDcxODc1MTEwOTg3.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=Qi3OwoioB2EQ7kNvwEzR28r&_nc_oc=AdqbSJnt_7zKcUMO715Vuxg4i8ANLts_5crQg7cXIPGdSQxRnHaf1ZTn6V_op_iFaiY&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=JQo3ZTNzq8xw7IOUp18gcw&_nc_ss=7e6a8&oh=00_AQKTZv4OlD3JkofIHBmMfX7WwSBb5uxiP5_8Ge7QdQ64vQ&oe=6AA6D1BC\",\"caption\":\"Alhamdulillah, kebahagiaan kembali hadir bagi warga Kecamatan Mustikajaya melalui Peresmian Rumah Tidak Layak Huni (Rutilahu) yang diresmikan oleh Ibu Wali Kota Bekasi, Wiwiek Hargono Tri Adianto, Kamis, 27 Agustus 2026.\\n\\nProgram Rutilahu menjadi wujud nyata kepedulian dan komitmen Pemerintah Kota Bekasi dalam menghadirkan hunian yang lebih layak, aman, nyaman, dan sehat bagi masyarakat. 🏡❤️\\n\\nTiga warga penerima manfaat Rutilahu di Kecamatan Mustikajaya, yaitu:\\n\\n1. Bpk. Sagimin - Kel. Mustikajaya\\n2. Bpk. Muhlisin - Kel. Cimuning\\n3. Bpk. Eman - Kel. Padurenan\\n\\nSemoga rumah yang telah diperbaiki dapat menjadi tempat yang lebih nyaman untuk berkumpul bersama keluarga serta membawa keberkahan dan kebahagiaan bagi para penerima manfaat.\",\"post_time\":1788168853,\"owner\":\"3252462986\",\"username\":\"kecamatanmustikajaya\",\"comment_count\":0,\"like_count\":30,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/3252462986/DcsxcImy-7D.jpg\"},{\"current_url\":\"https://www.instagram.com/kecamatanmustikajaya/?_showcaption=true\",\"snapshot_date\":1788938043089,\"id\":\"DcsmrfkS7aB\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/788897423_18482462101110987_5286649859957745679_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk3NTcyMjY4NTY2MTE2NTE4NTE4NDgyNDYyMDk4MTEwOTg3.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=83elS9U7WlQQ7kNvwFOtT4j&_nc_oc=AdopwTeToRGvHFZIBCH8NZZMyCtFR16RI1FhzbTE80T0KBXYXpna0UAySfZ2ucjOaE0&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=JQo3ZTNzq8xw7IOUp18gcw&_nc_ss=7e6a8&oh=00_AQJeVjQVncjU4HdECrlvGNF7YfEa_HXfYRHvTnIx2aqqGw&oe=6AA6CA80\",\"caption\":\"PESONA NUSANTARA BEKASI KEREN JILID III ✨\\n\\nSatu panggung, beragam budaya, dan semangat kebersamaan yang luar biasa! 🇮🇩💫\\n\\nKemeriahan Pesona Nusantara Bekasi Keren Jilid III menjadi bukti bahwa keberagaman adalah kekuatan yang menyatukan kita. Berbagai seni, budaya, kreativitas, dan kebahagiaan hadir dalam satu momen penuh warna. 🎭🎶💃\\n\\nDari Bekasi untuk Indonesia, terus lestarikan budaya, rawat kebersamaan, dan jadikan keberagaman sebagai energi untuk terus berkarya! ❤️🤝\",\"post_time\":1788163127,\"owner\":\"3252462986\",\"username\":\"kecamatanmustikajaya\",\"comment_count\":1,\"like_count\":50,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/3252462986/DcsmrfkS7aB.jpg\"},{\"current_url\":\"https://www.instagram.com/kecamatanmustikajaya/?_showcaption=true\",\"snapshot_date\":1788938043089,\"id\":\"Dchk8v7S4Xk\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/786157515_18481592533110987_2106610349180761183_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=104&ig_cache_key=Mzk3MjYxODg1MDYyMTE2Mjk4MDE4NDgxNTkyNTI3MTEwOTg3.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=dUDZx40cULYQ7kNvwHQXxiD&_nc_oc=AdrIjtrdhz5aQVMTaIRTjxPCwLb9ChtFXS842Nx0ByCRH5_QnxfMjTx1eDylJKukNXM&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=JQo3ZTNzq8xw7IOUp18gcw&_nc_ss=7e6a8&oh=00_AQISzjs5rKOv67vhQsM2LhKH2a1KagtTRODxnh37Bw0ANA&oe=6AA6C425\",\"caption\":\"Dari masalah, menuju langkah nyata.\\n\\nSampah merupakan bagian dari kehidupan sehari-hari, namun ketika tidak dikelola dengan baik, dapat menjadi persoalan bagi lingkungan dan masyarakat.\\n\\nHari ini, Kota Bekasi mengambil langkah baru melalui Groundbreaking Pengolahan Sampah Menjadi Energi Listrik (PSEL).\\n\\nPSEL menjadi salah satu langkah menuju sistem pengelolaan sampah yang lebih modern dan berkelanjutan, dengan mengolah sampah menjadi sumber energi.\\n\\nNamun, solusi sampah tidak hanya tentang teknologi. Perubahan juga dimulai dari kita—dari rumah, dari kebiasaan memilah, mengurangi, dan membuang sampah pada tempatnya.\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1787793123,\"owner\":\"3252462986\",\"username\":\"kecamatanmustikajaya\",\"comment_count\":6,\"like_count\":1126,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/3252462986/Dchk8v7S4Xk.jpg\"},{\"current_url\":\"https://www.instagram.com/kecamatanmustikajaya/?_showcaption=true\",\"snapshot_date\":1788938043089,\"id\":\"DcTLWbGR5Y8\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/780771818_18004676495973156_3915611987619060405_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=104&ig_cache_key=Mzk2ODU2NTYxNjA4MDAzMzM0MDE4MDA0Njc2NDkyOTczMTU2.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=nkx_m6j1pIcQ7kNvwGYyL6p&_nc_oc=AdouLvtwsCd-iJu-MO8flRcAOytD5iAOvUljFkyDK_9A9AUvBAUTbHHT1wxO8eVmXjY&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=JQo3ZTNzq8xw7IOUp18gcw&_nc_ss=7e6a8&oh=00_AQJ9RoS_bVR7QGu8BO09ZejH6LtKFQ50GBEGPIPqQuuQKQ&oe=6AA6CD03\",\"caption\":\"Dalam upaya memperkuat kapasitas dan kualitas kepemimpinan aparatur sipil negara. Asisten Pemerintahan dan Kesejahteraan Rakyat Sekretariat Daerah Kota Bekasi, Lintong Dianto Putra, A.P., S.H., M.Si , menjalankan tugas sebagai mentor bagi peserta Pelatihan Kepemimpinan Administrator (PKA) Angkatan XII BPSDM Provinsi DKI Jakarta Tahun 2026.\\n\\nPendampingan tersebut diberikan kepada dua peserta dari Pemerintah Kota Bekasi, yakni Sekretaris Kecamatan Mustika Jaya Rani Lestari dan Sekretaris Kecamatan Bekasi Utara Ahmad Apandi, sebagai bagian dari proses pengembangan kompetensi kepemimpinan dan peningkatan kinerja organisasi.\\n\\nMelalui peran sebagai mentor, Asda 1 memberikan arahan, pendampingan, serta penguatan terhadap proses penyusunan dan pelaksanaan aksi perubahan kinerja organisasi yang menjadi bagian penting dalam rangkaian PKA.\\n\\nKegiatan ini tidak sekadar menjadi bagian dari proses pendidikan dan pengembangan kompetensi, tetapi juga diharapkan mampu melahirkan gagasan dan inovasi yang dapat diterapkan dalam pelaksanaan tugas pemerintahan dan pelayanan kepada masyarakat.\\n\\nSelamat dan sukses. Terus belajar, terus berinovasi, dan hadirkan perubahan yang memberikan manfaat bagi Kota Bekasi.\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@bekasikota.setda \\n@kec_bekasiutara \\n@kecamatanmustikajaya \\n\\n#pemerintahkotabekasi \\n#asda1kotabekasi \\n#kotabekasi \\n#kotapatriot\",\"post_time\":1787310019,\"owner\":\"3252462986\",\"username\":\"kecamatanmustikajaya\",\"comment_count\":0,\"like_count\":53,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/3252462986/DcTLWbGR5Y8.jpg\"},{\"current_url\":\"https://www.instagram.com/kecamatanmustikajaya/?_showcaption=true\",\"snapshot_date\":1788938043089,\"id\":\"DcS8mt2EvmX\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.82787-15/779865053_18480479770110987_5131817545059934962_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=100&ig_cache_key=Mzk2ODUwMDc2NTAyMzIwNTc4Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=HMXPuqoJwiUQ7kNvwGSHJFV&_nc_oc=Adps76intKtYod6E2Hvb8hdxtxRfw16ikQvAJvcwHJrw7M5BK3t0DSBNSxHJiStMptM&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=JQo3ZTNzq8xw7IOUp18gcw&_nc_ss=7e6a8&oh=00_AQJy0JsJOS7Dshc7ud4-D-BcmvDCG3VqjIgPV1wofDOVvg&oe=6AA6BDE9\",\"caption\":\"Kasi Trantib Kecamatan Mustikajaya memonitoring dan evakuasi kejadian Ruko Roboh di Mutiara Gading Timur RW 031 Kelurahan Mustikajaya.\\n\\nSaat ini Korban luka telah di larikan ke RSUD Kota Bekasi.\",\"post_time\":1787302178,\"owner\":\"3252462986\",\"username\":\"kecamatanmustikajaya\",\"comment_count\":0,\"like_count\":64,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/3252462986/DcS8mt2EvmX.jpg\"},{\"current_url\":\"https://www.instagram.com/kecamatanmustikajaya/?_showcaption=true\",\"snapshot_date\":1788973148671,\"id\":\"DcOHYFySAFo\",\"image\":\"https://scontent-hkg4-2.cdninstagram.com/v/t51.82787-15/779956730_18480090793110987_7595920318601263852_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=Mzk2NzE0MDc2MzU2NTI5MzkyODE4NDgwMDkwNzg3MTEwOTg3.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU3Ni5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=e2mfhwos3QQQ7kNvwHdss2z&_nc_oc=AdqORtAs8ASQypB6pE8Ad6C_grZEKEOFcH7wVbBXAh2aL_vlujdxem3Q-iO83TSbLL