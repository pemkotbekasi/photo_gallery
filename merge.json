3-2.cdninstagram.com/v/t51.82787-15/601849749_17980832171954881_4551909155728803619_n.webp?_nc_cat=104&ig_cache_key=Mzc5MDg4NTY4ODU0ODcyOTI2Ng%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjgxMHgxMDgwLnNkci5DMyJ9&_nc_ohc=qL6Xb93w0GUQ7kNvwHXSlYZ&_nc_oc=AdlwqJjSmRZzv2cr06DmODvM7VanZhELNwujqL9B1eLHehcMTm7LoN9GWuj-Sv4kBjw&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=SiINmpWAXgbdoOZwIDkHCA&_nc_ss=8&oh=00_Afw1AqTjakEHQFhjDFNb9pscJ0wpweu5cAFmW61BeLKnIQ&oe=69AC5FDB\",\"caption\":\"19 Desember 2025\\nTurut Berdukacita atas Kepergian Salah Satu Tokoh Kota Bekasi \\n\\nCamat Jatisampurna beserta Jajaran Aparatur Sekecamatan Jatisampurna mengucapkanTurut berdukacita Atas meninggalnya Bpk.H.AAN SUHANDA Bin H.ASMAT beliau Adalah Panutan Kita semua selama menjadi ASN Kota Bekasi.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1766128811,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3790885688548729266_58589690880.jpg\"},{\"id\":\"DSbyEwPj8Vo\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.71878-15/603099503_830338579827787_8116458036444447808_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=104&ig_cache_key=Mzc5MDg0Mzc0MDM2NjU1NDQ3Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgzNjAuc2RyLkMzIn0%3D&_nc_ohc=UPHqfgjL-hEQ7kNvwGVeATY&_nc_oc=AdlLwDVxz4D3dV6Mbtms4HSHPm4qwCgihnRww4EQmmH4-Fn3e9DlOWQhs5VWVBaO49E&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=SiINmpWAXgbdoOZwIDkHCA&_nc_ss=8&oh=00_AfwWZgJ9BQ7vPcg4rLhD_qOE1WW8asAvY40FnAI11ARZOA&oe=69AC8402\",\"caption\":\"19 Desember 2025\\nJum'at Berkah Kecamatan Jatisampurna \\n\\nCamat Jatisampurna beserta jajaran melaksanakan kegiatan rutin Jumat Berkah di jl.Raya Kecamatan Jatisampurna.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1766123838,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3790843740366554472_58589690880.jpg\"},{\"id\":\"DSZDVTvj6yy\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/602288435_17980713794954881_1946570577178418832_n.webp?stp=dst-webp_s720x720&_nc_cat=101&ig_cache_key=Mzc5MDA3NTIwOTUyMTc5MDI4Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4NzIwLnNkci5DMyJ9&_nc_ohc=4wYCTj5kADwQ7kNvwFw3HFT&_nc_oc=AdnjgEESFXxU28rEGZr-8ixD6WBv1XNSQ-iH63thHbFHmmkWADESSz4sbLFlzzGGPO8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=SiINmpWAXgbdoOZwIDkHCA&_nc_ss=8&oh=00_AfzaaUqtwmnF_nsyfRq8FpF6FSDY-rdsFG7ZQvfMVZU-Mg&oe=69AC6416\",\"caption\":\"18 Desember 2025 \\nPublic hearing anggota DPRD Kota Bekasi Davil 4 Bpk.Anim Imammudin \\n\\nPublic Hearing (Mendengarkan Pendapat Umum) adalah Forum Diskusi terbuka antara pejabat Pemerintah dengan Masyarakat.\\n\\nCamat Jatisampurna menyambut dengan Sangat gembira bahwa Anggota DPRD Kota Bekasi Bpk.Anim Imammudin mau meluangkan waktu untuk melaksanakan kegiatan Public Hearing di Kantor Kecamatan Jatisampurna tentunya ini adalah kegiatan yang sangat positif.\\n\\nUntuk menyerap aspirasi warga terutama Para ketua RT/RW untuk menyerap suatu rancangan Kebijakan atau segala permasalahan di wilayah terutama di wilayah Kecamatan Jatisampurna dan di utarakan langsung di hadapan anggota DPRD Kota Bekasi Bpk.Anim Imammudin.\\n\\nCamat sangat berharap para ketua RT dan RW yang di undang dapat memaparkan segala permasalahan di wilayah yang mereka pimpin agar segera terselesaikan.\\n@mastriadhianto\\n@harris.bobihoe\\n@anim_imamuddin\\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1766032196,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3790075219856567474_58589690880.jpg\"},{\"id\":\"DSWrRCWj8qR\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/588616560_17980618118954881_4403263770772153777_n.webp?stp=dst-webp_s720x720&_nc_cat=108&ig_cache_key=Mzc4OTQwNjQxNDQyNzg3NTg1Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4ODEwLnNkci5DMyJ9&_nc_ohc=G85zM6jzB1wQ7kNvwHVeFSY&_nc_oc=AdkG1rL6WoytvKduKB91EEBLSdjRj6QkQkJbL01OMwoZCfc3W9vbEyYJqdVo_DyHpn4&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=SiINmpWAXgbdoOZwIDkHCA&_nc_ss=8&oh=00_AfxulErdu7oZ87G63K5Sb_irP5r1AsU-8drlYQjUJu2cUA&oe=69AC7529\",\"caption\":\"17 Desember 2025\\nFORUM GROUP DISCUSSION\\n\\nCAMAT Jatisampurna di Dampingi Kapolsek Jatisampurna & Koramil Pondok Gede menghadiri undangan Forum Group Discussion yang di adakan oleh Faster oil Kelurahan Jatiraden.\\n\\nAtau banyak di kenal dengan Migas Jatiraden,Camat menyambut Baik Adanya Program Koordinasi kewilayahan ini karna saling bersinergi antara Aparatur dengan BUMD yang ada di wilayah Kecamatan Jatisampurna.\\n\\nTentunya ucapan terimakasih juga dibucapkan oleh Camat juga Kepada Jajaran BUMD Migas Karna selalu membantu dalam kegiatan Jum'at Berkah setiap hari Jum'at yang di adakan oleh Kecamatan Jatisampurna.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765952469,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3789406423235938961_58589690880.jpg\"},{\"id\":\"DSWo79-D6_u\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.71878-15/587833624_849865117968702_8279328908040709398_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=109&ig_cache_key=Mzc4OTM5NjE3OTMyNzg4OTM5MA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM4LnNkci5DMyJ9&_nc_ohc=LIAn4SixyI0Q7kNvwGISign&_nc_oc=Adk8WSkPbYFivmdZhlKA8T4oiE5teckGl8sjD0wlUTXlswGlVTQHZ1zCnu9ZqS4Z_wc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_AfxvFLZpWLMUkPlVqus1wypL0ViR_5gCGrSVDLIWIwq0Zg&oe=69AC72B8\",\"caption\":\"17 Desember 2025\\nTestimoni Ucapan Terimakasih \\n\\nBpk.M.Yahya (Ketua RW.08) Kelurahan Jatiraden \\nMengucapkan Banyak Terimakasih Kepada Walikota Bekasi,Wakil Walikota Bekasi,DPRD Kota Bekasi,Camat Jatisampurna & Lurah Jatiraden atas Program Penataan Lingkungan RW Bekasi Keren Tahun 2025.\\n\\nTentunya Program Penataan Lingkungan RW Bekasi Keren sangat membantu lingkungan RW karna ada beberapa fasilitas barang yang tadi nya kurang atau tidak dimilki,dengan adanya program penataan lingkungan RW Bekasi Keren para ketua RW bisa membelinya tentunya barang yang di beli dengan pertanggung jawaban secara administrasi maupun perawatannya.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765951602,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3789396179327889390_58589690880.jpg\"},{\"id\":\"DSWZ8q8D6n9\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/599120355_17980607564954881_4452731177175178736_n.webp?stp=dst-webp_s720x720&_nc_cat=102&ig_cache_key=Mzc4OTMzMDI0NTU2NTIzOTcyNA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTA4MC5zZHIuQzMifQ%3D%3D&_nc_ohc=LtRW6eJfMm4Q7kNvwHtatjp&_nc_oc=AdlIXCnN39KXbQPzw8BW0HP-7Pry57-XEc35HeqJS0Pdj6PljkOHWwFa8ngfyvnzaHI&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_Afzp9sHUnAkFkcJvQwiDlKxQk5qe-scR9wCZthhShMgNeg&oe=69AC61EC\",\"caption\":\"17 Desember 2025\\nSudah Geramnya Camat Akan Reklame yang merusak Keindahan Wilayah Kecamatan Jatisampurna.\\n\\nCamat Jatisampurna Bpk.Nata Wirya memberikan tugas kepada jajaran Satpol-PP Kecamatan Jatisampurna untuk menertibkan Reklame yang sudah mengganggu keindahan wilayah Kecamatan Jatisampurna.\\n\\nCamat dengan tegas memerintahkan Penertiban reklame tak berijin dan pemasangan yang melanggar aturan,begitu juga yang sudah memiliki ijin tapi tidak di titik yang benar Camat meminta rekan satpol PP untuk berkoordinasi Dengan Dinas Terkait untuk mengatur regulasi pemasangan di Titik dan tempat yang sudah di atur.\\n\\nTentunya ini semua untuk tetap menjaga keindahan dan kebersihan lingkungan wilayah Kecamatan Jatisampurna.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi \\n@dpmptsp_kotabekasi\",\"post_time\":1765943389,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3789330256915048957_58589690880.jpg\"},{\"id\":\"DSWYtlXD4k-\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/589928407_17980606880954881_5997816299970689595_n.webp?stp=dst-webp_s720x720&_nc_cat=106&ig_cache_key=Mzc4OTMyNDgxMDQwOTkzNTI0OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4NzIwLnNkci5DMyJ9&_nc_ohc=vs4j3LpuLPoQ7kNvwG_Fs_z&_nc_oc=AdnCIg5a4o8fD0TKpJIGrF_nzoe6puWqcotE_CRovaF_m1Iwt7VE0EXixD41Q3Jt63I&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_AfzcEKsCAwLcUWkkdxDvcgSdjXnAreLjYRjNlQiJv3Y0wg&oe=69AC7A57\",\"caption\":\"17 Desember 2025\\nApel Gabungan Aparatur TK Kecamatan Jatisampurna \\n\\nSekertaris Camat Bpk.Nurdin Mendapatkan Tugas dari Camat Jatisampurna untuk memimpin Apel Gabungan Aparatur TK Kecamatan Jatisampurna di halaman Kantor Kelurahan Jatiranggon.\\n\\nSekcam menyampaikan Tentang perlengkapan adribut pegawai dalam menjalankan tugas sehari-hari,karna adribut adalah jatidiri seorang ASN dan bentuk Kedisiplinan ASN.\\n\\nBeliau juga menyampaikan Pesan Maaf dari Bpk.Camat bahwa beliau tidak bisa hadir di tengah-tengah kita semua karna memang ada kegiatan di tingkat Kota Bekasi bersama Walikota Bekasi.\\n\\nSekcam juga berharap apel Gabungan ini terus berputar di setiap Kelurahan yang ada di Kecamatan Jatisampurna agar semua nya merasakan menjadi tuan rumah untuk ketempatan kegiatan Apel Gabungan Aparatur TK Kecamatan Jatisampurna, sekaligus koordinasi kewilayahan.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765942741,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3789324822086912318_58589690880.jpg\"},{\"id\":\"DSUy8iTDxSU\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.71878-15/599829541_733697976443343_8543275524409908575_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=101&ig_cache_key=Mzc4ODg3NzI0ODg0NjU2NjU0OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgxMTM4LnNkci5DMyJ9&_nc_ohc=XAmqcMhT3qAQ7kNvwH-60Ss&_nc_oc=Adk4L-1Aok5ripYCkSHp6NoglK3Muno1M7X1c_KJ58yQh3uz93nohiJaWlXY1hQ-ivw&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_AfwGhNL7ynIvmzb1-ve1lHfSafWo5feHF-gQ0OIJIl1hEw&oe=69AC7923\",\"caption\":\"16 Desember 2025 \\nUcapan Terimakasih untuk Program Penataan Lingkungan RW Bekasi Keren.\\n\\nBpk.Saman Degol (Ketua RW 001) Kelurahan Jatisampurna mewakili Ketua RW-RW Sekecamatan Jatisampurna mengucapkan Terimakasih Kepada Jajaran Pemerintah Kota Bekasi,\\n\\nKepada Walikota Bekasi,Wakil Walikota Bakasi,Jajaran DPRD Kota Bekasi,Camat Jatisampurna,Lurah Sekecamatan Jatisampurna atas Adanya Program Penataan Lingkungan RW Bekasi Keren Tahun 2025.\\n\\nTentunya Dengan Adanya Program Penataan Lingkungan RW Bekasi Keren,Sangatlah membantu Para Ketua RW untuk memenuhi kebutuhan kepentingan Fasilitas Untuk warga.\\n\\nPara Ketua RW berharap bahwa kegiatan penataan lingkungan RW Bekasi Keren bisa terlaksana kembali di Tahun-Tahun yang akan datang.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi \\n@humasdprdkotabekasi\",\"post_time\":1765890054,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3788877248846566548_58589690880.jpg\"},{\"id\":\"DSUp9enj_ak\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/598649884_17980533509954881_7080170037671280362_n.webp?stp=dst-webp_s720x720&_nc_cat=108&ig_cache_key=Mzc4ODgzNzczMTE5NjQ2Njg1Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4ODEwLnNkci5DMyJ9&_nc_ohc=E85efd_xBIUQ7kNvwGROCnp&_nc_oc=Adnj6yWtlGkgH1F2Pt9do5EE10YL0oHY049aIdTKPr1cSus-Mx4VYruQYIkhyIIx44I&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_AfxIO3ubmcHVJNJC7Gvfwbk3x11aiFBPKQMA0HR4NwcdKA&oe=69AC88E3\",\"caption\":\"16 Desember 2025\\nLaporkan Kegiatan Satpol-PP Kecamatan Jatisampurna \\n\\nCamat Jatisampurna menerima Laporan kegiatan Satpol-PP Kecamatan Jatisampurna yang di Laporkan oleh Korlap Satpol-PP Kecamatan Jatisampurna,adapun laporan yang di sampaikan kepada Camat adalah.\\n\\n1.Penertiban Reklame Spanduk\\n2.Patroli Wilayah \\n3.Sinergi Dengan Polsek Jatisampurna & Koramil \\n4.Pengamanan Kantor Kecamatan Jatisampurna \\n5.Tindak Lanjut Pengaduan Warga\\n\\nCamat ingin memastikan bahwa semua tupoksi kinerja Satpol-PP Kecamatan Jatisampurna bisa di jalankan dengan baik dan karna mereka di tugaskan di Kecamatan Jatisampurna wajib melaporkan segala kegiatan Rekan-rekan Satpol-PP Kepada Camat  dalam menjalankan tugas.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi \\n@satpolppkotabks\",\"post_time\":1765884675,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3788837731196466852_58589690880.jpg\"},{\"id\":\"DSTzuDlDxZ8\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/590378039_17980500707954881_6138844526611729063_n.webp?stp=dst-webp_s720x720&_nc_cat=106&ig_cache_key=Mzc4ODU5OTE3Njg1OTY4NjUyNA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4ODEwLnNkci5DMyJ9&_nc_ohc=3TW0yf0ROc4Q7kNvwGOkApx&_nc_oc=Adm1tHwoF0yy-Cha7w0-fYtiwx1HaXckVB7CcMy8D4TWjg8CvbbTxXt51ag35RaP3oo&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_AfxyoKyQtrQg20O90a9zWSh0rVfinmsueynVocha0kQ0rQ&oe=69AC8C0F\",\"caption\":\"16 Desember 2025\\nSehat Dengan Senam Sparco \\n\\nCamat Jatisampurna beserta Jajaran pemangku jabatan Sekecamatan Jatisampurna mengikuti kegiatan rutin di Selasa pagi yaitu kegiatan senam Sparco di stadion Patriot Chandrabaga Kota Bekasi.\\n\\nCamat Menuturkan bahwa senam Sparco yang di laksanakan setiap Selasa pagi pukul 05:30 wib ini bagian dari program Pemerintah Kota Bekasi dalam menyehatkan para Aparatur Sipil Negara di lingkungan Pemerintah Kota Bekasi.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765856237,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3788599176859686524_58589690880.jpg\"},{\"id\":\"DSRuneYgKfr\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/592404192_17980416398954881_8261561789591897443_n.webp?_nc_cat=101&ig_cache_key=Mzc4ODAxMzc4NDQxNzc0MDc3OQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjgxMHgxMDgwLnNkci5DMyJ9&_nc_ohc=RDGHvu-n1AUQ7kNvwG-6uYj&_nc_oc=Adkn7-ezzS75VouJmmTSr9lCWzr98t63CupKaZEFnoP215gfzP-KYzsBdCHo0G9Dz8c&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_AfzC8_Y4JWXofH8fA1bf8LFAgP2E6RI-NU_MyzHDC1ZTPQ&oe=69AC5F33\",\"caption\":\"15 Desember 2025\\nPasar Murah Bersubsidi\\n\\nAyokk warga kecamatan Jatisampurna ada kabar gembira nih...!!!\\n\\nPemerintah Kota Bekasi kembali mengadakan Pasar Murah Bersubsidi,untuk Kecamatan Jatisampurna akan di adakan Pada tanggal 19 Desember 2025\\nYang bertempat di Halaman Kantor Kecamatan Jatisampurna.\\n\\nJangan Ampe kelewat,ayokkk manfaatkan pasar murah yang di adakan oleh Pemkot Kota Bekasi.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765786453,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3788013784417740779_58589690880.jpg\"},{\"id\":\"DSRuF2dD9tO\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/588259931_17980416008954881_8127400469540436450_n.webp?stp=dst-webp_s720x720&_nc_cat=102&ig_cache_key=Mzc4ODAxMTQ3MzgwMTgyOTE5OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4ODEwLnNkci5DMyJ9&_nc_ohc=Ajpsq_lRL_MQ7kNvwHNxRQd&_nc_oc=AdkAubcLZK8rG4p6uunVhE_Ttot1gc03jvqDek7XSK1qLSxJqVTDyKWEbTgH-twyZ5s&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_AfwP3Vbpk4f5RV0sMHHDlOL8SLxH8fIcSCI7F08cTm5CaQ&oe=69AC72D0\",\"caption\":\"15 Desember 2025\\nRapat koordinasi dengan 5 Lurah Sekecamatan Jatisampurna \\n\\nCamat Memimpin rapat dengan para Lurah Sekecamatan Jatisampurna di ruang Kerja Camat Jatisampurna.\\n\\nBanyak hal yang harus di bahas oleh Camat kepada Jajaran Lurah Sekecamatan Jatisampurna.\\n\\n1.Evaluasi Pembayaran Pajak Bumi Dan Bangunan \\n2.Evaluasi Pembayaran BPHTB Pajak PTSL \\n3.Kesiapan malam Natal & Tahun Baru\\n4.Program Jaga Desa dari Kejagung \\n5.Antisipasi Bencana alam \\n\\nTentunya sebagai penanggung jawab di wilayah Camat tidak menginginkan ada hal yang menghambat kinerjanya.\\n\\nMaka Camat harus berkoordinasi dengan para Lurah agar bisa di sosialisasikan kepada Ketua RT dan RW Sekecamatan Jatisampurna.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765786178,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3788011473801829198_58589690880.jpg\"},{\"id\":\"DSRj6lrj5u7\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/587700932_17980410629954881_3212560485870611267_n.webp?stp=dst-webp_s720x720&_nc_cat=104&ig_cache_key=Mzc4Nzk2NjcxOTQxMjExNjQxMQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTA4MC5zZHIuQzMifQ%3D%3D&_nc_ohc=yYpGFrtSXNEQ7kNvwFjXFOQ&_nc_oc=AdnWuPvEPAdbjrkwUCtjd2R34ATMmm0ur9vsYuRF6LcebhLZFmDpu0i-r6T7LG6hbF0&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_AfycPJJrux2f_VmEmyUbuKN7P9Xvo5SHbGvv-i7_Cy08cg&oe=69AC6286\",\"caption\":\"15 Desember 2025\\nLaunching Spot Air Minum Keren\\n\\nCamat Jatisampurna beserta Jajaran Camat Se-kota Bekasi menghadiri Launching spot air minum keren di Taman Rusa Halaman Pemkot Kota Bekasi.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765780843,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3787966719412116411_58589690880.jpg\"},{\"id\":\"DSRi540D7tF\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/589764426_17980409690954881_3908689256304030627_n.webp?stp=dst-webp_s720x720&_nc_cat=106&ig_cache_key=Mzc4Nzk2MjI2NDQyMzczNTkzMQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4NzIwLnNkci5DMyJ9&_nc_ohc=Q7U-pbOdngUQ7kNvwFyOQaI&_nc_oc=AdmtsrHEAoFEIUhMQ-zjjLM-J43_x6yXksPZlXE5he1YEuLje7PNplxVTxtwC1Rc4jo&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_AfybRFOAMlXU5zbe5vGu3E-EABmvbXYvkY6aZcrl40tSFg&oe=69AC88AB\",\"caption\":\"15 Desember 2025\\nApel Gabungan Aparatur TK Kecamatan Jatisampurna \\n\\nSekertaris Camat Bpk.Nurdin Memimpin Apel Gabungan Aparatur TK Kecamatan Jatisampurna yang rutin dilaksanakan pada hari Senin di halaman Kantor Kecamatan Jatisampurna.\\n\\nSekcam menuturkan bahwa kegiatan apel ini adalah bagian dari tugas kita sebagai Aparatur Sipil Negara yang mana,Apel ini menunjukkan kita siap untuk menjalankan Tugas dan kewajiban kita sebagai Aparatur Sipil Negara.\\n\\nSekcam juga menambahkan bahwa Desember ini ada diskon Pajak Bumi Dan Bangunan,di harapkan para aparatur yang membidangi untuk memberi tahukan kepada warga akan ada nya perpanjang diskon yang di berikan oleh pemerintah Kota Bekasi.\\n@mastriadhianto\\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765780313,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3787962273189837637_58589690880.jpg\"},{\"id\":\"DSKPs9FD827\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/599086951_17980106081954881_4215707083704404889_n.webp?stp=dst-webp_s720x720&_nc_cat=103&ig_cache_key=Mzc4NTkwNzQ5NjY5NjEzOTE5NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwNzl4NjA3LnNkci5DMyJ9&_nc_ohc=_DnLOi5KJ8EQ7kNvwFM39_D&_nc_oc=AdkW74bksRUe7w0cT1hUUkYjFhajtWjkYN6QmSY_Wz39z7PhL6_htjuFb-2Uh3DkQGM&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_AfyZ1HtaaO6BXr2bPCjCfE3F9sFyNdzaGNiTUEjpVoqCeA&oe=69AC83C4\",\"caption\":\"12 Desember 2025\\nLAJU BEKEN (Layanan Jum'at Bekasi Keren)\\n\\nCamat Jatisampurna Bpk.Nata Wirya & Sekertaris Camat Bpk.Nurdin Memimpin Berjalannya Pelayanan Laju Beken atau Layanan Jum'at Bekasi Keren yang mana pelayanan di hari Jum'at Aparatur Kecamatan Jatisampurna menambahkan jam Pelayanan Hingga Pukul 20:00 wib.\\n\\nCamat memberikan Alasan kenapa harus ada jam tambahan pada hari Jum'at,alasan nya tidak lain tidak bukan hanya untuk mempermudah warga Kecamatan Jatisampurna dalam mendapatkan pelayanan.\\n\\nSebagain besar warga kecamatan Jatisampurna sibuk akan bekerja dari pukul 07:00 s/d 16:00 maka jika pelayanan di hari biasa Kecamatan Jatisampurna sudah tutup,untuk memberikan pemerataan pelayanan maka di tambahlah setiap minggunya dilaksanakan di hari Jum'at sampai pukul 20:00 Wib.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765535364,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3785907496696139195_58589690880.jpg\"},{\"id\":\"DSJ1wsDjy-7\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/588387243_17980090604954881_5959565382168398200_n.webp?stp=dst-webp_p720x720&_nc_cat=109&ig_cache_key=Mzc4NTc5MzM5MDkzMjYwNTIzNw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTQ0MC5zZHIuQzMifQ%3D%3D&_nc_ohc=YEmJ0HZVm9cQ7kNvwEXBirq&_nc_oc=Adn9N9lodXuzHGO9nn9TLoHNmceBHg0qqhXT9BP64C2jmkegqe7S8wgGAjb5JnbkdAA&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=_6wObnRDz5O7PIjjTih_jA&_nc_ss=8&oh=00_AfxCL1DbVsnFEg0tLFMjYGdQ1eTpVbAKsTKufq7Xwggtzg&oe=69AC8A93\",\"caption\":\"12 Desember 2025\\nJum'at Bersih Kecamatan Jatisampurna \\n\\nAparatur Kecamatan Jatisampurna melaksanakan kegiatan rutin di hari Jum'at pagi yaitu Jum'at bersih \\nYang mana seluruh Aparatur Kecamatan Jatisampurna melaksanakan K-3 di lingkungan Kantor Kecamatan Jatisampurna.\\n\\nCamat mengharapkan lingkungan Kantor Kecamatan Jatisampurna harus terjaga kebersihannya agar warga yang datang ke kantor kecamatan Jatisampurna merasa nyaman.\\n\\nKarna kebersihan sebagian dari iman,maka Camat selalu memberikan arahan kepada jajaran nya untuk menjaga kebersihan lingkungan kantor, menyediakan tempat sampah di sudut-sudut kantor agar memudahkan warga membuang sampah.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765521763,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3785793404085940155_58589690880.jpg\"},{\"id\":\"DSJ1BabD9yp\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/589242328_17980090523954881_1615501084963107079_n.webp?stp=dst-webp_s720x720&_nc_cat=105&ig_cache_key=Mzc4NTc5MDE1NTMzNzQ4OTU3Nw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTA4MC5zZHIuQzMifQ%3D%3D&_nc_ohc=U2EZo9tAuOIQ7kNvwE5sLrL&_nc_oc=AdnvJEm3s5wLEArFJCXk2ZWjU7vx9E7Xxzktt8icB5NxHsnZCW185C_kYMEsovl8NRo&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_Afwb12ydlQvpm0WWPgFWcVpptX2hefbBmndwQqx556seaw&oe=69AC91AD\",\"caption\":\"12 Desember 2025\\nLaunching Maskot Kota Bekasi \\n\\nCamat Jatisampurna beserta Jajaran Camat Se-kota Bekasi menghadiri Launching Maskot Kota Bekasi di balai Patriot Kota Bekasi.\\n\\nCAMAT Menuturkan bahwa Maskot Adalah sebagai ciri atau simbol,biasa di artikan sebagai ciri khas dari daerah itu sendiri.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765521376,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3785790155337489577_58589690880.jpg\"},{\"id\":\"DSJzFEvD48S\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.71878-15/597828868_1185844850345504_8887549368457873372_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=103&ig_cache_key=Mzc4NTc4MTYxMDgzNTU3ODY0Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgzNjAuc2RyLkMzIn0%3D&_nc_ohc=ffeRkIfIuQAQ7kNvwHMndXr&_nc_oc=Adm1QjscIbfFCkksHLzCTvyoP6Y9X12lWgOEWEnKELibAti-ip3BZ1Ne-4hbZQygrLw&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_AfyDEEE0WYvDV26Zvdl_b6iGatZpQk56DOEApoPjYymFQg&oe=69AC88CF\",\"caption\":\"12 Desember 2025\\nJum'at Berkah Kecamatan jatisampurna\\n\\nCamat jatisampurna memimpin berjalan nya kegiatan rutin yaitu Jumat berkah Kecamatan jatisampurna di jalan Raya Kecamatan jatisampurna. \\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@harris.bobihoe \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765520429,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3785781610835578642_58589690880.jpg\"},{\"id\":\"DSJypHwj8aJ\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/587707811_17980089083954881_2466564411679759408_n.webp?stp=dst-webp_s720x720&_nc_cat=110&ig_cache_key=Mzc4NTc3OTY4MjExODQyMTUzMA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4NjA4LnNkci5DMyJ9&_nc_ohc=NuzTE2oZ3jEQ7kNvwHmO-5n&_nc_oc=AdlhpiiWIC6KXzr68Oc7iUGyOaKDHOE-yycYHtP9Jvp4XWk8jkPhzkSEtzofIftdRnY&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_AfzZd0hSshuri9m5qmONCvlR3gUmLhrJCiixa7z9kX5chw&oe=69AC7BC4\",\"caption\":\"12 Desember 2025\\nJum'at Berkah Kecamatan Jatisampurna \\n\\nKegiatan Rutin di Hari Jum'at yaitu Jum'at Berkah Kecamatan Jatisampurna,Seperti biasa kegiatan selalu di pimpin oleh Camat langsung.\\n\\nCamat Menuturkan bahwa makin Kesini makin banyak Bingkisan yang bisa di bagikan bagi warga,tentunya ini suatu kebanggaan yang harus kita pertahankan dan bukan tidak mungkin Jum'at yang akan datang makin banyak lagi dan lagi yang bisa di berikan untuk warga sekitar.\\n\\nCamat juga mengucapkan banyak terimakasih kepada semua unsur yang telah membantu dan memberikan Rizkinya untuk berbagi semoga apa yang kita lakukan menjadi ladang ibadah untuk kita semua.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765520128,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3785779689936635529_58589690880.jpg\"},{\"id\":\"DSJUD5hj288\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.71878-15/599717581_1764449750796121_6994598847328999646_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=101&ig_cache_key=Mzc4NTY0NTE5MDYzNjU5NzA1Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjY0MHgzNjAuc2RyLkMzIn0%3D&_nc_ohc=zSTUhRSQy9kQ7kNvwEmxb_M&_nc_oc=Adm5ebusAyQ88CJ0qCx0kg4eevrq8xOPrM63LEBJxq61-88nMAbpYuZLYOjp5dvd5HQ&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_Afw4i78fGf8zpUijrVAAa-lnVbJ-AGLTp1Fjp-J9HDrSGA&oe=69AC6CB8\",\"caption\":\"Penandatangan MOU PT.Warisan Matahari Makmur dengan Posyantek Rangga Hijau\\n\\nPenerapan Teknologi Pengolahan Ipal Posyantek, Selasa 09 Desember 2025.\\n\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@kelurahan.jatirangga\",\"post_time\":1765513538,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3785645190636597052_58589690880.jpg\"},{\"id\":\"DSH8bHQD-kx\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/585225653_17980012151954881_6763792394059132764_n.webp?stp=dst-webp_s720x720&_nc_cat=100&ig_cache_key=Mzc4NTI1OTc1NzgzMDQwMDMwNQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTA4MC5zZHIuQzMifQ%3D%3D&_nc_ohc=Xac7nAa1L88Q7kNvwHasr-M&_nc_oc=Adlgi4ZZTicsTi6hFOXGOLd7s2AXfrJnsPWP9HsUbIrQcAlVu7tvNSbpILA8h8Xhfxs&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_AfyB8d0W7xTiVb8Xt4Hm4HDhfDTF-5hDSPrxZSXnuQ3tLg&oe=69AC8B17\",\"caption\":\"11 Desember 2025\\nSelalu Terbuka dimanapun Berada \\n\\nCamat menerima warga di luar jam kerja untuk pembuatan admistrasi Surat Waris yang mana surat ini sangat di butuhkan segera.\\n\\nSetelah melalui pengecekan admistrasi kelengkapan persyaratan di kantor Kecamatan,karna memang agenda di wilayah padat Warga di minta secara langsung menemui Camat di wilayah.\\n\\nBukan berarti tidak selalu ada di kantor,tapi memang undangan-undangan warga di wilayah Kecamatan Jatisampurna begitu banyak yang harus di hadiri Camat,maka Camat berpesan kepada Aparatur jika ada yang membutuhkan tanda tangan beliau dan kebutuhannya sangat mendesak di harap untuk langsung menemui beliau di wilayah.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765458148,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3785259757830400305_58589690880.jpg\"},{\"id\":\"DSFCl_YD0Tr\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/584672237_17979887753954881_2239309625522775622_n.webp?stp=dst-webp_s720x720&_nc_cat=100&ig_cache_key=Mzc4NDQ0MjQ2MjI4NzY4NjQ2MA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4MTA4MC5zZHIuQzMifQ%3D%3D&_nc_ohc=uzPHx7UmRRUQ7kNvwGTG7rn&_nc_oc=AdmJ4fCpkumaZbBnunYY2WsF5O8LzIrys9UqYvcz9bu_lkvVhl7KL7EyCBq2V5xnX0c&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_AfzxCTK91KwCkrW76pR8m8q51hAJvKs7s21BM8agjoISPA&oe=69AC90CC\",\"caption\":\"10 Desember 2025\\nSilaturahmi ke Warga RW 05 Kelurahan Jatikarya\\n\\nSetelah memantau proses rutilahu dan selokan Camat bersilaturahmi ke wilayah RW 05 Kelurahan Jatikarya dan bertemu dengan ketua RW.\\n\\nKetua RW melaporkan kepada Camat ada beberapa titik di wilayahnya yang masih ada lahan kosong dan itu milik PT.Wiks yang saat ini bisa di gunakan untuk warga bercocok tanam dan memberikan Penghasilan bagi warga.\\n\\nTentunya Camat sedikit memberikan arahan bahwa Tanah yang di pergunakan adalah milik PT.Wiks dan warga harus menyadari itu,jika tanah ini akan di pergunakan oleh PT.wiks warga tidak lagi mempergunakan lahan tersebut agar tidak menjadi permasalahan.\\n\\nTetapi jika lahan tanah tersebut masih di berikan ijin oleh PT.Wiks untuk bercocok tanam maka pergunakanlah dengan sebaik-baiknya.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765360719,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3784442468637820139_58589690880.jpg\"},{\"id\":\"DSFBdovDyu7\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/589766853_17979886727954881_3224539586717993943_n.webp?stp=dst-webp_s720x720&_nc_cat=104&ig_cache_key=Mzc4NDQzNzQ4Nzg4NTA5MDA2Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4ODEwLnNkci5DMyJ9&_nc_ohc=x7i0L98eiLYQ7kNvwGm-zle&_nc_oc=AdlFss9pUzrzMxF_oA8q-9lzJVUiJn_JiYQECAESewT5KD2tc2ei3_9_CV8yiOX6lVY&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_AfyHwOC9oa6DvL6a1z2yKAo5QZWdH6U-r2orlBxwQIDwCw&oe=69AC8511\",\"caption\":\"10 Desember 2025\\nPeninjauan Langsung Camat Jatisampurna \\n\\nCamat Jatisampurna di Dampingi kasi Permas Kecamatan Jatisampurna dan Rekan Kelurahan Jatikarya meninjau langsung Rumah warga yang mendapatkan bantuan Rutilahu,Sekaligus memantau proses pengerjaan Selokan air yang ada di Kelurahan Jatikarya.\\n\\nCamat Mengutarakan bahwa beliau sangat senang bisa selalu turun ke wilayah memantau perkembangan wilayah Kecamatan Jatisampurna secara langsung, bersilaturahmi dengan warga dan ketua RT maupun RW.\\n\\nBeliau selalu memberikan arahan jika ada kesulitan pelayanan beliau selalu terbuka untuk mendengarkan keluhan warga dan mencari solusi terbaik dari segala keluhan warga.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765360127,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3784437496525302715_58589690880.jpg\"},{\"id\":\"DSEh5Muj3Hw\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/587792334_17979869468954881_6561799103209659884_n.webp?stp=dst-webp_s720x720&_nc_cat=106&ig_cache_key=Mzc4NDI5ODY0NTQ1ODc2ODcxMQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4ODEwLnNkci5DMyJ9&_nc_ohc=zgy4sz_NZxAQ7kNvwGwRUAt&_nc_oc=Adlx-phRtSJzO8smFC4ikTsnRXHgJPS1K_nhwp3d8r4tC0D4il5Tx8RNC2NW0AgwyHY&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_Afzh6LCmAWxOjhmL3Zn5-uO38cF9PIUIjR5UG393DVKoZw&oe=69AC73D9\",\"caption\":\"10 Desember 2025\\nKenaikan Tipe D Ke Tipe C Polsek Jatisampurna \\n\\nCamat Jatisampurna menghadiri undangan dari Kapolsek Jatisampurna dalam rangka Evaluasi Kinerja Polsek Jatisampurna menuju kenaikan Tipe D Ke Tipe C di Ruang Rapat Polsek Jatisampurna.\\n\\nTurut Hadir Juga Anggota DPRD Kota Bekasi \\nBpk.H.Anim Imammudin & Bpk.H.Edi yang mana beliau adalah putra daerah Jatisampurna yang terus berusaha membangun Kota Bekasi untuk lebih maju lagi terutama kemajuan Tempat kelahirannya.\\n\\nCamat menambahkan bahwa kinerja Polsek Jatisampurna sangatlah baik dan fasilitas Gedung juga cukup mempuni jadi sudah memadai untuk kenaikan ke Tipe C.\\n\\nCamat Juga Berharap dengan kenaikan Tipe D ke Tipe C ini harus di imbangi juga dengan baiknya Pelayanan bagi warga.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi \\n@polsekjatisampurna\",\"post_time\":1765343575,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3784298653109154288_58589690880.jpg\"},{\"id\":\"DSEghKmj7vp\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/588953491_17979868889954881_3081191680956705669_n.webp?stp=dst-webp_s720x720&_nc_cat=102&ig_cache_key=Mzc4NDI5MjU5NjEzOTg4NjU5MA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4ODEwLnNkci5DMyJ9&_nc_ohc=BJj_Wfd9OegQ7kNvwHAFyeH&_nc_oc=AdlmPM-2rox8ls0Lby9pzcGYJ5EokoH5qbwe08vUSvkuMnNOi1Sfsy16hWsXDYK9YMs&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_AfyXuC56AbCsIokGfNyZ6M4Bj1_FdiOYQV3dteiiUx9tgg&oe=69AC72F4\",\"caption\":\"10 Desember 2025\\nKunjungan Kerja Koramil Pondok Gede \\n\\nCamat menerima kunjungan kerja Koramil Pondok Gede di ruang Kerja Camat Jatisampurna,tentunya kunjungan kerja ini bertujuan untuk mempererat kinerja 3 Pilar di wilayah Kecamatan Jatisampurna.\\n\\nBanyak Warga yang tidak tahu bahwa Kecamatan Jatisampurna, Kecamatan Pondok Melati dan Kecamatan Pondok Gede hanya memilki satu Koramil yaitu Koramil Pondok Gede.\\n\\nKenapa Cuma satu Koramil...???\\n\\nKarna Wilayah Kecamatan Jatisampurna & Kecamatan Pondok Melati adalah Pemekaran dari wilayah Kecamatan Pondok Gede waktu wilayah Pondok Gede Masih Masuk Wilayah Kabupaten Bekasi,Begitu Pemekaran Menjadi Kota Bekasi maka Koramil nya masih menjadi satu.\\n\\nCamat berharap dalam satu wilayah Kecamatan bisa memiliki satu Koramil,tentunya ini juga menjadi harapan kita semua seperti Polsek Jatisampurna yang berawal kita masih bergabung dengan Polsek Pondok Gede.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi \\n@koramil02pondokgede\",\"post_time\":1765342854,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3784292603513519081_58589690880.jpg\"},{\"id\":\"DSEPXR8j06A\",\"image\":\"https://scontent-atl3-1.cdninstagram.com/v/t51.82787-15/588493948_17979858623954881_4831964824002459867_n.webp?stp=dst-webp_s720x720&_nc_cat=106&ig_cache_key=Mzc4NDIxNzE0NjU3NTI4MTAzNQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4NzIwLnNkci5DMyJ9&_nc_ohc=RBrMOmBA1moQ7kNvwGd7Xtd&_nc_oc=Adno4lrWvAqDndvXDH3MsCwYU8x_T4s_cb0nFthN1XsqVZ0oTv-2YLYDyhjkBOVj3gA&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-1.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_AfyManWiNCWjd4pxRIajke-pUOEFU3ikfy5JmJRbTJqBGQ&oe=69AC6B2F\",\"caption\":\"10 Desember 2025\\nApel Gabungan Aparatur TK Kecamatan Jatisampurna \\n\\nCamat Jatisampurna Memimpin Apel Gabungan Aparatur TK Kecamatan Jatisampurna yang rutin dilaksanakan pada hari Rabu yang di ikuti seluruh aparatur Sekecamatan Jatisampurna baik di Kelurahan maupun di UPTD UPTB yang bertugas di lingkup Kecamatan Jatisampurna.\\n\\nApel Gabungan hari ini 10 Desember 2025 di laksanakan di halaman Kantor Kelurahan Jatikarya di jl.Sasak Cempling.\\n\\nCamat menyampaikan beberapa arahan salah satunya kesiapan Aparatur Kecamatan Jatisampurna,Rekan Polsek Jatisampurna dan Rekan Koramil dalam menyiapkan Pengamanan Nataru (Natal & Tahun Baru 2026).\\n\\nRencana malam ini akan dilaksanakan rapat persiapan malam Natal & Tahun Baru,Camat meminta Bidang trantibum untuk menyiapkan semua kesiapan nya termasuk undangan untuk para Tokoh dan para pemuka agama yang ada di Kecamatan Jatisampurna.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765333860,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3784217157413326464_58589690880.jpg\"},{\"id\":\"DSCVaVAjygq\",\"image\":\"https://scontent-atl3-2.cdninstagram.com/v/t51.82787-15/588222994_17979782102954881_205597220558215811_n.webp?stp=dst-webp_s720x720&_nc_cat=102&ig_cache_key=Mzc4MzY4MDc5NTgyNDA3OTc0Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4NjA3LnNkci5DMyJ9&_nc_ohc=TJdbTmZ60SwQ7kNvwE-09Fq&_nc_oc=Adk5I0fomEBFz1nDlhSpVdMUEU-3lKKFrdLaBzczKcV8eDOk5NueoCwXKKGd7DVZPj0&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-2.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_AfyVf6tOAZnXDc4jVXMlXdKTs6XMmoj9Xxiy5mP3U6WpEg&oe=69AC8FBF\",\"caption\":\"09 Desember 2025\\nSwakelola Penataan Lingkungan RW Bekasi Keren\\n\\nBpk.Nurdin (Sekertaris Camat Jatisampurna) membuka kegiatan Swakelola Penataan Lingkungan RW Bekasi Keren di Wilayah RW.007 Kelurahan Jatiraden turut hadir juga mendampingi Lurah Jatiraden Bpk.Agus Budianto.\\n\\nSwakelola Penataan Lingkungan RW Bekasi Keren adalah Para ketua RW yang menerima uang Swakelola Penataan RW Bekasi Keren yang berjumlah Rp.100.000.000 juta.\\n\\nAdapun uang Sejumlah tersebut bisa dibelanjakan untuk keperluan penataan lingkungan RW yang berupa barang tidak habis pakai dan setiap pembelian barang harus bisa di pertanggung jawabkan.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765269922,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3783680805185726506_58589690880.jpg\"},{\"id\":\"DSB3ik2Dzqh\",\"image\":\"https://scontent-atl3-3.cdninstagram.com/v/t51.82787-15/574507792_17979764177954881_7555670091339085141_n.webp?stp=dst-webp_s720x720&_nc_cat=108&ig_cache_key=Mzc4MzU0OTQyMTg1OTM1MzEwNQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6InhwaWRzLjEwODB4ODEzLnNkci5DMyJ9&_nc_ohc=a45-sZDm8JsQ7kNvwGAsE1k&_nc_oc=AdnHlSW-4LT96Be3SzszNcH1Z0CE607rcPDjdo7lkq5xMEkfuLHztH1V-tomsKGvaF8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-atl3-3.cdninstagram.com&_nc_gid=AQq-v3aMRwhlYW2QCiiG4g&_nc_ss=8&oh=00_Afyh4DmYSFu0AHujBx7lcpW6l-inZEl57JPVm_cUQVLJ1w&oe=69AC6FB3\",\"caption\":\"09 Desember 2025\\nPembinaan Linmas, Sekaligus Pemberian Beras Rutin bagi anggota linmas\\n\\nCAMAT Jatisampurna beserta Jajaran Trantibum memberikan pembinaan sekaligus memberikan Beras yang biasa rutin di terima bagi anggota linmas Setiap bulannya.\\n\\nCamat mengucapkan banyak terimakasih kepada jajaran linmas Sekecamatan Jatisampurna yang sudah mendedikasikan diri menjadi anggota linmas,seperti kita ketahui linmas adalah penyemibang keamanan di lingkungan.\\n\\nPemerintah Kota Bekasi sampai saat ini terus berkomitmen untuk kesejahteraan Linmas dengan adanya insentif Linmas & Pemberian Beras tiap bulannya, anggota linmas juga di berikan jaminan kesehatan berupa BPJS yang terdata sebagai penerima jaminan kesehatan di bawah naungan Pemerintah Kota Bekasi.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1765254261,\"owner\":\"58589690880\",\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/3783549430549920417_58589690880.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918843049,\"id\":\"DZUqaNYD3LE\",\"image\":\"https://scontent-iad3-1.cdninstagram.com/v/t51.82787-15/719189464_18001546874954881_5838496803285278133_n.webp?stp=dst-webp_s720x720&_nc_cat=104&ig_cache_key=MzkxNDkzNjg5NDA4ODk4MTIxNQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=A-23vmqv-dYQ7kNvwFAQGNy&_nc_oc=AdpWyQLrGKdJd6A6tTIi869lhCa5ofTTLNevlADNyP17D5Bga4SICSW3tCaRykilsVE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=mGf2Y9iiZ64BqfW6U8-Hag&_nc_ss=7a22e&oh=00_Af-jTQSs4drimHdOEmJ-1lcqgflIgE4a3jyXJwCEqhFQ1g&oe=6A2C9750\",\"caption\":\"8 Juni 2026\\nRoadshow Kota Bekasi Sehat Menuju Swastisaba Wistara 2027\\n\\nCamat Jatisampurna Bpk.Nata Membuka Kegiatan sosialisasi Kota Bekasi Sehat Menuju Swastisaba Wistara 2027 di aula Kantor Kecamatan Jatisampurna.\\n\\nKegiatan ini di ikuti oleh oleh para Lurah Sekecamatan Jatisampurna,Kepala Puskesmas Sekecamatan Jatisampurna dan Rekan RSUD Jatisampurna.\\n\\nCamat menerangkan bahwa Swastisaba Wistara yaitu Penghargaan yang diberikan kepada daerah yang dinilai berhasil menciptakan lingkungan yang bersih, nyaman, aman, dan sehat melalui penerapan berbagai tatanan.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1780917296,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":0,\"like_count\":8,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DZUqaNYD3LE.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918843049,\"id\":\"DZMV8xFj-qi\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/714852618_18001106834954881_7067911340352953791_n.webp?stp=dst-webp_s720x720&_nc_cat=106&ig_cache_key=MzkxMjU5NTA1MTY0NDk2MDIyMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=qROSF0rcv1QQ7kNvwF95Z-R&_nc_oc=AdpEqp-c4RyCIcJh5GRxVMtUNV3bTJ4Kx1bULlHklKunvFOiki-GbDljCer-Wgeesuk&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=mGf2Y9iiZ64BqfW6U8-Hag&_nc_ss=7a22e&oh=00_Af84pAokxLquu-orIKkph53ar8UrS_izmm7O51IDffjQng&oe=6A2C6D7B\",\"caption\":\"5 Juni 2026\\nJumat Berkah Kecamatan Jatisampurna \\n\\nCamat Jatisampurna di dampingi Sekertaris Camat,Kasi Kesos, Kasubag Keuangan,dan Kasi Pemerintahan Kecamatan Jatisampurna melaksanakan kegiatan rutin yang dilaksanakan setiap hari Jum'at yaitu Jumat Berkah Kecamatan Jatisampurna.\\n\\nJumat Berkah ini menunjukan bentuk keperdulian Aparatur Kecamatan Jatisampurna kepada sesama.\\n\\nKegiatan ini sendiri sudah cukup lama dilaksanakan dan berjalan sampai saat ini,Camat Jatisampurna Bpk.Nata Wirya menerangkan bahwa selama beliau masih di Jatisampurna insya Allah kegiatan ini akan terus ia jalankan.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1780638134,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":10,\"like_count\":96,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DZMV8xFj-qi.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918843049,\"id\":\"DZMUdWSPOoH\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/714765844_18001105835954881_897426719872655868_n.webp?stp=dst-webp_s720x720&_nc_cat=106&ig_cache_key=MzkxMjU5MjE1NDAwMTQ2NzkxMQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=H2_pXQ0nblcQ7kNvwFdXW-J&_nc_oc=AdqACRzWYy4QcOJc3a2PL5gt3KqdngNU1_l0gNe2ROirlALzGthvF1i4pV0Nx4TekXI&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=mGf2Y9iiZ64BqfW6U8-Hag&_nc_ss=7a22e&oh=00_Af9eF-DlQOIf4xkj99G16w1foERc0w2DJFHA9xhQyRhuCA&oe=6A2C80CA\",\"caption\":\"5 Juni 2026\\nWFH Aparatur Sekecamatan Jatisampurna \\n\\nCamat Jatisampurna memimpin berjalannya Zoom bersama Aparatur Sekecamatan Jatisampurna yang sedang melaksanakan WFH.\\n\\nZoom Ini dilaksanakan Pukul 09:00 s/d 10:00 Wib\\nDilaksanakan setiap hari Jum'at dan wajib menggunakan Bahasa Inggris.\\n\\nCamat mengutarakan bahwa Aparatur yang menjalankan WFH bukan berarti libur mereka harus mengerjakan tugas di rumah dan melakukan absensi Mobile Pukul 07:00,12:00 dan 16:00 dengen titik koordinat rumah masing-masing.\\n\\nCamat juga menekankan jika ada pekerjaan yang mendesak dan sangat penting maka aparatur yang menjalankan WFH harus bisa hadir ke kantor.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1780637355,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":4,\"like_count\":76,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DZMUdWSPOoH.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918843049,\"id\":\"DZJ9TIyj_nn\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/715059847_18000982403954881_8012540454664671318_n.webp?stp=dst-webp_s720x720&_nc_cat=107&ig_cache_key=MzkxMTkyMzM3MTg1MTIxNTg0Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=SS_YhR0uu48Q7kNvwEZViIO&_nc_oc=AdoWt37-WXesGGf9-FUoAIf-b_qw8583crdg7_YFgYsBz-eT7WMcpT5UnS26vLgY49k&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=mGf2Y9iiZ64BqfW6U8-Hag&_nc_ss=7a22e&oh=00_Af-Kx8410TzGeknPABaBcvPagXsbC-cbfKnr9dMpW-kz4w&oe=6A2C62AC\",\"caption\":\"04 Juni 2026\\nSosialisasi Pengendalian Gratifikasi Tingkat Kecamatan Jatisampurna.\\n\\nCamat Jatisampurna di dampingi Rekan Inspektorat Kota Bekasi, Sekertaris Camat Jatisampurna dan Jajaran Lurah Sekecamatan Jatisampurna membuka kegiatan Sosialisasi Pengendalian Gratifikasi Tingkat Kecamatan Jatisampurna di aula Kantor Kecamatan Jatisampurna.\\n\\nDengan diadakan nya Sosialisasi ini Camat berharap kita semua memahami apa bentuk Grafikasi yang sering terjadi di lingkungan ASN dan menjauhi bentuk-bentuk Grafikasi.\\n\\nTentunya Camat Jatisampurna dan jajaran selalu menjunjung sikap integritas Sebagai ASN menolak Keras apapun itu bentuk Grafikasi.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi \\n@apip_bekasi\",\"post_time\":1780558101,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":0,\"like_count\":85,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DZJ9TIyj_nn.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918843049,\"id\":\"DZHZ3WyPg89\",\"image\":\"https://scontent-iad3-1.cdninstagram.com/v/t51.82787-15/712763371_18000857540954881_4382189450161679698_n.webp?_nc_cat=108&ig_cache_key=MzkxMTIwODU1NjU5MzgxMTI2MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuODEwLnNkci5yZWd1bGFyX3Bob3RvLkMzIn0%3D&_nc_ohc=iQn7xgpBBtgQ7kNvwFWGsZ_&_nc_oc=Adp_jrGDmE6TYC2cELhmlTR1C81UxIk5957vdyfhs6F_qPzZR60FC8f1EBUSmJId91w&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=mGf2Y9iiZ64BqfW6U8-Hag&_nc_ss=7a22e&oh=00_Af-T5GzpqrmK-uMVwdQl2RM8-_puvZ91gNw3rYsc5sWFYA&oe=6A2C8EDE\",\"caption\":\"03 Juni 2026\\nKoperasi Merah Putih Kelurahan Jatiranggon\\n\\nCamat Jatisampurna Bpk.Nata Wirya Memantau Proses Pembangunan berdiri nya Koperasi Merah Putih yang ada di Kelurahan Jatiranggon, Kecamatan Jatisampurna.\\n\\nCamat memastikan bahwa semua program Pemerintah baik itu Tingkat Kota Bekasi maupun Nasional harus di Jalankan dan di dukung penuh oleh beliau selaku pemimpin di Kecamatan Jatisampurna.\\n\\nCamat memastikan bahwa program Koperasi Merah Putih yang di Gagas oleh Presiden Republik Indonesia Bpk.Prabowo Subianto harus berjalan di wilayah Kecamatan Jatisampurna dan Alhamdulillah Proses Pembangunan tempat Koperasi Merah Putih di Lima Kelurahan Sekecamatan Jatisampurna sudah berjalan.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1780472417,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":39,\"like_count\":204,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DZHZ3WyPg89.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918843049,\"id\":\"DZHYK5EPNqT\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/711230472_18000856379954881_1333927362047266186_n.webp?stp=dst-webp_p720x720&_nc_cat=106&ig_cache_key=MzkxMTIwMTEwMjk3OTk3OTkyMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=3Hbjk_zmZ8YQ7kNvwGUOL88&_nc_oc=AdoSOLpGy4T7L2k8CxwHU1n6HJ2koMMDck7aH6x776HHqcBwrYFltPHIEZ672sXY1B8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=mGf2Y9iiZ64BqfW6U8-Hag&_nc_ss=7a22e&oh=00_Af84z23lUguo5c5VrW_9M3Gh3phSXmJxunfaeOVtJ3o9nw&oe=6A2C72C2\",\"caption\":\"03 Juni 2026\\nTakziah Ke Keluarga Brigjen Dolay Tokoh Masyarakat Kelurahan Jatirangga.\\n\\nCamat Jatisampurna Mengucapkan Turut berdukacita atas Kepergian ibu.Hj.Setiowati Istri Bapak Brigjen Dolay yang mana semasa Hidupnya Beliau Sangat dermawan sering membantu warga sekitar RW.04 Kelurahan Jatirangga.\\n\\nSemoga Amal ibadah beliau diterima di disisi Allah SWT dan keluarga yang di tinggalkan di berikan Kesabaran dan Ketabahan.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1780471528,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":2,\"like_count\":92,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DZHYK5EPNqT.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918843049,\"id\":\"DZHVw4Hj05n\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/714765878_18000835658954881_3708191238969741008_n.webp?stp=dst-webp_s720x720&_nc_cat=106&ig_cache_key=MzkxMTA2NTYyNDQ1Mjc0MjYyNw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMzk5OC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=BOSQCn-k0XAQ7kNvwEOhSUz&_nc_oc=Ado3TfcgZazFbZv7F15--galZrp161PVKtyXRu1LSoMxRZTbLKY36QqAp8AMZTkrVFs&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=mGf2Y9iiZ64BqfW6U8-Hag&_nc_ss=7a22e&oh=00_Af9behGOmq7W7uV_fyjvepc5HzBTYOuK7GVDui09zpJK6g&oe=6A2C8D3E\",\"caption\":\"03 Juni 2026\\nPemberian Bonus Prestasi Peraihan Pembayaran PBB Perwilayah RW Sekecamatan Jatisampurna \\n\\nCamat Jatisampurna di dampingi Sekertaris Camat, Jajaran Lurah Sekecamatan Jatisampurna dan Kepala UPTD Pendapatan Kecamatan Jatisampurna memberikan Bonus Prestasi Kepada Para Pamor Kelurahan yang meraih 90 % Pembayaran Lunas Warganya.\\n\\n1.Yoga.  Pamor RW.06 Kel.Jatikarya\\n2.Indrabangsawan.  Pamor RW.09 Kel.Jatikarya\\n3.Ahmad Jayadi.  Pamor RW.19 Kel.Jatisampurna\\n\\nCamat Mengucapkan Banyak terimakasih Kepada Para Warga RW.06,RW.09 Kelurahan Jatikarya dan Warga RW.19 Kelurahan Jatisampurna yang sudah Taat Membayar Pajak Bumi Dan Bangunan Tahun 2026.\\n\\nCamat juga menghimbau Kepada warga yang masih belum membayar Pajak Bumi Dan Bangunan Tahun 2026 untuk segera membayarnya.\\n\\nUntuk mempermudah Pembayaran warga cukup membayar ke Para petugas untuk di bantu proses pembayaran nya,atau bisa menggunakan Qris yang sudah di sediakan petugas di setiap RW Sekecamatan Jatisampurna.\\n@mastriadhianto\\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi \\n@badanpendapa\",\"post_time\":1780470264,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":0,\"like_count\":91,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DZHVw4Hj05n.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918843049,\"id\":\"DZHIgNbKrV4\",\"image\":\"https://scontent-iad3-1.cdninstagram.com/v/t51.71878-15/714403706_1393656002540744_4340111534360014372_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=101&ig_cache_key=MzkxMTEzMjE5OTIwNDMzNzAxNg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=KkVlbRLYb3YQ7kNvwFid66J&_nc_oc=AdrwYpdnPENOQ4_qqtEfarGVQmr8D_ZU_vAgabFumTSqokR3FDTqDOINCIwRdz-mIhE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=mGf2Y9iiZ64BqfW6U8-Hag&_nc_ss=7a22e&oh=00_Af9RPsVnRw6GvKPHxZfbkJsOQfRmZFzYynJLMXsRZf4ZVg&oe=6A2C7C8A\",\"caption\":\"Siapa yang paling sering jadi tempat curhat teman?🙋‍♀️🙋‍♂️\\n\\nNah, itulah peran teman sebaya! 💙\\nMendengar tanpa menghakimi, mendukung tanpa memaksa, dan membantu menemukan jalan keluar bersama.\\n\\nYuk jadi teman sebaya yang positif dan inspiratif bersama PIK-R! ✨\\n\\n#TemanSebaya #dppkbkotabekasi #smpn15bekasi #kemedukbangga #kemendukbanggajabar\",\"post_time\":1780463462,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":0,\"like_count\":38,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DZHIgNbKrV4.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918843049,\"id\":\"DZG5GXDj6_1\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/714838868_18000835271954881_1836067870187554461_n.webp?stp=dst-webp_s720x720&_nc_cat=102&ig_cache_key=MzkxMTA2MjI1Mjc3NzQyNDA0MA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=QnJvBkteBvUQ7kNvwHIAh5J&_nc_oc=AdrzXdDfFdUyp0XbEWFf8qP4l4RFH9gthry5eeKu43vX5teaAW6tb0lnqTzQqsZYQTc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=mGf2Y9iiZ64BqfW6U8-Hag&_nc_ss=7a22e&oh=00_Af-bZMD5xGdNKPHqwRdJsoglge66xyNQTld0GFIbcHPY7w&oe=6A2C889F\",\"caption\":\"03 Juni 2026\\nApel Gabungan Aparatur TK Kecamatan Jatisampurna \\n\\nCamat Jatisampurna memimpin Apel Gabungan Aparatur TK Kecamatan Jatisampurna di ikuti seluruh aparatur Sekecamatan Jatisampurna baik di UPTD UPTB yang bertugas di lingkup Kecamatan Jatisampurna.\\n\\nCamat menyampaikan bahwa kegiatan apel Gabungan Aparatur TK Kecamatan Jatisampurna menjadi momentum beliau menyampaikan hal-hal penting atau kegiatan yang akan dilaksanakan atau pekerjaan yang akan di kerjakan satu pekan kedepan.\\n\\nCamat juga menekankan bahwa apel adalah kewajiban kita sebagai aparatur sebelum menjalankan tugas-tugas.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1780455236,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":3,\"like_count\":92,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DZG5GXDj6_1.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DZFNfokvM8B\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/714830497_18000746297954881_8562147624764371068_n.webp?stp=dst-webp_s720x720&_nc_cat=106&ig_cache_key=MzkxMDU5MTE5OTkxNTU5MzQ3Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=h7nV0JAjyR8Q7kNvwGhGSGq&_nc_oc=Adrjr4q4-grcLnK4yLOPWMGIv7NBNrK-jlGkK9efXeH3wld0hNwfZ96V8qX3fyOvYU8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af9pdoVP0hovIbhjXAUZFaDfSwQgVHoieotxyvSBgT_bXw&oe=6A2C8EE3\",\"caption\":\"2 Juni 2026\\nKuliah Gratis untuk Warga Kecamatan Jatisampurna \\n\\nCAMAT Jatisampurna Bpk.Nata Wirya Menerima Kunjungan Dari Rekan Universitas Arlindo membahas  Program kuliah gratis bagi 50 Orang Warga Kecamatan Jatisampurna.\\n\\nCamat menerangkan Bahwa 50 Orang ini tentunya yang tidak mampu secara Materi dan harus memiliki surat keterangan tidak mampu yang di ketahui ketua RT, RW,Lurah dan Camat.\\n\\nTentunya Program ini sangat bermanfaat bagi warga Kecamatan Jatisampurna apalagi untuk Adik-adik kita yang Masih ingin terus mengejar cita-cita namun terbentur oleh ekonomi.\\n\\nCamat sangat mengucapkan Terimakasih Kepada universitas Arlindo yang terus bersinergi dengan lingkungan sekitar,dari mulai santunan anak yatim piatu dan dhuafa hingga Program Kuliah Gratis.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1780398822,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":11,\"like_count\":151,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DZFNfokvM8B.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DZBZyJPTzTz\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/712099618_18000549383954881_7629464440860406305_n.webp?stp=dst-webp_s720x720&_nc_cat=102&ig_cache_key=MzkwOTUxOTM0ODU5MTQ0MTEzOQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=Agt8x_4Ik-cQ7kNvwHgfd_R&_nc_oc=AdreuB2QfPFyW4uLr21qZzJZG6bCsoYHVu46QAPnn5G-PKzQCiySnCOCZO5uEdXnY-0&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af9UOATEC5rNCNYKpX8W2rmwhH1AMq4r5LXGLwancf0gug&oe=6A2C739B\",\"caption\":\"1 Juni 2026\\nHari Lahir Pancasila \\n\\nBpk.Nata Widya, S.Sos,M.Si (Camat Jatisampurna) \\nMengucapkan Selamat Hari Lahir Pancasila. \\n\\nPada peringatan Hari Lahir Pancasila,kita warga Indonesia diingatkan kembali untuk meneguhkan nilai-nilai Pancasila dalam kehidupan sehari-hari maupun berbangsa dan bernegara. \\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1780271048,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":5,\"like_count\":96,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DZBZyJPTzTz.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DY6RbKwjzuH\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/708987169_18000157355954881_5360462431481285726_n.webp?stp=dst-webp_s720x720&_nc_cat=106&ig_cache_key=MzkwNzUwNzk0NjQ4NDg0OTMwOQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA3OC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=5Il_zbx0GcUQ7kNvwFOQX9A&_nc_oc=Adp5jTeomNVC4mc8AwmPN5MytmcPrQD-r7L2LbIYuMHEIyDW3D58ZkrhLDuKxqObfJQ&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af9DIWq4_rBcAB2jXfeTf0z8jVoDT_vvrVcaa9Qa5tcW2w&oe=6A2C728F\",\"caption\":\"29 Mei 2026\\nJum'at Berbagi Kecamatan Jatisampurna \\n\\nBpk.Nata Wirya ( Camat ) Di dampingi Bpk.Nurdin (Sekertaris Camat) melaksanakan kegiatan rutin yaitu Jumat Berbagi Aparatur Kecamatan Jatisampurna.\\n\\nCamat mengutarakan bahwa kegiatan ini adalah kegiatan yang rutin dilaksanakan pada hari Jum'at dan sudah berjalan sudah cukup lama,tentunya dengan kegiatan Jum'at berbagi ini,bisa bermanfaat bagi warga sekitar.\\n\\nPada Jumat berbagi pada hari ini memang sengaja Camat Jatisampurna mengundang beberapa teman-teman ojek online yang ada di wilayah Kecamatan Jatisampurna, tentunya untuk sedikit membantu mereka dalam mengejar rejeki.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@diskominfobekasi \\n@pemkot_bekasi\",\"post_time\":1780031782,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":6,\"like_count\":116,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DY6RbKwjzuH.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DY6PF_GD59v\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/706016241_18000156284954881_4967900031076589169_n.webp?stp=dst-webp_s720x720&_nc_cat=109&ig_cache_key=MzkwNzQ5OTU3NjEzODg3MjgyNw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=Hh6aRKyaCMUQ7kNvwGU2VKA&_nc_oc=AdqQmBTFawTruiQqlcgj1pCbS-hNUB7VJtc6IaQEfHzIlNd7pHgI3S7Mh8SdwUkIcs0&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af8sS-s1x4v-FRyEh3fMAEWzwPeMALSpnA3zRuunG6IHzw&oe=6A2C9758\",\"caption\":\"29 Mei 2026\\nListening Bahasa Inggris dalam kegiatan WFH Aparatur Sekecamatan Jatisampurna.\\n\\nCamat Jatisampurna Bpk.Nata Wirya memimpin berjalannya Zoom listening Bahasa Inggris dengan para aparatur Sekecamatan Jatisampurna yang sedang melaksanakan WFH.\\n\\nCamat menerangkan bahwa Kegiatan ini merupakan kegiatan rutin di hari Jum'at,dan setiap ada Aparatur yang menjalankan WFH wajib mengikuti zoom dan berkomunikasi dengan menggunakan Bahasa Inggris.\\n\\nTentunya penggunaan bahasa inggris di hari Jum'at menjadi kewajiban bagi Aparatur Kota Bekasi tujuannya menciptakan Aparatur yang bertarap internasional.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1780030560,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":0,\"like_count\":120,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DY6PF_GD59v.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DY1IwrIPUyo\",\"image\":\"https://scontent-iad3-1.cdninstagram.com/v/t51.82787-15/705528526_17999886773954881_2648051232858291696_n.webp?stp=dst-webp_p720x720&_nc_cat=108&ig_cache_key=MzkwNjA2Njc4MTAyOTg3ODk1Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=LvJZtGqZ4z8Q7kNvwGpGB4b&_nc_oc=AdotOuxJLCx3bQaCdO9ci7brgv7mTbZvC2EdIFFmdgxR5_PU89SV_X9vPsPqKwhhlYo&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af-hGzaREtBazu2NJZoJ1UVwzN0ndEKu2O2tpjPQkleGug&oe=6A2C784A\",\"caption\":\"27 Mei 2026\\nSelamat Hari Raya Idul Adha 1447 Hijriah\\n\\nBpk.Nata Wirya selaku Pribadi & Atas Nama Camat Jatisampurna mengucapkan Selamat merayakan Hari Raya idul Adha 1447 Hijriah.\\n\\nHari Raya Idul Adha bermakna sebagai bentuk ketakwaan, ketaatan, dan keikhlasan tertinggi kepada Allah SWT, yang direfleksikan melalui sejarah pengorbanan Nabi Ibrahim AS dan Nabi Ismail AS. Perayaan ini juga identik dengan ibadah kurban (menyembelih hewan) untuk berbagi rezeki kepada sesama serta ibadah haji. \\n@mastriadhianto\\n@harris.bobihoe\\n@nata.wirya\\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi \\n#harirayaiduladha \\n#jatisampurna\",\"post_time\":1779859470,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":3,\"like_count\":100,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DY1IwrIPUyo.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DYyxlO0Pntf\",\"image\":\"https://scontent-iad3-1.cdninstagram.com/v/t51.82787-15/705981698_17999767739954881_763942782469712196_n.webp?stp=dst-webp_s720x720&_nc_cat=108&ig_cache_key=MzkwNTQwMTg4OTY5MjIyMDI1NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=B4oYDcyCruAQ7kNvwFYNu3U&_nc_oc=Adqk0FpgVLsLxCihGr8a_sUYin6OP6VH018WMrIVrreqAoWR1AtX094iNyj5J70RMdg&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af_m6B6lesOihx69H8uUbDfvtw-IXGBUbN27QpMEeAEhCw&oe=6A2C7AC2\",\"caption\":\"2026\\nTakziah Kerumah Duka Warga Kelurahan Jatirangga \\n\\nBpk.Nata Wirya (Camat) Selalu menyempatkan Waktu Jika ada warga nya yang meninggal untuk bertakziah.\\n\\nTentunya sebagai pemimpin beliau berharap bisa melayani dan membantu warganya dalam keadaan apapun.\\n\\nBeliau selalu menjunjung tinggi nilai-nilai silaturahmi dan kekeluargaan dan tidak pernah menginginkan batasan bahwa siapapun warga Kecamatan Jatisampurna adalah keluarga beliau yang harus mendapatkan perhatian.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1779780208,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":0,\"like_count\":141,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DYyxlO0Pntf.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DYyvdM6DzzN\",\"image\":\"https://scontent-iad3-2.cdninstagram.com/v/t51.82787-15/705374920_17999765708954881_860118079390920872_n.webp?stp=dst-webp_s720x720&_nc_cat=111&ig_cache_key=MzkwNTM4OTM5NzQ5NDUxNjkwOA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=Cl43XN8vFdwQ7kNvwF1XSHj&_nc_oc=AdpRkl1bu-X4WflPBbYbJ6WvIx9F8UurqYYTSYhhR5XfHn8R-7Y-1Pk3aHfd7Adw5Tg&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad3-2.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af87je2wEivZQLPvurjP_6sxcZ-ygCrjEB1jVNExdqEwww&oe=6A2C8CF5\",\"caption\":\"26 Mei 2026\\nPMT Lokal untuk Pemenuhan Balita yang memenuhi Gizi \\n\\nBpk.Nata Wirya (Camat) di dampingi Lurah Sekecamatan Jatisampurna & Kepala UPTD Puskesmas Sekecamatan membuka kegiatan sosialisasi PMT Lokal balita yang memenuhi Gizi TK Kecamatan Jatisampurna.\\n\\nCAMAT menerangkan bahwa PMT Lokal adalah program Pemberian Makanan Tambahan berbahan dasar pangan atau sumber daya setempat (seperti ikan, telur, tahu, tempe, dan umbi-umbian) yang ditujukan untuk meningkatkan status gizi balita dan ibu hamil. \\n\\nTentunya Camat tidak berharap di wilayah Kecamatan Jatisampurna ada bayi yang kekurangan Gizi karna menurut beliau di Kecamatan Jatisampurna selalu ditingkatkan Pelayanan Posyandu di setiap RW Sekecamatan Jatisampurna.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1779779092,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":0,\"like_count\":120,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DYyvdM6DzzN.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DYytGBWD19d\",\"image\":\"https://scontent-iad3-1.cdninstagram.com/v/t51.82787-15/705327007_17999763530954881_8035976756532362565_n.webp?stp=dst-webp_s720x720&_nc_cat=101&ig_cache_key=MzkwNTM3OTYxNjMxMDQzNzUwMg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=qazi1bULk2EQ7kNvwEuIq6P&_nc_oc=AdosaAUXGvGaUZlV5YHcolHab_YpK4TacPQJVTIqZLwtW0EyjDvsvsZHRuGH1S472og&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af96iSlWH333U51vS73NUwmn0xce-KhZapE-9U8MnpIvTw&oe=6A2C74C8\",\"caption\":\"25 Mei 2026\\nKoordinasi dengan Kasubag Keuangan & Kasubag Kepegawaian Kecamatan Jatisampurna \\n\\nSetelah melaksanakan kegiatan tingkat Kota Bekasi Sesampainya Di kantor Kecamatan Jatisampurna Camat langsung Meminta kepada kasubag Keuangan & Kasubag Kepegawaian untuk segera berkoordinasi dengan Beliau tentang beberapa hal penting terkait dua bidang ini.\\n\\nTentunya Camat akan selalu mengevaluasi apapun itu terkait pekerjaan yang belum selesai atau yang sedang dikerjakan.\\n\\nCamat Tidak menginginkan pekerjaan itu berlarut-larut tidak terselesaikan,jika ada kesulitan Camat sangat terbuka untuk saling bertukar pikiran dan saling mencari solusinya.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1779777853,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":1,\"like_count\":115,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DYytGBWD19d.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DYysY2tD-0s\",\"image\":\"https://scontent-iad3-2.cdninstagram.com/v/t51.82787-15/706990906_17999763323954881_105779355442109508_n.webp?stp=dst-webp_s720x720&_nc_cat=111&ig_cache_key=MzkwNTM3NTM4NTYxNjgwOTQxMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=GWmLaS5gw5kQ7kNvwHtuV9l&_nc_oc=AdpihfzrIJFn_28L8RkuZyPtLRXmFfRkzvnE1chvxK95xyyCa5tviPFZbW717q9yU04&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad3-2.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af89MDxsEcIdMXOk6A0azvvbwbo8-KkmD9vYGyQrIjxoRQ&oe=6A2C6B9F\",\"caption\":\"25 Mei 2026\\nSosialisasi Pengawasan Penyelenggaraan Pemerintahan Tahun 2026\\n\\nSekertaris Camat Jatisampurna Bpk.Nurdin dan Kasi Kesos Kecamatan Jatisampurna Bpk.Encup Supratman mendampingi Anggota DPRD Propinsi Jawa Barat Ibu.Ade Puspitasari dalam kegiatan Pengawasan Penyelenggaraan Pemerintahan Tahun 2026 di Aula Kantor Kecamatan Jatisampurna.\\n\\nPenyelenggara pemerintahan adalah pihak yang memiliki wewenang dan tanggung jawab dalam menjalankan fungsi negara untuk melindungi, melayani, memberdayakan, dan menyejahterakan masyarakat berdasarkan ketentuan peraturan perundang-undangan. \\n@mastriadhianto\\n@harris.bobihoe\\n@adepuspitasari_18\\n@nata.wirya\\n@akamsih74\\n@pemkot_bekasi\\n@diskominfobekasi\",\"post_time\":1779777483,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":0,\"like_count\":98,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DYysY2tD-0s.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DYyrPZgv2aJ\",\"image\":\"https://scontent-iad6-1.cdninstagram.com/v/t51.82787-15/706035749_17999762444954881_7206594424908439202_n.webp?stp=dst-webp_s720x720&_nc_cat=106&ig_cache_key=MzkwNTM3NDAwMTA2ODcyOTk5Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=jLq4MtcYJLsQ7kNvwGqearq&_nc_oc=AdouqkLlgG2biN8n4FkwIBfd44xOt737WF9oPW_7YfF7GjzRAdKJNhOLt7NAncM7zl8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af8I06IuAXeF0oN-0_twE38BhakYCLm8ZM3F7LV-XB_4WQ&oe=6A2C76C4\",\"caption\":\"25 Mei 2026\\nSosialisasi SPMB SMAN 7 Kota Bekasi \\n\\nSekertaris Camat Jatisampurna Bpk.Nurdin Menghadiri Undangan Sosialisasi SPMB SMAN 7 Kecamatan Jatisampurna.\\n\\nSekcam menyampaikan ucapan maaf kepada para tamu undangan karna Sejatinya Kegiatan sosialisasi ini di hadiri oleh Bpk.Nata Wirya (Camat) tapi karna banyak nya kegiatan yang membuat Camat dan Sekcam terus berbagi tugas hingga saling mewakili.\\n\\nDengan di adakannya sosialisasi SPMB SMAN 7 pada hari ini Sekcam berharap dapat di pahami proses pendaftaran siswa-siswi SMAN 7 baru tahun 2026.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi \\n@sman7_bekasi\",\"post_time\":1779776884,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":0,\"like_count\":103,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DYyrPZgv2aJ.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DYmMiV9EUz8\",\"image\":\"https://scontent-iad3-1.cdninstagram.com/v/t51.82787-15/703797066_17888728956513229_5537161594069799101_n.jpg?stp=dst-jpg_e35_p720x720_tt6&_nc_cat=108&ig_cache_key=MzkwMTg1ODMyNjM2MzA3ODA0Mg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMzI3NC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=vEe3XTe4IlQQ7kNvwF4e16k&_nc_oc=AdrB8z10qKFUCG5dunP83F50tIH9TPepKsD4u0biT9O0fq-2MQe4Ii_BI5OuTGMvfSc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af-mfkP8-OsmcdTls8p1No2WOrNqk8pba491Wa6YEqGYig&oe=6A2C98C5\",\"caption\":\"Suasana meriah dan penuh antusiasme mewarnai kegiatan Penutupan TMMD Reguler Ke-128 Kodim 0507/Bekasi di wilayah Jatirangga, Kecamatan Jatisampurna, Kota Bekasi. Kehadiran Gubernur Jawa Barat, Kang Dedi Mulyadi, menjadi magnet tersendiri yang mampu mengundang perhatian dan kebahagiaan warga Jatirangga maupun Jatiraden.\\n\\nSejak pagi hari, masyarakat telah memadati lokasi kegiatan untuk menyaksikan secara langsung sosok pemimpin Jawa Barat yang dikenal dekat dengan rakyat tersebut. Sorak sorai dan tepuk tangan warga pecah saat Kang Dedi Mulyadi tiba di lokasi acara penutupan TMMD yang telah berlangsung selama satu bulan dengan berbagai sasaran fisik maupun nonfisik bagi masyarakat.\\n\\nWarga tampak antusias mengabadikan momen kedatangan Gubernur Jawa Barat, bahkan banyak yang rela berdesakan demi dapat berjabat tangan dan berfoto bersama. Kehangatan interaksi antara Kang Dedi Mulyadi dan masyarakat semakin menambah semarak suasana kegiatan.\\n\\nSalah seorang warga Jatirangga mengaku sangat bahagia dapat bertemu langsung dengan orang nomor satu di Jawa Barat tersebut.\\n\\n“Saya senang sekali bisa melihat langsung dan bertatap muka dengan Kang Dedi Mulyadi. Selama ini hanya melihat dari televisi dan media sosial, sekarang bisa bertemu langsung di kampung kami. Ini menjadi pengalaman yang sangat membahagiakan bagi kami warga Jatirangga,” ungkapnya dengan penuh antusias.\\n\\n#kangdedimulyadi #kdm #tni #kotabekasikeren\",\"post_time\":1779358130,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":3,\"like_count\":286,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DYmMiV9EUz8.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1780918848117,\"id\":\"DYl7PuNPwnx\",\"image\":\"https://scontent-iad3-1.cdninstagram.com/v/t51.71878-15/702637394_1001306249160215_3336361282164797805_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=108&ig_cache_key=MzkwMTc4NTIxNzMzNzA2ODAxNw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=VToMqt6n3LIQ7kNvwHtQPkF&_nc_oc=Ado0rTWguaPoicu_aRbk31xHzc9nNspa-sIy_4BtyF-xUJTpklHv9zCr7NQP8nOdX6U&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=ov5-dJcDYm9wPpjTFNHUfg&_nc_ss=7a22e&oh=00_Af-uhg-wWJ-OIJMWNgxbQs5NH0gaEHyZU7_dzXNGku6Kig&oe=6A2C816E\",\"caption\":\"Upacara Penutupan TMMD Ke-128 Kodim 0507/Bekasi di wilayah Kel.Jatirangga Kecamatan Jatisampurna Kota Bekasi ,Kamis 21 Mei 2026 .\\n\\n@dedimulyadi71\\n@mastriadhianto \\n@harris.bobihoe \\n@kodim0507bekasi2 \\n@pemkot_bekasi \\n@nata.wirya\",\"post_time\":1779349147,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":9,\"like_count\":199,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DYl7PuNPwnx.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1788938039198,\"id\":\"DdBudBRv_IC\",\"image\":\"https://scontent-lhr6-1.cdninstagram.com/v/t51.71878-15/800780257_930571343455922_3973232254869900978_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=103&ig_cache_key=Mzk4MTY2Nzg0OTk0ODA5OTA3NA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=XwUvTvIOLbQQ7kNvwH-uT76&_nc_oc=AdqJUjVakjiuOkr5FU6o63dj5mf7cQJEi1hiAtOpNRT_I6bEQsKWGWudy8UhkGwNio4&_nc_zt=23&_nc_ht=scontent-lhr6-1.cdninstagram.com&_nc_gid=EyRUTKzJGpgq_eiHJcspWA&_nc_ss=7e6a8&oh=00_AQKv9VMR63hDMmnqep3BC60QM5tuutIR9yDVGbTbsOqs8g&oe=6AA6EEC7\",\"caption\":\"08 September 2026\\nPembagian Masker untuk Warga Kecamatan Jatisampurna \\n\\nCamat Jatisampurna bersama rekan Damkar Kota Bekasi,BPBD Kota Bekasi membagikan masker untuk warga kecamatan Jatisampurna di jalan raya Kranggan depan Kecamatan Jatisampurna untuk mengantisipasi dampak dari abu Vulkanik letusan Krakatau yang sampai ke daerah Jabodetabek.\\n@mastriadhianto \\n@harris.bobihoe \\n@nata.wirya \\n@akamsih74 \\n@pemkot_bekasi \\n@diskominfobekasi\",\"post_time\":1788871946,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":8,\"like_count\":86,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/DdBudBRv_IC.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1788938039198,\"id\":\"Dc-CelWv1VD\",\"image\":\"https://scontent-lhr6-1.cdninstagram.com/v/t51.71878-15/799200918_898032383134191_8747075398464094969_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=102&ig_cache_key=Mzk4MDYzMDAxODQyOTUwNjg4Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=rSIIAkBN0R4Q7kNvwFdDbxP&_nc_oc=AdrEhhBmG4Wd7PauHE2w0EmvcTHLwkVPon7wxjCJP4cfSFlqy8jsVYaCH7VVTv9qr3k&_nc_zt=23&_nc_ht=scontent-lhr6-1.cdninstagram.com&_nc_gid=EyRUTKzJGpgq_eiHJcspWA&_nc_ss=7e6a8&oh=00_AQKA1XsHjRC7lOC83s8HILsxMaLyzP7DQ9UbX26N8RnxNA&oe=6AA6C2B2\",\"caption\":\"Dengan bangga kami sampaikan, *KOTA BEKASI* terpilih sebagai Tuan Rumah *PORPROV XV JAWA BARAT 2026* 🏆\\r\\n\\r\\nMari kita sukseskan bersama perhelatan olahraga terbesar se-Jawa Barat. \\r\\nJadikan ajang ini sebagai momentum untuk menunjukkan semangat sportivitas, persatuan, dan kebanggaan sebagai warga Bekasi.\\r\\n\\r\\n*BEKASI SIAP JADI TUAN RUMAH YANG BAIK!*\\r\\n*BEKASI JUARA!*\\n\\n@mastriadhianto\\r\\n@harris.bobihoe\\n\\n@nata.wirya\\r\\n@disporabekasi\\n\\n#PorprovXVJabar2026 #BekasiTuanRumah #BekasiJuara #OlahragaJabar #PemkotBekasi\",\"post_time\":1788748395,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":4,\"like_count\":63,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/Dc-CelWv1VD.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1788938039198,\"id\":\"Dc9_uh3vY-Z\",\"image\":\"https://scontent-lhr11-1.cdninstagram.com/v/t51.71878-15/799346354_1113768514549164_731983967081465814_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk4MDYxNzkyMDA2MDE2NjA0MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=BT1rTM9znaoQ7kNvwHnN6je&_nc_oc=AdojVsjv2bDLrXu1JuqU468vWv72gOL4SQiwiQJGSrvSv_Nd4j3a-INg1CjuK5lsmkU&_nc_zt=23&_nc_ht=scontent-lhr11-1.cdninstagram.com&_nc_gid=EyRUTKzJGpgq_eiHJcspWA&_nc_ss=7e6a8&oh=00_AQLFpq1n_D-4ovSLW0HCfc10KryAvqeSIv8ituPg_B2ZZQ&oe=6AA6DF82\",\"caption\":\"Kegiatan Bakti Sosial dan Renovasi Rumah Lansia\\r\\n*\\\"GERAKAN BERSIH MASJID DAN MUSHOLLA JATISAMPURNA\\\"*\\r\\n\\r\\nDengan ini kami sampaikan bahwa telah dilaksanakan kegiatan peninjauan dan renovasi rumah milik Bapak Mang Bodong, warga lansia yang tinggal di wilayah Kecamatan Jatisampurna.\\r\\n\\r\\nKondisi sebelumnya: Rumah tidak layak huni, mengalami keterbatasan listrik dan air.\\r\\n\\r\\nTindak lanjut: \\r\\nPemerintah Kecamatan Jatisampurna bersama Lurah, Babinsa, Bhabinkamtibmas, Satlinmas Jatiraden, dan Gerakan Bersih Masjid dan Musholla telah melakukan:\\r\\n1.  Peninjauan langsung ke lokasi\\r\\n2.  Pembongkaran gubuk lama\\r\\n3.  Renovasi dan perbaikan rumah menjadi layak huni, sehat, aman dan nyaman\\r\\n\\r\\nKegiatan ini merupakan bentuk kepedulian pemerintah dan masyarakat terhadap warga yang membutuhkan.\\r\\n\\r\\nMari bersama kita terus wujudkan kepedulian sosial dan gotong royong di lingkungan kita.\\r\\n\\r\\n*Tetap Waspada, Jaga Diri, Jaga Keluarga, Jaga Jatisampurna*\\n\\n@mastriadhianto\\r\\n@harris.bobihoe\\n@nata.wirya\\r\\n@babinsa_muda\\n\\nTake vidio by :@babinsa_muda\\n\\n#PemerintahKotaBekasi #KecamatanJatisampurna #BaktiSosial #GerakanBersihMasjidDanMusholla #gotongroyong\",\"post_time\":1788746869,\"owner\":\"58589690880\",\"username\":\"kecjatisampurna\",\"comment_count\":0,\"like_count\":93,\"cdn_image\":\"//cdn.jsdelivr.net/gh/pemkotbekasi/photo_gallery/picture/58589690880/Dc9_uh3vY-Z.jpg\"},{\"current_url\":\"https://www.instagram.com/kecjatisampurna/?_showcaption=true\",\"snapshot_date\":1788938039198,\"id\":\"Dc9-ZMgzWk_\",\"image\":\"https://scontent-lhr6-1.cdninstagram.com/v/t51.82787-15/799155942_18014839037954881_601281087346631928_n.webp?_nc_cat=103&ig_cache_key=Mzk4MDYxMjA1NTk3MTIyNzk2Nw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=4Gg9PXzsjnMQ7kNvwFm8Slh&_nc_oc=AdoUNQ9tntFPq3lg1fWLHleF9QtX3W3_3FgwWAMDfWREqnQCmIi9pNGSdlIXCrvnqK0&_nc_zt=23&_nc_ht=scontent-lhr6-1.cdninstagram.com&_nc_gid=EyRUTKzJGpgq_eiHJcspWA&_nc_ss=7e6a8&oh=00_AQJunS